      given AutomationRepository.authorizeChat(automationId, spaceId) returns Unit
      given AutomationConversationGateway.removeOwnReaction(removeAutomationReaction) returns Unit
      when result = AutomationChatApi.removeOwnReaction(removeAutomationReaction)
      expect Success
    }
    surface MessageApi exposes requestReply {
      operation publish(request: PublishMessage)
        -> MessageView
        ! MessageAccessDenied ! EmptyMessage ! InvalidAttachment ! DuplicateClientMessageConflict ! MessagingPersistenceUnavailable
      effects { read MessagePublication read ChatMessage write ChatMessage write MessagePublication write MessageAttachment read Reaction call MessageRepository.publish }

      operation edit(request: EditMessage)
        -> MessageView
        ! MessageNotFound ! MessageAccessDenied ! MessageMutationDenied ! EmptyMessage ! MessagingPersistenceUnavailable
      effects { read ChatMessage write ChatMessage read Reaction read MessagePublication call MessageRepository.edit emit MessageEdited(messageId: request.messageId, actorId: request.actorId) }

      operation delete(request: DeleteMessage)
        -> Unit
        ! MessageNotFound ! MessageAccessDenied ! MessageMutationDenied ! MessagingPersistenceUnavailable
      effects { write ChatMessage write MessageAttachment write Reaction call MessageRepository.delete emit MessageDeleted(messageId: request.messageId, actorId: request.actorId) }

      operation addReaction(request: AddReaction)
        -> Reaction
        ! MessageNotFound ! MessageAccessDenied ! MessagingPersistenceUnavailable
      effects { read ChatMessage write Reaction call MessageRepository.addReaction as reaction emit ReactionAdded(reactionId: reaction.id, messageId: reaction.messageId, actorId: request.actorId) }

      operation removeReaction(request: RemoveReaction)
        -> Unit
        ! ReactionNotFound ! MessageAccessDenied ! MessageMutationDenied ! MessagingPersistenceUnavailable
      effects { read ChatMessage write Reaction call MessageRepository.removeReaction as reaction emit ReactionRemoved(reactionId: reaction.id, messageId: reaction.messageId, actorId: request.actorId) }

      operation page(request: ReadMessages)
        -> MessagePage
        ! MessageAccessDenied ! MessageNotFound ! MessagingPersistenceUnavailable
      effects { read ChatMessage read Reaction call MessageRepository.page }

      operation show(actorId: AuthorId, messageId: MessageId)
        -> MessageView
        ! MessageNotFound ! MessageAccessDenied ! MessagingPersistenceUnavailable
      effects { read ChatMessage read Reaction call MessageRepository.show }
    }

    constraint "Every message belongs to exactly one space and one active author authorized through current membership and agent participation or a valid limited channel delegation when publication is accepted."
    constraint "A publication contains non-blank text, one valid attachment, or both; an attachment-only message exposes its safe filename as accessible fallback text."
    constraint "Rich text is sanitized before persistence and rendering; executable markup, unsafe schemes, and forged embedded application resources are rejected."
    constraint "An attachment has a bounded size, verified media type, safe filename, and immutable blob identity; derived thumbnails and previews never replace the original."
    constraint "For equal author, space, and clientMessageKey, an identical retry returns the original message and emits no second event; different content fails with DuplicateClientMessageConflict."
    constraint "Message publication atomically persists ChatMessage, immutable MessagePublication and the durable MessagePublished outbox event. The publication request hash describes the original canonical request and survives later edits and tombstones. An identical retry preserves the publication, creation time and event identity; failure rolls back every first-publication write."
    constraint "Realtime, mentions and human-message agent triggers consume durable publication once per consumer using persistent receipt/cursor state. A successful request retry is not a new delivery; restart repairs pending deliveries, and progress never enters this conversation-publication path."
    constraint "Messages are ordered deterministically by creation time and identifier; edit time never changes conversation order."
    constraint "Only the author or an active administrator may edit or delete a human-authored message; an agent or automation principal may mutate only its own messages."
    constraint "Messaging distinguishes Conversation, RunProgress and RunSummary independently of attachment payload kinds. Ordinary publication always creates Conversation; text never reserves work, changes readiness, or completes a channel."
    constraint "One RunProgress message per attempt is projected only from durable accepted activities using an owner-defined projection port. Revision increases monotonically, creation time and chat position stay unchanged. Older activity is paginated through runs, not silently truncated."
    constraint "Ordinary edit cannot mutate structured progress or an immutable published summary. Administrative deletion leaves a persistent tombstone; later projections or publication retries cannot restore content."
    constraint "Progress projection is persisted before realtime delivery. It never triggers agents, mention notifications or an unread increase per update. Prompt context excludes progress unless explicitly requested as work activity."
    constraint "Summary publication is idempotent by summary identity and produces one permanent message and one durable event. Further turns cannot overwrite an earlier summary."
    constraint "Agent publication derives author and channel from participation or a current ChannelWorkSession delegation; a client-supplied principal or message ID proves neither authority nor authorship."
    constraint "Deletion makes content unavailable to ordinary reads, removes its reactions, updates search projections, and emits one removal event while retaining only audit-minimal metadata."
    constraint "A mention resolves only to an active current member of the message's space; text that names an outsider grants no access and creates no mention notification."
    constraint "A person may attach multiple distinct reaction marks to a message but at most one identical mark per person and message."
    constraint "Only the reaction author may remove that reaction; deleting a message removes all reactions regardless of author."
    constraint "Every page and single-message read rechecks current space membership; possession of a message or cursor identifier never grants access."
    constraint "before, after, and around are mutually exclusive cursor modes; a referenced cursor must belong to the requested space."
    constraint "Page results contain at most the requested bounded limit, default to the newest page, and are returned in chronological display order."

    example "publish a text message" {
      given MessageRepository.publish(publishMessage) returns MessageView { id = messageId spaceId = spaceId authorId = authorId clientMessageKey = "client-1" body = "Hello" attachmentName = None kind = Conversation runId = None attemptId = None humanPrincipalId = None delegationSessionId = None progressRevision = 0 payloadKind = Text createdAt = occurredAt updatedAt = occurredAt reactions = noReactions }
      when result = MessageApi.publish(publishMessage)
      expect Success
    }
    example "an identical publication retry preserves its durable identity" {
      when retry = MessageRepository.publish(PublishMessage { id = "00000000-0000-4000-8000-000000000001" spaceId = "00000000-0000-4000-8000-000000000002" authorId = "00000000-0000-4000-8000-000000000003" clientMessageKey = "native-publication" body = Some("Hello") attachmentName = None attachment = None occurredAt = "2026-10-04T11:00:00.000Z" })
      expect retry == MessageView { id = "00000000-0000-4000-8000-000000000001" spaceId = "00000000-0000-4000-8000-000000000002" authorId = "00000000-0000-4000-8000-000000000003" clientMessageKey = "native-publication" body = "Hello" attachmentName = None kind = Conversation runId = None attemptId = None humanPrincipalId = None delegationSessionId = None progressRevision = 0 payloadKind = Text createdAt = "2026-10-04T11:00:00.000Z" updatedAt = "2026-10-04T11:00:00.000Z" reactions = [] }
    }
    example "reject conflicting publication retry" {
      given MessageRepository.publish(conflictingPublish) fails DuplicateClientMessageConflict { clientMessageKey = clientMessageKey }
      when result = MessageApi.publish(conflictingPublish)
      expect result fails DuplicateClientMessageConflict
    }
    example "real message shows a persisted message and its reactions" {
      when result = MessageRepository.show("00000000-0000-4000-8000-000000000063", "00000000-0000-4000-8000-000000000061")
      expect result == MessageView { id = "00000000-0000-4000-8000-000000000061" spaceId = "00000000-0000-4000-8000-000000000062" authorId = "00000000-0000-4000-8000-000000000063" clientMessageKey = "native-read-61" body = "First message" attachmentName = None kind = Conversation runId = None attemptId = None humanPrincipalId = None delegationSessionId = None progressRevision = 0 payloadKind = Text createdAt = "2026-10-04T12:00:00.000Z" updatedAt = "2026-10-04T12:00:00.000Z" reactions = [Reaction { id = "00000000-0000-4000-8000-000000000065" messageId = "00000000-0000-4000-8000-000000000061" authorId = "00000000-0000-4000-8000-000000000063" mark = "👍" createdAt = "2026-10-05T12:00:00.000Z" }]  }
    }
    example "real message rejects an absent message read" {
      when result = MessageRepository.show("00000000-0000-4000-8000-000000000063", "00000000-0000-4000-8000-000000000069")
      expect result fails MessageNotFound
    }
    example "real message rejects a deleted message read" {
      when result = MessageRepository.show("00000000-0000-4000-8000-000000000063", "00000000-0000-4000-8000-000000000061")
      expect result fails MessageNotFound
    }
