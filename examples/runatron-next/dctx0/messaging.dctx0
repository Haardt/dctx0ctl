domain Messaging {
  value MessageId = UUID
  value MessagingSpaceId = UUID
  value AuthorId = UUID
  value ClientMessageKey = String { length 1..160 }
  value MessagePublicationHash = String { length 64..64 }
  value ReactionId = UUID
  value ReactionMark = String { length 1..16 }
  value PageSize = Int { range 1..100 }

  type MessageState = Published | Deleted
  type MessageKind = Conversation | RunProgress | RunSummary
  type MessagePayloadKind = Text | Image | Video | Audio | File
  type MessageAttachmentState = Available | Hidden

  failure MessageNotFound { messageId: MessageId }
  failure MessageAccessDenied { messageId: MessageId; actorId: AuthorId }
  failure MessageMutationDenied { messageId: MessageId; actorId: AuthorId }
  failure EmptyMessage { reason: String }
  failure InvalidAttachment { reason: String }
  failure DuplicateClientMessageConflict { clientMessageKey: ClientMessageKey }
  failure ReactionNotFound { reactionId: ReactionId }
  failure MessagingPersistenceUnavailable { reason: String }

  entity ChatMessage {
    id: MessageId
    spaceId: MessagingSpaceId
    authorId: AuthorId
    clientMessageKey: ClientMessageKey
    body: Option<String>
    attachmentName: Option<String>
    kind: MessageKind
    runId: Option<AgentRunId>
    attemptId: Option<RunAttemptId>
    humanPrincipalId: Option<PersonId>
    delegationSessionId: Option<UUID>
    progressRevision: Int
    payloadKind: MessagePayloadKind
    state: MessageState
    createdAt: Timestamp
    updatedAt: Timestamp
    key id
  }

  entity MessagePublication {
    spaceId: MessagingSpaceId
    authorId: AuthorId
    clientMessageKey: ClientMessageKey
    messageId: MessageId
    requestHash: MessagePublicationHash
    occurredAt: Timestamp
    key spaceId authorId clientMessageKey
  }

  entity MessageAttachment {
    messageId: MessageId
    filename: String
    content: Bytes
    state: MessageAttachmentState
    key messageId
  }

  entity Reaction {
    id: ReactionId
    messageId: MessageId
    authorId: AuthorId
    mark: ReactionMark
    createdAt: Timestamp
    key id
  }

  message PublishMessage {
    id: MessageId
    spaceId: MessagingSpaceId
    authorId: AuthorId
    clientMessageKey: ClientMessageKey
    body: Option<String>
    attachmentName: Option<String>
    attachment: Option<Bytes>
    occurredAt: Timestamp
  }

  message ProjectRunProgress {
    id: MessageId
    spaceId: MessagingSpaceId
    authorId: AuthorId
    runId: AgentRunId
    attemptId: RunAttemptId
    humanPrincipalId: Option<PersonId>
    delegationSessionId: Option<UUID>
    revision: Int
    status: AgentRunStatus
    activities: List<RunEvent>
    createdAt: Timestamp
    acceptedAt: Timestamp
  }
  message PublishRunSummary {
    id: MessageId
    summary: SavedRunSummary
    spaceId: MessagingSpaceId
    authorId: AuthorId
    humanPrincipalId: Option<PersonId>
    delegationSessionId: Option<UUID>
    occurredAt: Timestamp
  }
  message EditMessage {
    actorId: AuthorId
    messageId: MessageId
    body: Option<String>
    occurredAt: Timestamp
  }
  message DeleteMessage {
    actorId: AuthorId
    messageId: MessageId
    occurredAt: Timestamp
  }
  message AddReaction {
    id: ReactionId
    actorId: AuthorId
    messageId: MessageId
    mark: ReactionMark
    occurredAt: Timestamp
  }
  message RemoveReaction {
    actorId: AuthorId
    reactionId: ReactionId
    occurredAt: Timestamp
  }
  message MessageCursor {
    before: Option<MessageId>
    after: Option<MessageId>
    around: Option<MessageId>
    limit: PageSize
  }
  message ReadMessages {
    actorId: AuthorId
    spaceId: MessagingSpaceId
    cursor: MessageCursor
  }
  message MessageView {
    id: MessageId
    spaceId: MessagingSpaceId
    authorId: AuthorId
    clientMessageKey: ClientMessageKey
    body: String
    attachmentName: Option<String>
    kind: MessageKind
    runId: Option<AgentRunId>
    attemptId: Option<RunAttemptId>
    humanPrincipalId: Option<PersonId>
    delegationSessionId: Option<UUID>
    progressRevision: Int
    payloadKind: MessagePayloadKind
    createdAt: Timestamp
    updatedAt: Timestamp
    reactions: List<Reaction>
  }
  message MessagePage {
    items: List<MessageView>
    olderCursor: Option<MessageId>
    newerCursor: Option<MessageId>
  }

  event MessagePublished { messageId: MessageId; spaceId: MessagingSpaceId; authorId: AuthorId }
  event MessageEdited { messageId: MessageId; actorId: AuthorId }
  event MessageDeleted { messageId: MessageId; actorId: AuthorId }
  event ReactionAdded { reactionId: ReactionId; messageId: MessageId; actorId: AuthorId }
  event ReactionRemoved { reactionId: ReactionId; messageId: MessageId; actorId: AuthorId }

  module ConversationHistory {
    intent """
      Maintain ordered, attributable, idempotently published conversation
      history with safe attachments, room-valid mentions, small reactions, and
      access-checked cursor navigation.
      """

    decision DurableHistoryAndRealtimeProjection {
      choose "Persist a message before emitting its realtime event and derive live updates from durable history."
      because "Reconnects, pagination, search, notifications, and integrations then agree on one message identity and order."
      avoid "Do not let websocket delivery become the source of truth or acknowledge an unpersisted message."
    }
    decision IdempotentClientPublication {
      choose "Identify publication retries by author, space, and client message key."
      because "Mobile and realtime clients may retry after losing an acknowledgement."
      avoid "Do not create duplicates for an identical retry or silently accept different content under the same key."
    }

    owns {
      value MessageId value MessagingSpaceId value AuthorId value ClientMessageKey value MessagePublicationHash value ReactionId value ReactionMark value PageSize
      entity ChatMessage entity MessagePublication entity MessageAttachment entity Reaction
      event MessagePublished event MessageEdited event MessageDeleted event ReactionAdded event ReactionRemoved
    }

    requires { MessageRepository Automation.BotsAndExternalContent.AutomationRepository AutomationConversationGateway }

    port MessageRepository {
      operation publish(request: PublishMessage)
        -> MessageView
        ! MessageAccessDenied ! EmptyMessage ! InvalidAttachment ! DuplicateClientMessageConflict ! MessagingPersistenceUnavailable {
        state upserts MessagePublication from MessagePublication {
          spaceId = request.spaceId authorId = request.authorId clientMessageKey = request.clientMessageKey messageId = result.id
          requestHash = after.MessagePublication(request.spaceId, request.authorId, request.clientMessageKey).requestHash occurredAt = result.createdAt
        }
        state upserts ChatMessage from ChatMessage { id = result.id spaceId = result.spaceId authorId = result.authorId clientMessageKey = result.clientMessageKey
          body = Some(result.body) attachmentName = result.attachmentName kind = result.kind runId = result.runId attemptId = result.attemptId
          humanPrincipalId = result.humanPrincipalId delegationSessionId = result.delegationSessionId progressRevision = result.progressRevision
          payloadKind = result.payloadKind state = Published createdAt = result.createdAt updatedAt = result.updatedAt }
        state lists Reaction
        state lists MessageAttachment
        ensures not success implies before.MessageAttachment == after.MessageAttachment
        ensures success and request.attachment == None() implies before.MessageAttachment == after.MessageAttachment
        ensures success and request.attachment != None() implies request.attachment == Some(after.MessageAttachment(result.id).content) and request.attachmentName == Some(after.MessageAttachment(result.id).filename) and after.MessageAttachment(result.id).state == MessageAttachmentState.Available
        ensures success implies result.spaceId == request.spaceId and result.authorId == request.authorId and result.clientMessageKey == request.clientMessageKey
        ensures success implies result.kind == Conversation and result.runId == None() and result.attemptId == None() and result.humanPrincipalId == None() and result.delegationSessionId == None() and result.progressRevision == 0
        ensures success implies result.attachmentName == request.attachmentName and length(result.body) > 0
        ensures success implies length(after.MessagePublication(request.spaceId, request.authorId, request.clientMessageKey).requestHash) == 64
        ensures success and count(publication in before.MessagePublication where publication.spaceId == request.spaceId and publication.authorId == request.authorId and publication.clientMessageKey == request.clientMessageKey) == 0 implies result.id == request.id and result.createdAt == request.occurredAt and result.updatedAt == request.occurredAt
        ensures success and count(publication in before.MessagePublication where publication.spaceId == request.spaceId and publication.authorId == request.authorId and publication.clientMessageKey == request.clientMessageKey) > 0 implies before.MessagePublication == after.MessagePublication and before.ChatMessage == after.ChatMessage
        ensures success and request.attachment == None() implies result.payloadKind == Text
        ensures success implies result == MessageView { id = after.ChatMessage(result.id).id spaceId = after.ChatMessage(result.id).spaceId authorId = after.ChatMessage(result.id).authorId clientMessageKey = after.ChatMessage(result.id).clientMessageKey attachmentName = after.ChatMessage(result.id).attachmentName kind = after.ChatMessage(result.id).kind runId = after.ChatMessage(result.id).runId attemptId = after.ChatMessage(result.id).attemptId humanPrincipalId = after.ChatMessage(result.id).humanPrincipalId delegationSessionId = after.ChatMessage(result.id).delegationSessionId progressRevision = after.ChatMessage(result.id).progressRevision payloadKind = after.ChatMessage(result.id).payloadKind createdAt = after.ChatMessage(result.id).createdAt updatedAt = after.ChatMessage(result.id).updatedAt body = result.body reactions = result.reactions }
        ensures success implies length(result.reactions) == count(reaction in before.Reaction where reaction.messageId == result.id)
        ensures success implies all(reaction in result.reactions where reaction == before.Reaction(reaction.id) and reaction.messageId == result.id and count(other in result.reactions where other.id == reaction.id) == 1)
        ensures not success implies before.MessagePublication == after.MessagePublication and before.ChatMessage == after.ChatMessage and before.Reaction == after.Reaction
        effects { read MessagePublication read ChatMessage write ChatMessage write MessagePublication write MessageAttachment read Reaction }
      }
      operation edit(request: EditMessage) -> MessageView
        ! MessageNotFound ! MessageAccessDenied ! MessageMutationDenied ! EmptyMessage ! MessagingPersistenceUnavailable {
        state replaces ChatMessage by request.messageId from ChatMessage {
          id = self.id
          spaceId = self.spaceId
          authorId = self.authorId
          clientMessageKey = self.clientMessageKey
          attachmentName = self.attachmentName
          kind = self.kind
          runId = self.runId
          attemptId = self.attemptId
          humanPrincipalId = self.humanPrincipalId
          delegationSessionId = self.delegationSessionId
          progressRevision = self.progressRevision
          payloadKind = self.payloadKind
          createdAt = self.createdAt
          updatedAt = request.occurredAt
          body = Some(result.body) state = self.state
        }
        state lists Reaction
        state lists MessagePublication
        ensures success implies before.ChatMessage(request.messageId).state == Published and before.ChatMessage(request.messageId).kind == Conversation
        ensures success implies length(result.body) > 0
        ensures success implies result == MessageView {
          id = after.ChatMessage(request.messageId).id
          spaceId = after.ChatMessage(request.messageId).spaceId
          authorId = after.ChatMessage(request.messageId).authorId
          clientMessageKey = after.ChatMessage(request.messageId).clientMessageKey
          attachmentName = after.ChatMessage(request.messageId).attachmentName
          kind = after.ChatMessage(request.messageId).kind
          runId = after.ChatMessage(request.messageId).runId
          attemptId = after.ChatMessage(request.messageId).attemptId
          humanPrincipalId = after.ChatMessage(request.messageId).humanPrincipalId
          delegationSessionId = after.ChatMessage(request.messageId).delegationSessionId
          progressRevision = after.ChatMessage(request.messageId).progressRevision
          payloadKind = after.ChatMessage(request.messageId).payloadKind
          createdAt = after.ChatMessage(request.messageId).createdAt
          updatedAt = after.ChatMessage(request.messageId).updatedAt
          body = result.body reactions = result.reactions
        }
        ensures success implies length(result.reactions) == count(reaction in before.Reaction where reaction.messageId == request.messageId)
        ensures success implies all(reaction in result.reactions where reaction == before.Reaction(reaction.id) and reaction.messageId == request.messageId and count(other in result.reactions where other.id == reaction.id) == 1)
        ensures not success implies before.ChatMessage == after.ChatMessage and before.Reaction == after.Reaction and before.MessagePublication == after.MessagePublication
        effects { read ChatMessage write ChatMessage read Reaction read MessagePublication }
      }
      operation delete(request: DeleteMessage)
        -> Unit
        ! MessageNotFound ! MessageAccessDenied ! MessageMutationDenied ! MessagingPersistenceUnavailable {
        state replaces ChatMessage by request.messageId from ChatMessage {
          id = self.id
          spaceId = self.spaceId
          authorId = self.authorId
          clientMessageKey = self.clientMessageKey
          body = None()
          attachmentName = None()
          kind = self.kind
          runId = self.runId
          attemptId = self.attemptId
          humanPrincipalId = self.humanPrincipalId
          delegationSessionId = self.delegationSessionId
          progressRevision = self.progressRevision
          payloadKind = self.payloadKind
          state = Deleted
          createdAt = self.createdAt
          updatedAt = self.updatedAt
        }
        state removes Reaction where self.messageId == request.messageId
        state replaces MessageAttachment where self.messageId == request.messageId from MessageAttachment { messageId = self.messageId filename = self.filename content = self.content state = MessageAttachmentState.Hidden }
        ensures success implies count(after.MessageAttachment) == count(before.MessageAttachment)
        ensures success implies all(attachment in after.MessageAttachment where attachment.messageId != request.messageId and attachment == before.MessageAttachment(attachment.messageId) or attachment.messageId == request.messageId and attachment == MessageAttachment { messageId = before.MessageAttachment(attachment.messageId).messageId filename = before.MessageAttachment(attachment.messageId).filename content = before.MessageAttachment(attachment.messageId).content state = MessageAttachmentState.Hidden })
        ensures not success implies before.MessageAttachment == after.MessageAttachment
        ensures not success implies before.ChatMessage == after.ChatMessage and before.Reaction == after.Reaction
        effects { write ChatMessage write MessageAttachment write Reaction }
      }
      operation addReaction(request: AddReaction)
        -> Reaction
        ! MessageNotFound ! MessageAccessDenied ! MessagingPersistenceUnavailable {
        state observes ChatMessage by request.messageId
        state upserts Reaction from result
        ensures success implies result.messageId == request.messageId and result.authorId == request.actorId and result.mark == request.mark
        ensures success and count(reaction in before.Reaction where reaction.messageId == request.messageId and reaction.authorId == request.actorId and reaction.mark == request.mark) > 0 implies before.Reaction == after.Reaction
        ensures success and count(reaction in before.Reaction where reaction.messageId == request.messageId and reaction.authorId == request.actorId and reaction.mark == request.mark) == 0 implies result == Reaction { id = request.id messageId = request.messageId authorId = request.actorId mark = request.mark createdAt = request.occurredAt }
        ensures not success implies before.ChatMessage == after.ChatMessage and before.Reaction == after.Reaction
        effects { read ChatMessage write Reaction }
      }
      operation removeReaction(request: RemoveReaction)
        -> Reaction
        ! ReactionNotFound ! MessageAccessDenied ! MessageMutationDenied ! MessagingPersistenceUnavailable {
        state removes Reaction by request.reactionId
        ensures success implies result == before.Reaction(request.reactionId)
        ensures not success implies before.Reaction == after.Reaction
        effects { read ChatMessage write Reaction }
      }
      operation page(request: ReadMessages)
        -> MessagePage
        ! MessageAccessDenied ! MessageNotFound ! MessagingPersistenceUnavailable {
        state lists ChatMessage
        state lists Reaction
        ensures before.ChatMessage == after.ChatMessage and before.Reaction == after.Reaction
        ensures success implies length(result.items) <= request.cursor.limit
        ensures success implies all(message in result.items where before.ChatMessage(message.id).spaceId == request.spaceId and before.ChatMessage(message.id).state == Published and before.ChatMessage(message.id).body == Some(message.body))
        ensures success implies all(message in result.items where message == MessageView { id = before.ChatMessage(message.id).id spaceId = before.ChatMessage(message.id).spaceId authorId = before.ChatMessage(message.id).authorId clientMessageKey = before.ChatMessage(message.id).clientMessageKey attachmentName = before.ChatMessage(message.id).attachmentName kind = before.ChatMessage(message.id).kind runId = before.ChatMessage(message.id).runId attemptId = before.ChatMessage(message.id).attemptId humanPrincipalId = before.ChatMessage(message.id).humanPrincipalId delegationSessionId = before.ChatMessage(message.id).delegationSessionId progressRevision = before.ChatMessage(message.id).progressRevision payloadKind = before.ChatMessage(message.id).payloadKind createdAt = before.ChatMessage(message.id).createdAt updatedAt = before.ChatMessage(message.id).updatedAt body = message.body reactions = message.reactions })
        ensures success implies all(message in result.items where length(message.reactions) == count(reaction in before.Reaction where reaction.messageId == message.id) and all(reaction in message.reactions where reaction == before.Reaction(reaction.id) and reaction.messageId == message.id and count(other in message.reactions where other.id == reaction.id) == 1))
        effects { read ChatMessage read Reaction }
      }
      operation show(actorId: AuthorId, messageId: MessageId)
        -> MessageView
        ! MessageNotFound ! MessageAccessDenied ! MessagingPersistenceUnavailable {
        state observes ChatMessage by messageId
        state lists Reaction
        ensures before.ChatMessage == after.ChatMessage and before.Reaction == after.Reaction
        ensures success implies before.ChatMessage(messageId).state == Published and before.ChatMessage(messageId).body == Some(result.body)
        ensures success implies result == MessageView { id = before.ChatMessage(messageId).id spaceId = before.ChatMessage(messageId).spaceId authorId = before.ChatMessage(messageId).authorId clientMessageKey = before.ChatMessage(messageId).clientMessageKey attachmentName = before.ChatMessage(messageId).attachmentName kind = before.ChatMessage(messageId).kind runId = before.ChatMessage(messageId).runId attemptId = before.ChatMessage(messageId).attemptId humanPrincipalId = before.ChatMessage(messageId).humanPrincipalId delegationSessionId = before.ChatMessage(messageId).delegationSessionId progressRevision = before.ChatMessage(messageId).progressRevision payloadKind = before.ChatMessage(messageId).payloadKind createdAt = before.ChatMessage(messageId).createdAt updatedAt = before.ChatMessage(messageId).updatedAt body = result.body reactions = result.reactions }
        ensures success implies length(result.reactions) == count(reaction in before.Reaction where reaction.messageId == messageId)
        ensures success implies all(reaction in result.reactions where reaction == before.Reaction(reaction.id) and reaction.messageId == messageId and count(other in result.reactions where other.id == reaction.id) == 1)
        effects { read ChatMessage read Reaction }
      }
    }


    port RunMessageProjection {
      operation projectProgress(request: ProjectRunProgress)
        -> MessageView
        ! MessageAccessDenied ! MessageMutationDenied ! DuplicateClientMessageConflict ! MessagingPersistenceUnavailable {
        state upserts ChatMessage from ChatMessage { id = result.id spaceId = result.spaceId authorId = result.authorId clientMessageKey = result.clientMessageKey
          body = Some(result.body) attachmentName = result.attachmentName kind = result.kind runId = result.runId attemptId = result.attemptId
          humanPrincipalId = result.humanPrincipalId delegationSessionId = result.delegationSessionId progressRevision = result.progressRevision
          payloadKind = result.payloadKind state = Published createdAt = result.createdAt updatedAt = result.updatedAt }
        state lists Reaction
        ensures success implies result.id == request.id and result.spaceId == request.spaceId and result.authorId == request.authorId
        ensures success implies result.kind == RunProgress and result.runId == Some(request.runId) and result.attemptId == Some(request.attemptId) and result.humanPrincipalId == request.humanPrincipalId and result.delegationSessionId == request.delegationSessionId
        ensures success implies result.createdAt == request.createdAt and result.progressRevision >= request.revision and result.payloadKind == Text and result.attachmentName == None()
        ensures success and count(message in before.ChatMessage where message.id == result.id) == 0 implies result.progressRevision == request.revision and result.updatedAt == request.acceptedAt
        ensures success and count(message in before.ChatMessage where message.id == result.id) > 0 and before.ChatMessage(result.id).progressRevision >= request.revision implies before.ChatMessage == after.ChatMessage
        ensures success and count(message in before.ChatMessage where message.id == result.id) > 0 and before.ChatMessage(result.id).progressRevision < request.revision implies result.progressRevision == request.revision and result.updatedAt == request.acceptedAt
        ensures success implies result == MessageView { id = after.ChatMessage(result.id).id spaceId = after.ChatMessage(result.id).spaceId authorId = after.ChatMessage(result.id).authorId clientMessageKey = after.ChatMessage(result.id).clientMessageKey attachmentName = after.ChatMessage(result.id).attachmentName kind = after.ChatMessage(result.id).kind runId = after.ChatMessage(result.id).runId attemptId = after.ChatMessage(result.id).attemptId humanPrincipalId = after.ChatMessage(result.id).humanPrincipalId delegationSessionId = after.ChatMessage(result.id).delegationSessionId progressRevision = after.ChatMessage(result.id).progressRevision payloadKind = after.ChatMessage(result.id).payloadKind createdAt = after.ChatMessage(result.id).createdAt updatedAt = after.ChatMessage(result.id).updatedAt body = result.body reactions = result.reactions }
        ensures success implies length(result.reactions) == count(reaction in before.Reaction where reaction.messageId == result.id)
        ensures success implies all(reaction in result.reactions where reaction == before.Reaction(reaction.id) and reaction.messageId == result.id and count(other in result.reactions where other.id == reaction.id) == 1)
        ensures not success implies before.ChatMessage == after.ChatMessage and before.Reaction == after.Reaction
        effects { write ChatMessage read Reaction }
      }
      operation publishSummary(request: PublishRunSummary)
        -> MessageView
        ! MessageAccessDenied ! MessageMutationDenied ! DuplicateClientMessageConflict ! MessagingPersistenceUnavailable {
        state upserts ChatMessage from ChatMessage { id = result.id spaceId = result.spaceId authorId = result.authorId clientMessageKey = result.clientMessageKey
          body = Some(result.body) attachmentName = result.attachmentName kind = result.kind runId = result.runId attemptId = result.attemptId
          humanPrincipalId = result.humanPrincipalId delegationSessionId = result.delegationSessionId progressRevision = result.progressRevision
          payloadKind = result.payloadKind state = Published createdAt = result.createdAt updatedAt = result.updatedAt }
        state lists Reaction
        ensures success implies result.spaceId == request.spaceId and result.authorId == request.authorId and result.kind == RunSummary
        ensures success implies result.runId == Some(request.summary.runId) and result.attemptId == Some(request.summary.attemptId) and result.humanPrincipalId == request.humanPrincipalId and result.delegationSessionId == request.delegationSessionId
        ensures success implies result.progressRevision == 0 and result.payloadKind == Text and result.attachmentName == None()
        ensures success and count(message in before.ChatMessage where message.id == result.id) == 0 implies result.id == request.id and result.createdAt == request.occurredAt and result.updatedAt == request.occurredAt
        ensures success and count(message in before.ChatMessage where message.id == result.id) > 0 implies before.ChatMessage == after.ChatMessage
        ensures success implies result == MessageView { id = after.ChatMessage(result.id).id spaceId = after.ChatMessage(result.id).spaceId authorId = after.ChatMessage(result.id).authorId clientMessageKey = after.ChatMessage(result.id).clientMessageKey attachmentName = after.ChatMessage(result.id).attachmentName kind = after.ChatMessage(result.id).kind runId = after.ChatMessage(result.id).runId attemptId = after.ChatMessage(result.id).attemptId humanPrincipalId = after.ChatMessage(result.id).humanPrincipalId delegationSessionId = after.ChatMessage(result.id).delegationSessionId progressRevision = after.ChatMessage(result.id).progressRevision payloadKind = after.ChatMessage(result.id).payloadKind createdAt = after.ChatMessage(result.id).createdAt updatedAt = after.ChatMessage(result.id).updatedAt body = result.body reactions = result.reactions }
        ensures success implies length(result.reactions) == count(reaction in before.Reaction where reaction.messageId == result.id)
        ensures success implies all(reaction in result.reactions where reaction == before.Reaction(reaction.id) and reaction.messageId == result.id and count(other in result.reactions where other.id == reaction.id) == 1)
        ensures not success implies before.ChatMessage == after.ChatMessage and before.Reaction == after.Reaction
        effects { write ChatMessage read Reaction }
      }
    }
    port AutomationConversationGateway {
      operation publish(request: AutomationPost)
        -> AutomationMessageId
        ! AutomationKeyRejected ! AutomationAccessDenied ! AutomationContentRejected ! AutomationPublicationConflict ! AutomationPersistenceUnavailable {
        state upserts ChatMessage from ChatMessage { id = result spaceId = request.spaceId authorId = request.automationId clientMessageKey = request.clientMessageKey body = after.ChatMessage(result).body attachmentName = request.attachmentName kind = Conversation runId = None() attemptId = None() humanPrincipalId = None() delegationSessionId = None() progressRevision = 0 payloadKind = after.ChatMessage(result).payloadKind state = Published createdAt = after.ChatMessage(result).createdAt updatedAt = after.ChatMessage(result).updatedAt }
        state upserts MessagePublication from MessagePublication { spaceId = request.spaceId authorId = request.automationId clientMessageKey = request.clientMessageKey messageId = result requestHash = after.MessagePublication(request.spaceId, request.automationId, request.clientMessageKey).requestHash occurredAt = after.ChatMessage(result).createdAt }
        state inserts MessageAttachment
        state lists Reaction
        state lists AutomationAccount
        ensures before.AutomationAccount == after.AutomationAccount
        ensures before.Reaction == after.Reaction
        ensures success implies result == after.MessagePublication(request.spaceId, request.automationId, request.clientMessageKey).messageId
        ensures success implies after.ChatMessage(result).body != None() and length(after.MessagePublication(request.spaceId, request.automationId, request.clientMessageKey).requestHash) == 64
        ensures success and count(publication in before.MessagePublication where publication.spaceId == request.spaceId and publication.authorId == request.automationId and publication.clientMessageKey == request.clientMessageKey) == 0 implies after.ChatMessage(result).createdAt == request.occurredAt and after.ChatMessage(result).updatedAt == request.occurredAt
        ensures success and count(publication in before.MessagePublication where publication.spaceId == request.spaceId and publication.authorId == request.automationId and publication.clientMessageKey == request.clientMessageKey) > 0 implies before.ChatMessage == after.ChatMessage and before.MessagePublication == after.MessagePublication and before.MessageAttachment == after.MessageAttachment
        ensures success and request.attachment == None() implies before.MessageAttachment == after.MessageAttachment
        ensures success and count(publication in before.MessagePublication where publication.spaceId == request.spaceId and publication.authorId == request.automationId and publication.clientMessageKey == request.clientMessageKey) > 0 implies before.MessageAttachment == after.MessageAttachment
        ensures success and request.attachment == None() implies before.MessageAttachment == after.MessageAttachment and after.ChatMessage(result).payloadKind == Text
        ensures success implies all(old in before.MessageAttachment where after.MessageAttachment(old.messageId) == old)
        ensures success and request.attachment != None() and count(publication in before.MessagePublication where publication.spaceId == request.spaceId and publication.authorId == request.automationId and publication.clientMessageKey == request.clientMessageKey) == 0 implies count(after.MessageAttachment) == count(before.MessageAttachment) + 1
        ensures success and request.attachment != None() implies request.attachment == Some(after.MessageAttachment(result).content) and request.attachmentName == Some(after.MessageAttachment(result).filename) and after.MessageAttachment(result).state == MessageAttachmentState.Available
        ensures success implies all(attachment in after.MessageAttachment where attachment.messageId == result or attachment == before.MessageAttachment(attachment.messageId))
        ensures not success implies before.ChatMessage == after.ChatMessage and before.Reaction == after.Reaction and before.MessagePublication == after.MessagePublication and before.MessageAttachment == after.MessageAttachment
        effects { read AutomationAccount read ChatMessage write ChatMessage read MessagePublication write MessagePublication write MessageAttachment read Reaction }
      }
      operation editOwn(request: AutomationEdit)
        -> Unit
        ! AutomationKeyRejected ! AutomationAccessDenied ! AutomationMutationDenied ! AutomationContentRejected ! AutomationPersistenceUnavailable {
        state replaces ChatMessage by request.messageId from ChatMessage { id = self.id spaceId = self.spaceId authorId = self.authorId clientMessageKey = self.clientMessageKey attachmentName = self.attachmentName kind = self.kind runId = self.runId attemptId = self.attemptId humanPrincipalId = self.humanPrincipalId delegationSessionId = self.delegationSessionId progressRevision = self.progressRevision payloadKind = self.payloadKind createdAt = self.createdAt body = after.ChatMessage(request.messageId).body state = self.state updatedAt = request.occurredAt }
        state lists Reaction
        state lists MessagePublication
        state lists MessageAttachment
        state lists AutomationAccount
        ensures before.AutomationAccount == after.AutomationAccount
        ensures success implies before.ChatMessage(request.messageId).spaceId == request.spaceId and before.ChatMessage(request.messageId).state == Published
        ensures success implies before.ChatMessage(request.messageId).authorId == request.automationId and before.ChatMessage(request.messageId).kind == Conversation and after.ChatMessage(request.messageId).body != None()
        ensures before.Reaction == after.Reaction and before.MessagePublication == after.MessagePublication and before.MessageAttachment == after.MessageAttachment
        ensures not success implies before.ChatMessage == after.ChatMessage and before.Reaction == after.Reaction and before.MessagePublication == after.MessagePublication and before.MessageAttachment == after.MessageAttachment
        effects { read AutomationAccount read ChatMessage write ChatMessage read Reaction read MessagePublication read MessageAttachment }
      }
      operation deleteOwn(request: AutomationDelete)
        -> Unit
        ! AutomationKeyRejected ! AutomationAccessDenied ! AutomationMutationDenied ! AutomationPersistenceUnavailable {
        state replaces ChatMessage by request.messageId from ChatMessage { id = self.id spaceId = self.spaceId authorId = self.authorId clientMessageKey = self.clientMessageKey attachmentName = None() kind = self.kind runId = self.runId attemptId = self.attemptId humanPrincipalId = self.humanPrincipalId delegationSessionId = self.delegationSessionId progressRevision = self.progressRevision payloadKind = self.payloadKind createdAt = self.createdAt body = None() state = Deleted updatedAt = self.updatedAt }
        state removes Reaction where self.messageId == request.messageId
        state replaces MessageAttachment where self.messageId == request.messageId from MessageAttachment { messageId = self.messageId filename = self.filename content = self.content state = MessageAttachmentState.Hidden }
        state lists MessagePublication
        state lists AutomationAccount
        ensures before.AutomationAccount == after.AutomationAccount
        ensures success implies before.ChatMessage(request.messageId).spaceId == request.spaceId and before.ChatMessage(request.messageId).state == Published
        ensures success implies before.ChatMessage(request.messageId).authorId == request.automationId
        ensures before.MessagePublication == after.MessagePublication
        ensures success implies count(after.MessageAttachment) == count(before.MessageAttachment)
        ensures success implies all(attachment in after.MessageAttachment where attachment.messageId != request.messageId and attachment == before.MessageAttachment(attachment.messageId) or attachment.messageId == request.messageId and attachment == MessageAttachment { messageId = before.MessageAttachment(attachment.messageId).messageId filename = before.MessageAttachment(attachment.messageId).filename content = before.MessageAttachment(attachment.messageId).content state = MessageAttachmentState.Hidden })
        ensures not success implies before.ChatMessage == after.ChatMessage and before.Reaction == after.Reaction and before.MessagePublication == after.MessagePublication and before.MessageAttachment == after.MessageAttachment
        effects { read AutomationAccount read ChatMessage write ChatMessage write MessageAttachment write Reaction read MessagePublication }
      }
      operation react(request: AutomationReaction)
        -> AutomationReactionId
        ! AutomationKeyRejected ! AutomationAccessDenied ! AutomationMutationDenied ! AutomationContentRejected ! AutomationPersistenceUnavailable {
        state upserts Reaction from Reaction { id = result messageId = request.messageId authorId = request.automationId mark = request.mark createdAt = after.Reaction(result).createdAt }
        state lists ChatMessage
        state lists MessagePublication
        state lists MessageAttachment
        state lists AutomationAccount
        ensures before.AutomationAccount == after.AutomationAccount
        ensures success implies before.ChatMessage(request.messageId).spaceId == request.spaceId and before.ChatMessage(request.messageId).state == Published
        ensures before.ChatMessage == after.ChatMessage and before.MessagePublication == after.MessagePublication and before.MessageAttachment == after.MessageAttachment
        ensures success implies result == after.Reaction(result).id
        ensures success and count(reaction in before.Reaction where reaction.messageId == request.messageId and reaction.authorId == request.automationId and reaction.mark == request.mark) == 0 implies result == request.reactionId and after.Reaction(result).createdAt == request.occurredAt
        ensures success and count(reaction in before.Reaction where reaction.messageId == request.messageId and reaction.authorId == request.automationId and reaction.mark == request.mark) > 0 implies after.Reaction(result).createdAt == before.Reaction(result).createdAt
        ensures success and count(reaction in before.Reaction where reaction.messageId == request.messageId and reaction.authorId == request.automationId and reaction.mark == request.mark) > 0 implies before.Reaction == after.Reaction
        ensures not success implies before.ChatMessage == after.ChatMessage and before.Reaction == after.Reaction and before.MessagePublication == after.MessagePublication and before.MessageAttachment == after.MessageAttachment
        effects { read AutomationAccount read ChatMessage write Reaction read MessagePublication read MessageAttachment }
      }
      operation removeOwnReaction(request: AutomationReactionRemoval)
        -> Unit
        ! AutomationKeyRejected ! AutomationAccessDenied ! AutomationMutationDenied ! AutomationPersistenceUnavailable {
        state removes Reaction by request.reactionId
        state lists ChatMessage
        state lists MessagePublication
        state lists MessageAttachment
        state lists AutomationAccount
        ensures before.AutomationAccount == after.AutomationAccount
        ensures success implies before.ChatMessage(request.messageId).spaceId == request.spaceId and before.ChatMessage(request.messageId).state == Published
        ensures success implies before.Reaction(request.reactionId).authorId == request.automationId and before.Reaction(request.reactionId).messageId == request.messageId
        ensures before.ChatMessage == after.ChatMessage and before.MessagePublication == after.MessagePublication and before.MessageAttachment == after.MessageAttachment
        ensures not success implies before.ChatMessage == after.ChatMessage and before.Reaction == after.Reaction and before.MessagePublication == after.MessagePublication and before.MessageAttachment == after.MessageAttachment
        effects { read AutomationAccount read ChatMessage write Reaction read MessagePublication read MessageAttachment }
      }
    }

