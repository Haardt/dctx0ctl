      expect result == Reaction { id = "00000000-0000-4000-8000-000000000065" authorId = "00000000-0000-4000-8000-000000000063" messageId = "00000000-0000-4000-8000-000000000061" mark = "👍" createdAt = "2026-10-05T12:00:00.000Z" }
