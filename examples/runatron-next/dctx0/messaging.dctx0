    surface AutomationChatApi exposes requestReply {
      operation publish(request: AutomationPost)
        -> AutomationMessageId
        ! AutomationKeyRejected ! AutomationAccessDenied ! AutomationContentRejected ! AutomationPublicationConflict ! AutomationPersistenceUnavailable
      effects { read AutomationAccount read ChatMessage read MessagePublication read Reaction write ChatMessage write MessagePublication write MessageAttachment call AutomationRepository.authorizeChat call AutomationConversationGateway.publish as messageId }

      operation editOwn(request: AutomationEdit)
        -> Unit
        ! AutomationKeyRejected ! AutomationAccessDenied ! AutomationMutationDenied ! AutomationContentRejected ! AutomationPersistenceUnavailable
      effects { read AutomationAccount read ChatMessage read Reaction read MessagePublication read MessageAttachment write ChatMessage call AutomationRepository.authorizeChat call AutomationConversationGateway.editOwn }

      operation deleteOwn(request: AutomationDelete)
        -> Unit
        ! AutomationKeyRejected ! AutomationAccessDenied ! AutomationMutationDenied ! AutomationPersistenceUnavailable
      effects { read AutomationAccount read ChatMessage read MessagePublication write ChatMessage write MessageAttachment write Reaction call AutomationRepository.authorizeChat call AutomationConversationGateway.deleteOwn }

      operation react(request: AutomationReaction)
        -> AutomationReactionId
        ! AutomationKeyRejected ! AutomationAccessDenied ! AutomationMutationDenied ! AutomationContentRejected ! AutomationPersistenceUnavailable
      effects { read AutomationAccount read ChatMessage read MessagePublication read MessageAttachment write Reaction call AutomationRepository.authorizeChat call AutomationConversationGateway.react as reactionId }

      operation removeOwnReaction(request: AutomationReactionRemoval)
        -> Unit
        ! AutomationKeyRejected ! AutomationAccessDenied ! AutomationMutationDenied ! AutomationPersistenceUnavailable
      effects { read AutomationAccount read ChatMessage read MessagePublication read MessageAttachment write Reaction call AutomationRepository.authorizeChat call AutomationConversationGateway.removeOwnReaction }
    }

