    example "real message pages the latest persisted messages" {
      when result = MessageRepository.page(ReadMessages { actorId = "00000000-0000-4000-8000-000000000063" spaceId = "00000000-0000-4000-8000-000000000062" cursor = MessageCursor { before = None after = None around = None limit = 2 } })
      expect result == MessagePage { items = [MessageView { id = "00000000-0000-4000-8000-000000000066" spaceId = "00000000-0000-4000-8000-000000000062" authorId = "00000000-0000-4000-8000-000000000063" clientMessageKey = "native-read-66" body = "Second message" attachmentName = None kind = Conversation runId = None attemptId = None humanPrincipalId = None delegationSessionId = None progressRevision = 0 payloadKind = Text createdAt = "2026-10-04T13:00:00.000Z" updatedAt = "2026-10-04T13:00:00.000Z" reactions = []  }, MessageView { id = "00000000-0000-4000-8000-000000000067" spaceId = "00000000-0000-4000-8000-000000000062" authorId = "00000000-0000-4000-8000-000000000063" clientMessageKey = "native-read-67" body = "Third message" attachmentName = None kind = Conversation runId = None attemptId = None humanPrincipalId = None delegationSessionId = None progressRevision = 0 payloadKind = Text createdAt = "2026-10-04T14:00:00.000Z" updatedAt = "2026-10-04T14:00:00.000Z" reactions = []  }] olderCursor = Some("00000000-0000-4000-8000-000000000066") newerCursor = None }
    }
    example "real message pages before a known message" {
      when result = MessageRepository.page(ReadMessages { actorId = "00000000-0000-4000-8000-000000000063" spaceId = "00000000-0000-4000-8000-000000000062" cursor = MessageCursor { before = Some("00000000-0000-4000-8000-000000000067") after = None around = None limit = 1 } })
      expect result == MessagePage { items = [MessageView { id = "00000000-0000-4000-8000-000000000066" spaceId = "00000000-0000-4000-8000-000000000062" authorId = "00000000-0000-4000-8000-000000000063" clientMessageKey = "native-read-66" body = "Second message" attachmentName = None kind = Conversation runId = None attemptId = None humanPrincipalId = None delegationSessionId = None progressRevision = 0 payloadKind = Text createdAt = "2026-10-04T13:00:00.000Z" updatedAt = "2026-10-04T13:00:00.000Z" reactions = []  }] olderCursor = Some("00000000-0000-4000-8000-000000000066") newerCursor = Some("00000000-0000-4000-8000-000000000066") }
    }
