      when result = MessageRepository.removeReaction(RemoveReaction { actorId = "00000000-0000-4000-8000-000000000063" reactionId = "00000000-0000-4000-8000-000000000069" occurredAt = "2026-10-06T12:00:00.000Z" })
      expect result fails ReactionNotFound
    }
    example "edit an authored message" {
      given MessageRepository.edit(editMessage) returns MessageView { id = messageId spaceId = spaceId authorId = authorId clientMessageKey = "client-1" body = "Hello again" attachmentName = None kind = Conversation runId = None attemptId = None humanPrincipalId = None delegationSessionId = None progressRevision = 0 payloadKind = Text createdAt = createdAt updatedAt = occurredAt reactions = noReactions }
      when result = MessageApi.edit(editMessage)
      expect Success
      expect emits MessageEdited { messageId = messageId actorId = authorId }
    }
    example "delete an authored message" {
      given MessageRepository.delete(deleteMessage) returns Unit
      when result = MessageApi.delete(deleteMessage)
      expect Success
      expect emits MessageDeleted { messageId = messageId actorId = authorId }
    }
    example "add a reaction" {
      given MessageRepository.addReaction(addReaction) returns Reaction { id = reactionId messageId = messageId authorId = authorId mark = "👍" createdAt = occurredAt }
      when result = MessageApi.addReaction(addReaction)
      expect Success
      expect emits ReactionAdded { reactionId = reactionId messageId = messageId actorId = authorId }
    }
    example "remove own reaction" {
      given MessageRepository.removeReaction(removeReaction) returns Reaction { id = reactionId messageId = messageId authorId = authorId mark = "👍" createdAt = occurredAt }
      when result = MessageApi.removeReaction(removeReaction)
      expect Success
      expect emits ReactionRemoved { reactionId = reactionId messageId = messageId actorId = authorId }
    }
    example "page accessible messages" {
      given MessageRepository.page(readMessages) returns MessagePage { items = messages olderCursor = None newerCursor = None }
      when result = MessageApi.page(readMessages)
      expect Success
    }
    example "show an accessible message" {
      given MessageRepository.show(authorId, messageId) returns MessageView { id = messageId spaceId = spaceId authorId = authorId clientMessageKey = "client-1" body = "Hello" attachmentName = None kind = Conversation runId = None attemptId = None humanPrincipalId = None delegationSessionId = None progressRevision = 0 payloadKind = Text createdAt = createdAt updatedAt = createdAt reactions = noReactions }
      when result = MessageApi.show(authorId, messageId)
      expect Success
    }

    lifecycle MessageLifecycle for ChatMessage using state {
      state Published initial
      state Deleted terminal

      transition ConversationHistory.MessageApi.edit from Published to Published
      transition ConversationHistory.MessageApi.delete from Published to Deleted
    }
  }
}
