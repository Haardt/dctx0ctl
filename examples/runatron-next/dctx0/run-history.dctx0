domain PortableHistory {
  value HistorySnapshotId = UUID
  value HistorySectionId = UUID
  value HistoryContentId = UUID
  value HistoryRecordId = UUID
  value HistoryHash = String { length 64..64 }
  value HistorySequence = Int { range 1..2147483647 }
  value HistoryCursor = Int { range 0..2147483647 }
  value HistoryFormatVersion = Int { range 1..1 }
  value HistoryPageSize = Int { range 1..100 }
  value HistoryByteCount = Int { range 0..104857600 }

  type HistoryInputOrigin = HumanTurn | AgentRequest | ChannelMessage | WorkflowInstruction
  type HistoryCompleteness = Complete | Partial
  type HistoryWorkspaceKind = Repository | Commit | Diff | Workspace

  failure HistoryNotFound { reason: String }
  failure HistoryAuthenticationRejected { reason: String }
  failure HistoryAccessDenied { reason: String }
  failure HistoryConflict { reason: String }
  failure HistoryLimitExceeded { reason: String }
  failure HistoryIntegrityRejected { reason: String }
  failure HistoryContinuationRejected { reason: String }
  failure HistoryPersistenceUnavailable { reason: String }

  message HistoryRunnerAuthority {
    runnerId: ExecutionRunnerId
    keyId: ExecutionRunnerKeyId
    runId: AgentRunId
    attemptId: RunAttemptId
    leaseId: RunLeaseId
    delegationCredential: Option<String>
  }
  message HistoryHumanAuthority {
    sessionCredential: String
    runId: AgentRunId
  }
  message HistoryReaderAuthority = Runner(HistoryRunnerAuthority) | Human(HistoryHumanAuthority)
  message HistoryAuthorizedScope {
    runId: AgentRunId
    attemptId: RunAttemptId
    channelId: ExecutionConversationId
    agentId: ExecutionAgentId
    snapshotId: ExecutionSnapshotId
    sessionId: Option<ChannelWorkSessionId>
    humanPrincipalId: Option<ExecutionActorId>
    permittedToolNames: List<String>
    permittedSkillNames: List<String>
    archiveOnly: Boolean
    authorizedAt: Timestamp
  }
  message HistoryReadScope {
    runId: AgentRunId
    channelId: ExecutionConversationId
    authorizedAt: Timestamp
  }

  message PortableHumanInput {
    principalId: ExecutionActorId
    origin: HistoryInputOrigin
    originReference: String
    text: String
    contentIds: List<HistoryContentId>
  }
  message PortableAssistantMessage {
    messageId: UUID
    agentId: ExecutionAgentId
    text: String
    contentIds: List<HistoryContentId>
  }
  message PortableToolCall {
    executionId: UUID
    parentExecutionId: Option<UUID>
    name: String
    arguments: String
    contentIds: List<HistoryContentId>
    writing: Boolean
  }
  message PortableToolResult {
    executionId: UUID
    succeeded: Boolean
    text: String
    contentIds: List<HistoryContentId>
  }
  message PortablePromptAssembly {
    instructionSnapshotHash: HistoryHash
    agentSnapshotId: ExecutionSnapshotId
    messageRecordIds: List<HistoryRecordId>
    effectivePromptContentIds: List<HistoryContentId>
    compactedFromRecordIds: List<HistoryRecordId>
  }
  message PortableSummaryReference {
    summaryId: UUID
    contentIds: List<HistoryContentId>
    artifactIds: List<UUID>
  }
  message PortableBranchReference {
    sourceRunId: AgentRunId
    sourceAttemptId: RunAttemptId
    sourceSnapshotId: HistorySnapshotId
  }
  message PortableHistoryPayload = HumanInput(PortableHumanInput) | AssistantMessage(PortableAssistantMessage) | ToolCall(PortableToolCall) | ToolResult(PortableToolResult) | PromptAssembly(PortablePromptAssembly) | SummaryReference(PortableSummaryReference) | BranchReference(PortableBranchReference)
  message PortableHistoryRecord {
    id: HistoryRecordId
    turnId: RunTurnId
    sequence: HistorySequence
    payload: PortableHistoryPayload
  }
  message PortableHistoryContent {
    id: HistoryContentId
    mediaType: String
    hash: HistoryHash
    bytes: Bytes
  }
  message HistoryContentReference {
    id: HistoryContentId
    mediaType: String
    hash: HistoryHash
    byteCount: HistoryByteCount
  }
  message HistoryWorkspaceReference {
    artifactId: UUID
    kind: HistoryWorkspaceKind
    contentReference: String
    contentHash: HistoryHash
  }
  message HistoryNativeCheckpoint {
    reference: RuntimeCheckpointReference
    runtimeKind: String
    runtimeVersion: String
    snapshotFingerprint: ExecutionAgentFingerprint
  }

  entity HistorySection {
    id: HistorySectionId
    formatVersion: HistoryFormatVersion
    runId: AgentRunId
    attemptId: RunAttemptId
    channelId: ExecutionConversationId
    sequence: HistorySequence
    previousHash: Option<HistoryHash>
    hash: HistoryHash
    records: List<PortableHistoryRecord>
    contentReferences: List<HistoryContentReference>
    byteCount: HistoryByteCount
    acceptedAt: Timestamp
    key id
  }
  entity HistoryContentBatch {
    sectionId: HistorySectionId
    runId: AgentRunId
    attemptId: RunAttemptId
    contents: List<PortableHistoryContent>
    byteCount: HistoryByteCount
    key sectionId
  }
  entity HistoryConfirmedCursor {
    runId: AgentRunId
    attemptId: RunAttemptId
    cursor: HistoryCursor
    lastSectionHash: Option<HistoryHash>
    synchronizedContentBytes: HistoryByteCount
    key runId attemptId
  }
  entity HistorySnapshot {
    id: HistorySnapshotId
    formatVersion: HistoryFormatVersion
    runId: AgentRunId
    attemptId: RunAttemptId
    turnId: RunTurnId
    channelId: ExecutionConversationId
    throughCursor: HistoryCursor
    sectionIds: List<HistorySectionId>
    contentReferences: List<HistoryContentReference>
    canonicalHash: HistoryHash
    completeness: HistoryCompleteness
    summaryId: Option<UUID>
    workspaceReferences: List<HistoryWorkspaceReference>
    requiredToolNames: List<String>
    requiredSkillNames: List<String>
    nativeCheckpoint: Option<HistoryNativeCheckpoint>
    sealedAt: Timestamp
    key id
  }
  entity HistoryLateEvidence {
    sectionId: HistorySectionId
    runId: AgentRunId
    attemptId: RunAttemptId
    channelId: ExecutionConversationId
    formatVersion: HistoryFormatVersion
    sequence: HistorySequence
    hash: HistoryHash
    records: List<PortableHistoryRecord>
    contents: List<PortableHistoryContent>
    archivedAt: Timestamp
    key sectionId
  }

  message AppendRunHistory {
    authority: HistoryRunnerAuthority
    sectionId: HistorySectionId
    formatVersion: HistoryFormatVersion
    sequence: HistorySequence
    previousHash: Option<HistoryHash>
    hash: HistoryHash
    records: List<PortableHistoryRecord>
    contents: List<PortableHistoryContent>
  }
  message HistoryAppendReceipt {
    section: HistorySection
    contentBatch: HistoryContentBatch
    confirmed: HistoryConfirmedCursor
  }
  message SealRunHistory {
    authority: HistoryRunnerAuthority
    snapshotId: HistorySnapshotId
    turnId: RunTurnId
    throughCursor: HistoryCursor
    expectedHash: HistoryHash
    completeness: HistoryCompleteness
    summaryId: Option<UUID>
    workspaceReferences: List<HistoryWorkspaceReference>
    requiredToolNames: List<String>
    requiredSkillNames: List<String>
    nativeCheckpoint: Option<HistoryNativeCheckpoint>
  }
  message HumanHistorySectionsQuery {
    attemptId: RunAttemptId
    afterCursor: HistoryCursor
    limit: HistoryPageSize
    snapshotId: Option<HistorySnapshotId>
    contentIds: List<HistoryContentId>
  }
  message ReadRunHistory {
    authority: HistoryReaderAuthority
    snapshotId: Option<HistorySnapshotId>
    attemptId: RunAttemptId
    afterCursor: HistoryCursor
    limit: HistoryPageSize
    contentIds: List<HistoryContentId>
  }
  message HistoryPage {
    runId: AgentRunId
    sections: List<HistorySection>
    contents: List<PortableHistoryContent>
    confirmed: List<HistoryConfirmedCursor>
    snapshots: List<HistorySnapshot>
    nextCursor: Option<HistoryCursor>
  }
  message HistoryManifest {
    runId: AgentRunId
    snapshots: List<HistorySnapshot>
    confirmed: List<HistoryConfirmedCursor>
  }
  message PrepareHistoryContinuation {
    authority: HistoryRunnerAuthority
    sourceSnapshotId: HistorySnapshotId
    runtimeKind: String
    runtimeVersion: String
    useNativeCheckpoint: Boolean
  }
  message HistoryContinuation {
    sourceRunId: AgentRunId
    sourceAttemptId: RunAttemptId
    snapshot: HistorySnapshot
    workspaceReferences: List<HistoryWorkspaceReference>
    contentReferences: List<HistoryContentReference>
    nativeCheckpoint: Option<HistoryNativeCheckpoint>
  }

  module RunHistory {
    intent """Own versioned portable channel-work history, confirmed uploads, immutable
      sealed snapshots and authorized continuation material independently of runtime
      or model-provider implementation types. Late evidence is archived separately
      from active execution authority."""
    decision ConfirmedPortableHistory {
      choose "Store acknowledged typed records and verified content behind immutable hashed snapshots."
      because "A different runner must know exactly which work and workspace evidence is available."
      avoid "Do not import provider tokens, hidden runtime state, secrets or unrelated local conversations."
    }
    owns {
      value HistorySnapshotId value HistorySectionId value HistoryContentId value HistoryRecordId
      value HistoryHash value HistorySequence value HistoryCursor value HistoryFormatVersion
      value HistoryPageSize value HistoryByteCount
      entity HistorySection entity HistoryContentBatch entity HistoryConfirmedCursor
      entity HistorySnapshot entity HistoryLateEvidence
    }
    requires { HistoryAuthorization HistoryRepository HistoryContinuationGateway }

    port HistoryAuthorization {
      operation authorizeRunner(authority: HistoryRunnerAuthority, archiveOnly: Boolean)
        -> HistoryAuthorizedScope
        ! HistoryAuthenticationRejected ! HistoryAccessDenied ! HistoryPersistenceUnavailable {
        ensures success implies result.runId == authority.runId
        ensures success implies result.attemptId == authority.attemptId
        ensures success implies result.archiveOnly == archiveOnly
      }
      operation authorizeReader(authority: HistoryReaderAuthority)
        -> HistoryReadScope
        ! HistoryAuthenticationRejected ! HistoryAccessDenied ! HistoryPersistenceUnavailable
      operation authorizeHuman(authority: HistoryHumanAuthority)
        -> HistoryReadScope
        ! HistoryAuthenticationRejected ! HistoryAccessDenied ! HistoryPersistenceUnavailable {
        ensures success implies result.runId == authority.runId
      }
      operation authorizeContinuation(request: PrepareHistoryContinuation)
        -> HistoryAuthorizedScope
        ! HistoryAuthenticationRejected ! HistoryAccessDenied ! HistoryPersistenceUnavailable
    }
    port HistoryRepository {
      operation append(request: AppendRunHistory, scope: HistoryAuthorizedScope)
        -> HistoryAppendReceipt
        ! HistoryAccessDenied ! HistoryConflict ! HistoryLimitExceeded ! HistoryIntegrityRejected ! HistoryPersistenceUnavailable {
        effects { read HistorySection read HistoryContentBatch read HistoryConfirmedCursor read HistoryLateEvidence write HistorySection write HistoryContentBatch write HistoryConfirmedCursor }
        state upserts HistorySection from result.section
        state upserts HistoryContentBatch from result.contentBatch
        state upserts HistoryConfirmedCursor from result.confirmed
        ensures success implies not scope.archiveOnly
        ensures success implies result.section.id == request.sectionId
        ensures success implies result.section.runId == request.authority.runId
        ensures success implies result.section.attemptId == request.authority.attemptId
        ensures success implies result.section.channelId == scope.channelId
        ensures success implies result.section.sequence == request.sequence
        ensures success implies result.section.formatVersion == request.formatVersion
        ensures success implies result.section.hash == request.hash
        ensures success implies result.section.previousHash == request.previousHash
        ensures success implies result.section.records == request.records
        ensures success implies result.section.byteCount <= 262144
        ensures success implies count(request.records) <= 100
        ensures success implies result.section == after.HistorySection(request.sectionId)
        ensures success implies result.contentBatch == after.HistoryContentBatch(request.sectionId)
        ensures success implies result.confirmed == after.HistoryConfirmedCursor(request.authority.runId, request.authority.attemptId)
        ensures success and count(section in before.HistorySection where section.id == request.sectionId) > 0 implies preserves HistorySection(request.sectionId)
        ensures success implies result.contentBatch.sectionId == request.sectionId
        ensures success implies result.contentBatch.runId == request.authority.runId
        ensures success implies result.contentBatch.attemptId == request.authority.attemptId
        ensures success implies result.contentBatch.contents == request.contents
        ensures success implies result.confirmed.runId == request.authority.runId
        ensures success implies result.confirmed.attemptId == request.authority.attemptId
        ensures success implies result.confirmed.cursor >= request.sequence
        ensures success implies result.confirmed.synchronizedContentBytes <= 104857600
        ensures failure is HistoryAccessDenied implies preserves HistorySection(request.sectionId)
        ensures failure is HistoryAccessDenied implies preserves HistoryContentBatch(request.sectionId)
        ensures failure is HistoryAccessDenied implies preserves HistoryConfirmedCursor(request.authority.runId, request.authority.attemptId)
        ensures failure is HistoryConflict implies preserves HistorySection(request.sectionId)
        ensures failure is HistoryConflict implies preserves HistoryContentBatch(request.sectionId)
        ensures failure is HistoryConflict implies preserves HistoryConfirmedCursor(request.authority.runId, request.authority.attemptId)
        ensures failure is HistoryLimitExceeded implies preserves HistorySection(request.sectionId)
        ensures failure is HistoryLimitExceeded implies preserves HistoryContentBatch(request.sectionId)
        ensures failure is HistoryLimitExceeded implies preserves HistoryConfirmedCursor(request.authority.runId, request.authority.attemptId)
        ensures failure is HistoryIntegrityRejected implies preserves HistorySection(request.sectionId)
        ensures failure is HistoryIntegrityRejected implies preserves HistoryContentBatch(request.sectionId)
        ensures failure is HistoryIntegrityRejected implies preserves HistoryConfirmedCursor(request.authority.runId, request.authority.attemptId)
        ensures failure is HistoryPersistenceUnavailable implies preserves HistorySection(request.sectionId)
        ensures failure is HistoryPersistenceUnavailable implies preserves HistoryContentBatch(request.sectionId)
        ensures failure is HistoryPersistenceUnavailable implies preserves HistoryConfirmedCursor(request.authority.runId, request.authority.attemptId)
      }
      operation seal(request: SealRunHistory, scope: HistoryAuthorizedScope)
        -> HistorySnapshot
        ! HistoryNotFound ! HistoryAccessDenied ! HistoryConflict ! HistoryIntegrityRejected ! HistoryPersistenceUnavailable {
        effects { read HistorySection read HistoryContentBatch read HistoryConfirmedCursor read HistorySnapshot write HistorySnapshot }
        state upserts HistorySnapshot from result
        ensures success implies not scope.archiveOnly
        ensures success implies result.id == request.snapshotId
        ensures success implies result.runId == request.authority.runId
        ensures success implies result.attemptId == request.authority.attemptId
        ensures success implies result.channelId == scope.channelId
        ensures success implies result.turnId == request.turnId
        ensures success implies result.formatVersion == 1
        ensures success implies result.throughCursor == request.throughCursor
        ensures success implies result.canonicalHash == request.expectedHash
        ensures success implies result.completeness == request.completeness
        ensures success implies result.summaryId == request.summaryId
        ensures success implies result.workspaceReferences == request.workspaceReferences
        ensures success implies result.requiredToolNames == request.requiredToolNames
        ensures success implies result.requiredSkillNames == request.requiredSkillNames
        ensures success implies result.nativeCheckpoint == request.nativeCheckpoint
        ensures success implies result == after.HistorySnapshot(request.snapshotId)
        ensures success and count(snapshot in before.HistorySnapshot where snapshot.id == request.snapshotId) > 0 implies preserves HistorySnapshot(request.snapshotId)
        ensures failure is HistoryConflict implies preserves HistorySnapshot(request.snapshotId)
        ensures failure is HistoryIntegrityRejected implies preserves HistorySnapshot(request.snapshotId)
        ensures failure is HistoryAccessDenied implies preserves HistorySnapshot(request.snapshotId)
      }
      operation read(request: ReadRunHistory, scope: HistoryReadScope)
        -> HistoryPage
        ! HistoryNotFound ! HistoryAccessDenied ! HistoryLimitExceeded ! HistoryPersistenceUnavailable {
        effects { read HistorySection read HistoryContentBatch read HistoryConfirmedCursor read HistorySnapshot }
        ensures success implies result.runId == scope.runId
        ensures success implies count(result.sections) <= request.limit
        ensures success implies all(section in result.sections where section.runId == scope.runId and section.attemptId == request.attemptId and section.channelId == scope.channelId and section.sequence > request.afterCursor)
        ensures success implies all(snapshot in result.snapshots where snapshot.runId == scope.runId and snapshot.channelId == scope.channelId)
        ensures success implies all(content in result.contents where contains(request.contentIds, content.id))
      }
      operation manifest(authority: HistoryHumanAuthority, scope: HistoryReadScope)
        -> HistoryManifest
        ! HistoryNotFound ! HistoryAccessDenied ! HistoryPersistenceUnavailable {
        effects { read HistoryConfirmedCursor read HistorySnapshot }
        ensures success implies result.runId == authority.runId
        ensures success implies all(snapshot in result.snapshots where snapshot.runId == authority.runId and snapshot.channelId == scope.channelId)
        ensures success implies all(cursor in result.confirmed where cursor.runId == authority.runId)
      }
      operation archive(request: AppendRunHistory, scope: HistoryAuthorizedScope)
        -> HistoryLateEvidence
        ! HistoryAccessDenied ! HistoryConflict ! HistoryLimitExceeded ! HistoryIntegrityRejected ! HistoryPersistenceUnavailable {
        effects { read HistorySection read HistoryContentBatch read HistoryLateEvidence write HistoryLateEvidence }
        state upserts HistoryLateEvidence from result
        ensures success implies scope.archiveOnly
        ensures success implies result.sectionId == request.sectionId
        ensures success implies result.runId == request.authority.runId
        ensures success implies result.attemptId == request.authority.attemptId
        ensures success implies result.channelId == scope.channelId
        ensures success implies result.formatVersion == request.formatVersion
        ensures success implies result.sequence == request.sequence
        ensures success implies result.hash == request.hash
        ensures success implies result.records == request.records
        ensures success implies result.contents == request.contents
        ensures failure is HistoryConflict implies preserves HistoryLateEvidence(request.sectionId)
        ensures failure is HistoryLimitExceeded implies preserves HistoryLateEvidence(request.sectionId)
        ensures failure is HistoryIntegrityRejected implies preserves HistoryLateEvidence(request.sectionId)
      }
    }
    port HistoryContinuationGateway {
      operation prepare(request: PrepareHistoryContinuation, scope: HistoryAuthorizedScope)
        -> HistoryContinuation
        ! HistoryNotFound ! HistoryAccessDenied ! HistoryContinuationRejected ! HistoryPersistenceUnavailable {
        state observes HistorySnapshot by request.sourceSnapshotId
        effects { read HistorySnapshot read HistoryContentBatch }
        ensures success and not request.useNativeCheckpoint implies result == HistoryContinuation { sourceRunId = before.HistorySnapshot(request.sourceSnapshotId).runId sourceAttemptId = before.HistorySnapshot(request.sourceSnapshotId).attemptId snapshot = before.HistorySnapshot(request.sourceSnapshotId) workspaceReferences = before.HistorySnapshot(request.sourceSnapshotId).workspaceReferences contentReferences = before.HistorySnapshot(request.sourceSnapshotId).contentReferences nativeCheckpoint = None() }
        ensures success and request.useNativeCheckpoint implies result == HistoryContinuation { sourceRunId = before.HistorySnapshot(request.sourceSnapshotId).runId sourceAttemptId = before.HistorySnapshot(request.sourceSnapshotId).attemptId snapshot = before.HistorySnapshot(request.sourceSnapshotId) workspaceReferences = before.HistorySnapshot(request.sourceSnapshotId).workspaceReferences contentReferences = before.HistorySnapshot(request.sourceSnapshotId).contentReferences nativeCheckpoint = before.HistorySnapshot(request.sourceSnapshotId).nativeCheckpoint }
        ensures before.HistorySnapshot == after.HistorySnapshot
        ensures success implies not scope.archiveOnly
        ensures success implies result.snapshot.id == request.sourceSnapshotId
        ensures success implies result.sourceRunId == result.snapshot.runId
        ensures success implies result.sourceAttemptId == result.snapshot.attemptId
        ensures success implies result.snapshot.channelId == scope.channelId
        ensures success implies result.workspaceReferences == result.snapshot.workspaceReferences
        ensures success implies result.contentReferences == result.snapshot.contentReferences
        ensures success implies all(name in result.snapshot.requiredToolNames where contains(scope.permittedToolNames, name))
        ensures success implies all(name in result.snapshot.requiredSkillNames where contains(scope.permittedSkillNames, name))
        ensures success implies request.useNativeCheckpoint implies result.nativeCheckpoint == result.snapshot.nativeCheckpoint
      }
    }

    surface HistoryApi exposes requestReply {
      operation append(request: AppendRunHistory)
        -> HistoryAppendReceipt
        ! HistoryAuthenticationRejected ! HistoryAccessDenied ! HistoryConflict ! HistoryLimitExceeded ! HistoryIntegrityRejected ! HistoryPersistenceUnavailable
      effects { read HistorySection read HistoryContentBatch read HistoryConfirmedCursor read HistoryLateEvidence write HistorySection write HistoryContentBatch write HistoryConfirmedCursor call HistoryAuthorization.authorizeRunner as scope call HistoryRepository.append }
      operation seal(request: SealRunHistory)
        -> HistorySnapshot
        ! HistoryAuthenticationRejected ! HistoryNotFound ! HistoryAccessDenied ! HistoryConflict ! HistoryIntegrityRejected ! HistoryPersistenceUnavailable
      effects { read HistorySection read HistoryContentBatch read HistoryConfirmedCursor read HistorySnapshot write HistorySnapshot call HistoryAuthorization.authorizeRunner as scope call HistoryRepository.seal }
      operation read(request: ReadRunHistory)
        -> HistoryPage
        ! HistoryAuthenticationRejected ! HistoryNotFound ! HistoryAccessDenied ! HistoryLimitExceeded ! HistoryPersistenceUnavailable
      effects { read HistorySection read HistoryContentBatch read HistoryConfirmedCursor read HistorySnapshot call HistoryAuthorization.authorizeReader as scope call HistoryRepository.read }
      operation humanSections(sessionCredential: String, runId: AgentRunId, query: HumanHistorySectionsQuery)
        -> HistoryPage
        ! HistoryAuthenticationRejected ! HistoryNotFound ! HistoryAccessDenied ! HistoryLimitExceeded ! HistoryPersistenceUnavailable
      effects { read HistorySection read HistoryContentBatch read HistoryConfirmedCursor read HistorySnapshot call HistoryAuthorization.authorizeReader as scope call HistoryRepository.read }
      operation manifest(sessionCredential: String, runId: AgentRunId)
        -> HistoryManifest
        ! HistoryAuthenticationRejected ! HistoryNotFound ! HistoryAccessDenied ! HistoryPersistenceUnavailable
      effects { read HistoryConfirmedCursor read HistorySnapshot call HistoryAuthorization.authorizeHuman as scope call HistoryRepository.manifest }
      operation archive(request: AppendRunHistory)
        -> HistoryLateEvidence
        ! HistoryAuthenticationRejected ! HistoryAccessDenied ! HistoryConflict ! HistoryLimitExceeded ! HistoryIntegrityRejected ! HistoryPersistenceUnavailable
      effects { read HistorySection read HistoryContentBatch read HistoryLateEvidence write HistoryLateEvidence call HistoryAuthorization.authorizeRunner as scope call HistoryRepository.archive }
      operation prepareContinuation(request: PrepareHistoryContinuation)
        -> HistoryContinuation
        ! HistoryAuthenticationRejected ! HistoryNotFound ! HistoryAccessDenied ! HistoryContinuationRejected ! HistoryPersistenceUnavailable
      effects { read HistorySnapshot read HistoryContentBatch call HistoryAuthorization.authorizeContinuation as scope call HistoryContinuationGateway.prepare }
    }

    example "native history runner authority returns the complete active scope" {
      when result = HistoryAuthorization.authorizeRunner(HistoryRunnerAuthority { runnerId = "00000000-0000-4000-8000-000000000004" keyId = "00000000-0000-4000-8000-000000000009" runId = "00000000-0000-4000-8000-000000000001" attemptId = "00000000-0000-4000-8000-000000000002" leaseId = "00000000-0000-4000-8000-000000000008" delegationCredential = None }, false)
      expect Success
      expect result == HistoryAuthorizedScope { runId = "00000000-0000-4000-8000-000000000001" attemptId = "00000000-0000-4000-8000-000000000002" channelId = "00000000-0000-4000-8000-000000000003" agentId = "00000000-0000-4000-8000-000000000005" snapshotId = "00000000-0000-4000-8000-000000000006" sessionId = None humanPrincipalId = None permittedToolNames = ["read"] permittedSkillNames = ["coding"] archiveOnly = false authorizedAt = "2026-10-04T12:00:00.000Z" }
    }
    example "native history runner authority archives after lease expiry" {
      when result = HistoryAuthorization.authorizeRunner(HistoryRunnerAuthority { runnerId = "00000000-0000-4000-8000-000000000004" keyId = "00000000-0000-4000-8000-000000000009" runId = "00000000-0000-4000-8000-000000000001" attemptId = "00000000-0000-4000-8000-000000000002" leaseId = "00000000-0000-4000-8000-000000000008" delegationCredential = None }, true)
      expect Success
      expect result == HistoryAuthorizedScope { runId = "00000000-0000-4000-8000-000000000001" attemptId = "00000000-0000-4000-8000-000000000002" channelId = "00000000-0000-4000-8000-000000000003" agentId = "00000000-0000-4000-8000-000000000005" snapshotId = "00000000-0000-4000-8000-000000000006" sessionId = None humanPrincipalId = None permittedToolNames = ["read"] permittedSkillNames = ["coding"] archiveOnly = true authorizedAt = "2026-10-04T12:06:00.000Z" }
    }
    example "native history runner authority rejects an expired active lease" {
      when result = HistoryAuthorization.authorizeRunner(HistoryRunnerAuthority { runnerId = "00000000-0000-4000-8000-000000000004" keyId = "00000000-0000-4000-8000-000000000009" runId = "00000000-0000-4000-8000-000000000001" attemptId = "00000000-0000-4000-8000-000000000002" leaseId = "00000000-0000-4000-8000-000000000008" delegationCredential = None }, false)
      expect result fails HistoryAuthenticationRejected
    }
    example "native history runner authority rejects missing HTTP proof" {
      when result = HistoryAuthorization.authorizeRunner(HistoryRunnerAuthority { runnerId = "00000000-0000-4000-8000-000000000004" keyId = "00000000-0000-4000-8000-000000000009" runId = "00000000-0000-4000-8000-000000000001" attemptId = "00000000-0000-4000-8000-000000000002" leaseId = "00000000-0000-4000-8000-000000000008" delegationCredential = None }, false)
      expect result fails HistoryAuthenticationRejected
    }
    example "native history runner authority rejects a withdrawn current key" {
      when result = HistoryAuthorization.authorizeRunner(HistoryRunnerAuthority { runnerId = "00000000-0000-4000-8000-000000000004" keyId = "00000000-0000-4000-8000-000000000009" runId = "00000000-0000-4000-8000-000000000001" attemptId = "00000000-0000-4000-8000-000000000002" leaseId = "00000000-0000-4000-8000-000000000008" delegationCredential = None }, false)
      expect result fails HistoryAuthenticationRejected
    }
    example "native history runner authority rejects a foreign permanent principal" {
      when result = HistoryAuthorization.authorizeRunner(HistoryRunnerAuthority { runnerId = "00000000-0000-4000-8000-000000000004" keyId = "00000000-0000-4000-8000-000000000009" runId = "00000000-0000-4000-8000-000000000001" attemptId = "00000000-0000-4000-8000-000000000002" leaseId = "00000000-0000-4000-8000-000000000008" delegationCredential = None }, false)
      expect result fails HistoryAccessDenied
    }
    example "native history runner authority rejects missing permanent participation" {
      when result = HistoryAuthorization.authorizeRunner(HistoryRunnerAuthority { runnerId = "00000000-0000-4000-8000-000000000004" keyId = "00000000-0000-4000-8000-000000000009" runId = "00000000-0000-4000-8000-000000000001" attemptId = "00000000-0000-4000-8000-000000000002" leaseId = "00000000-0000-4000-8000-000000000008" delegationCredential = None }, false)
      expect result fails HistoryAccessDenied
    }

    lifecycle HistorySnapshotLifetime for HistorySnapshot using presence {
      state Missing initial
      state Sealed
      transition RunHistory.HistoryApi.seal from Missing to Sealed
      transition RunHistory.HistoryApi.seal from Sealed to Sealed
    }
    constraint "I35: Snapshots are immutable. A matching seal retry returns the original snapshot including sealedAt; a changed identity, content, requested cursor or hash fails HistoryConflict. canonicalHash is SHA-256 of versioned canonical ordered records, verified content hashes and provenance, never a client hash accepted without recomputation."
    constraint "I35: Completeness covers only persisted and acknowledged sections and contents through throughCursor. Missing referenced content or gaps reject a Complete seal. Later sections and archived evidence do not alter an existing snapshot."
    constraint "I36: Portable records contain only this channel-associated run, its human inputs with provenance, assistant messages, tool calls/results, attachments, prompt and compaction provenance, agent/instruction snapshots, turn/branch relationships, summaries and workspace artifacts. Reject secrets, unrelated conversations, opaque provider tokens and internal runtime state."
    constraint "I37: Import and prepareContinuation confer no authority, execute no old tools, mutate no source run and never reuse the original runtime session. The caller starts a new linked run and attempt under freshly checked capabilities and current channel authority."
    constraint "I38: Archive requires an active current runner key bound to the historical attempt, current channel access under participation or delegation, and a late-archive-only decision. An expired or superseded lease may archive evidence but may not append active history, mutate progress, authorize tools, seal an active result or publish a summary."
    constraint "I39: Every continuation identifies sourceRunId, sourceAttemptId, snapshot.id, source summary and workspace evidence. Parallel continuations are independent; source records and snapshots remain unchanged."
    constraint "I40: prepareContinuation verifies every referenced repository, commit, diff and workspace artifact is resolvable and authorized. Missing working state, incomplete required history or missing effective skills/tools fails HistoryContinuationRejected. Native checkpoints are optional and accepted only on explicitly verified runtime/version/snapshot compatibility; requested incompatible or absent checkpoints are rejected."
    constraint "I47: Reject more than 100 records in one upload, more than 256 KiB UTF-8 canonical serialized section metadata and records, any content over 10 MiB, or more than 100 MiB distinct synchronized content per attempt. Measure actual bytes on the server, including late evidence. Never silently truncate."
    constraint "I11/I12/I14/I20: Human read authority derives from an opaque current Human Session credential, account standing and current channel access. Runner operations require the current runner key and either a valid bound channel delegation or durable participation. Authorize each referenced snapshot/content before return and recheck authority at persistence commit, rather than trusting supplied scope or IDs."
    constraint "I25/I48: Section IDs and per-attempt sequences are immutable. Identical canonical retry returns the original acknowledgement and timestamps without second writes/events. Different content under the same section ID or sequence fails HistoryConflict. Only consecutive sections with a matching previousHash advance the confirmed cursor; a gap is rejected, never acknowledged as complete."
    constraint "History append atomically stores its section, verified content batch and confirmed cursor. Any failure preserves all three complete collections. Canonical equality is structural and insensitive to JSON object field ordering; arrays retain order. Content IDs reused with a different hash or bytes fail HistoryConflict."
    constraint "Append and seal require a current unsuperseded execution lease under server time. authorizeReader and authorizeContinuation require current channel read authority and recipient runner/snapshot capabilities, but never source-run lease ownership; these decisions grant no execution authority. A second runner can read and prepare a source snapshot without modifying its run."
    constraint "HistoryApi.humanSections constructs Human authority from its opaque session credential and run path, then uses the same authorizeReader and HistoryRepository.read contract as other history reads. Its cursor, limit, attempt, optional sealed snapshot and requested content references never bypass current channel authorization. Manifest remains metadata-only; section and content retrieval stays bounded and explicit."
    constraint "HistoryReadScope and HistoryAuthorizedScope are owner-issued decisions, not client identity proofs. The HTTP client never supplies them, and delegation credentials and Human Session secrets are never persisted in portable records or returned in manifests."


    example "native history appends one canonical section and confirmed cursor" {
      when result = HistoryRepository.append(AppendRunHistory { authority = HistoryRunnerAuthority { runnerId = "00000000-0000-4000-8000-000000000004" keyId = "00000000-0000-4000-8000-000000000009" runId = "00000000-0000-4000-8000-000000000001" attemptId = "00000000-0000-4000-8000-000000000002" leaseId = "00000000-0000-4000-8000-000000000008" delegationCredential = None } sectionId = "00000000-0000-4000-8000-00000000000b" formatVersion = 1 sequence = 1 previousHash = None hash = "5cab621b53a60d8636224504991f81dd59bb3ba900b61ff226caa3bac84e1fe9" records = [] contents = [] }, HistoryAuthorizedScope { runId = "00000000-0000-4000-8000-000000000001" attemptId = "00000000-0000-4000-8000-000000000002" channelId = "00000000-0000-4000-8000-000000000003" agentId = "00000000-0000-4000-8000-000000000005" snapshotId = "00000000-0000-4000-8000-000000000006" sessionId = None humanPrincipalId = None permittedToolNames = ["read"] permittedSkillNames = ["coding"] archiveOnly = false authorizedAt = "2026-10-04T12:00:00.000Z" })
      expect Success
    }
    example "native history archives evidence without advancing the cursor" {
      when result = HistoryRepository.archive(AppendRunHistory { authority = HistoryRunnerAuthority { runnerId = "00000000-0000-4000-8000-000000000004" keyId = "00000000-0000-4000-8000-000000000009" runId = "00000000-0000-4000-8000-000000000001" attemptId = "00000000-0000-4000-8000-000000000002" leaseId = "00000000-0000-4000-8000-000000000008" delegationCredential = None } sectionId = "00000000-0000-4000-8000-00000000000b" formatVersion = 1 sequence = 1 previousHash = None hash = "5cab621b53a60d8636224504991f81dd59bb3ba900b61ff226caa3bac84e1fe9" records = [] contents = [] }, HistoryAuthorizedScope { runId = "00000000-0000-4000-8000-000000000001" attemptId = "00000000-0000-4000-8000-000000000002" channelId = "00000000-0000-4000-8000-000000000003" agentId = "00000000-0000-4000-8000-000000000005" snapshotId = "00000000-0000-4000-8000-000000000006" sessionId = None humanPrincipalId = None permittedToolNames = ["read"] permittedSkillNames = ["coding"] archiveOnly = true authorizedAt = "2026-10-04T12:00:00.000Z" })
      expect Success
    }
    example "native history seals an actually confirmed section" {
      when result = HistoryRepository.seal(SealRunHistory { authority = HistoryRunnerAuthority { runnerId = "00000000-0000-4000-8000-000000000004" keyId = "00000000-0000-4000-8000-000000000009" runId = "00000000-0000-4000-8000-000000000001" attemptId = "00000000-0000-4000-8000-000000000002" leaseId = "00000000-0000-4000-8000-000000000008" delegationCredential = None } snapshotId = "00000000-0000-4000-8000-00000000000c" turnId = "00000000-0000-4000-8000-00000000000a" throughCursor = 1 expectedHash = "a763cd8ff667b31515a03fd7538a4c64300274ecf42fbbb3efd0811c9a977a93" completeness = Complete summaryId = None workspaceReferences = [] requiredToolNames = ["read"] requiredSkillNames = ["coding"] nativeCheckpoint = None }, HistoryAuthorizedScope { runId = "00000000-0000-4000-8000-000000000001" attemptId = "00000000-0000-4000-8000-000000000002" channelId = "00000000-0000-4000-8000-000000000003" agentId = "00000000-0000-4000-8000-000000000005" snapshotId = "00000000-0000-4000-8000-000000000006" sessionId = None humanPrincipalId = None permittedToolNames = ["read"] permittedSkillNames = ["coding"] archiveOnly = false authorizedAt = "2026-10-04T12:00:00.000Z" })
      expect Success
    }
    example "native continuation returns the complete portable source" {
      when result = HistoryContinuationGateway.prepare(PrepareHistoryContinuation { authority = HistoryRunnerAuthority { runnerId = "00000000-0000-4000-8000-000000000004" keyId = "00000000-0000-4000-8000-000000000009" runId = "00000000-0000-4000-8000-000000000001" attemptId = "00000000-0000-4000-8000-000000000002" leaseId = "00000000-0000-4000-8000-000000000008" delegationCredential = None } sourceSnapshotId = "00000000-0000-4000-8000-00000000000c" runtimeKind = "native-runtime" runtimeVersion = "1" useNativeCheckpoint = false }, HistoryAuthorizedScope { runId = "00000000-0000-4000-8000-000000000001" attemptId = "00000000-0000-4000-8000-000000000002" channelId = "00000000-0000-4000-8000-000000000003" agentId = "00000000-0000-4000-8000-000000000005" snapshotId = "00000000-0000-4000-8000-000000000006" sessionId = None humanPrincipalId = None permittedToolNames = ["read"] permittedSkillNames = ["coding"] archiveOnly = false authorizedAt = "2026-10-04T12:00:00.000Z" })
      expect result == HistoryContinuation { sourceRunId = "00000000-0000-4000-8000-000000000001" sourceAttemptId = "00000000-0000-4000-8000-000000000002" snapshot = HistorySnapshot { id = "00000000-0000-4000-8000-00000000000c" formatVersion = 1 runId = "00000000-0000-4000-8000-000000000001" attemptId = "00000000-0000-4000-8000-000000000002" turnId = "00000000-0000-4000-8000-00000000000a" channelId = "00000000-0000-4000-8000-000000000003" throughCursor = 1 sectionIds = ["00000000-0000-4000-8000-00000000000b"] contentReferences = [] canonicalHash = "a763cd8ff667b31515a03fd7538a4c64300274ecf42fbbb3efd0811c9a977a93" completeness = Complete summaryId = None workspaceReferences = [] requiredToolNames = ["read"] requiredSkillNames = ["coding"] nativeCheckpoint = None sealedAt = "2026-10-04T11:00:00.000Z" } workspaceReferences = [] contentReferences = [] nativeCheckpoint = None }
    }
    example "native continuation returns the compatible checkpoint" {
      when result = HistoryContinuationGateway.prepare(PrepareHistoryContinuation { authority = HistoryRunnerAuthority { runnerId = "00000000-0000-4000-8000-000000000004" keyId = "00000000-0000-4000-8000-000000000009" runId = "00000000-0000-4000-8000-000000000001" attemptId = "00000000-0000-4000-8000-000000000002" leaseId = "00000000-0000-4000-8000-000000000008" delegationCredential = None } sourceSnapshotId = "00000000-0000-4000-8000-00000000000c" runtimeKind = "native-runtime" runtimeVersion = "1" useNativeCheckpoint = true }, HistoryAuthorizedScope { runId = "00000000-0000-4000-8000-000000000001" attemptId = "00000000-0000-4000-8000-000000000002" channelId = "00000000-0000-4000-8000-000000000003" agentId = "00000000-0000-4000-8000-000000000005" snapshotId = "00000000-0000-4000-8000-000000000006" sessionId = None humanPrincipalId = None permittedToolNames = ["read"] permittedSkillNames = ["coding"] archiveOnly = false authorizedAt = "2026-10-04T12:00:00.000Z" })
      expect result == HistoryContinuation { sourceRunId = "00000000-0000-4000-8000-000000000001" sourceAttemptId = "00000000-0000-4000-8000-000000000002" snapshot = HistorySnapshot { id = "00000000-0000-4000-8000-00000000000c" formatVersion = 1 runId = "00000000-0000-4000-8000-000000000001" attemptId = "00000000-0000-4000-8000-000000000002" turnId = "00000000-0000-4000-8000-00000000000a" channelId = "00000000-0000-4000-8000-000000000003" throughCursor = 1 sectionIds = ["00000000-0000-4000-8000-00000000000b"] contentReferences = [] canonicalHash = "37c0da1dbfa28b210e4f650c5c3a23d62f657c5515041a8a45ec755945d30dca" completeness = Complete summaryId = None workspaceReferences = [] requiredToolNames = ["read"] requiredSkillNames = ["coding"] nativeCheckpoint = Some(HistoryNativeCheckpoint { reference = "native-history-checkpoint" runtimeKind = "native-runtime" runtimeVersion = "1" snapshotFingerprint = "native-history-fingerprint" }) sealedAt = "2026-10-04T11:00:00.000Z" } workspaceReferences = [] contentReferences = [] nativeCheckpoint = Some(HistoryNativeCheckpoint { reference = "native-history-checkpoint" runtimeKind = "native-runtime" runtimeVersion = "1" snapshotFingerprint = "native-history-fingerprint" }) }
    }

    example "acknowledge one verified section and its persisted cursor" {
      given HistoryAuthorization.authorizeRunner(runnerAuthority, false) returns activeScope
      given HistoryRepository.append(AppendRunHistory { authority = runnerAuthority sectionId = sectionId formatVersion = formatVersion sequence = sequence previousHash = previousHash hash = hash records = records contents = contents }, activeScope) returns HistoryAppendReceipt { section = acceptedSection contentBatch = acceptedContents confirmed = confirmedCursor }
      when result = HistoryApi.append(AppendRunHistory { authority = runnerAuthority sectionId = sectionId formatVersion = formatVersion sequence = sequence previousHash = previousHash hash = hash records = records contents = contents })
      expect result == HistoryAppendReceipt { section = acceptedSection contentBatch = acceptedContents confirmed = confirmedCursor }
    }
    example "return the immutable sealed snapshot on a matching retry" {
      given HistoryAuthorization.authorizeRunner(runnerAuthority, false) returns activeScope
      given HistoryRepository.seal(SealRunHistory { authority = runnerAuthority snapshotId = snapshotId turnId = turnId throughCursor = throughCursor expectedHash = expectedHash completeness = completeness summaryId = summaryId workspaceReferences = workspaceReferences requiredToolNames = requiredToolNames requiredSkillNames = requiredSkillNames nativeCheckpoint = nativeCheckpoint }, activeScope) returns sealedSnapshot
      when result = HistoryApi.seal(SealRunHistory { authority = runnerAuthority snapshotId = snapshotId turnId = turnId throughCursor = throughCursor expectedHash = expectedHash completeness = completeness summaryId = summaryId workspaceReferences = workspaceReferences requiredToolNames = requiredToolNames requiredSkillNames = requiredSkillNames nativeCheckpoint = nativeCheckpoint })
      expect result == sealedSnapshot
    }
    example "read a channel-authorized page and explicitly requested content" {
      given HistoryAuthorization.authorizeReader(readerAuthority) returns readScope
      given HistoryRepository.read(ReadRunHistory { authority = readerAuthority snapshotId = snapshotId attemptId = attemptId afterCursor = afterCursor limit = limit contentIds = contentIds }, readScope) returns HistoryPage { runId = runId sections = [acceptedSection] contents = [] confirmed = [confirmedCursor] snapshots = [sealedSnapshot] nextCursor = None }
      when result = HistoryApi.read(ReadRunHistory { authority = readerAuthority snapshotId = snapshotId attemptId = attemptId afterCursor = afterCursor limit = limit contentIds = contentIds })
      expect result == HistoryPage { runId = runId sections = [acceptedSection] contents = [] confirmed = [confirmedCursor] snapshots = [sealedSnapshot] nextCursor = None }
    }
    example "read human history sections using current opaque session authority" {
      given HistoryAuthorization.authorizeReader(Human { value = HistoryHumanAuthority { sessionCredential = sessionCredential runId = runId } }) returns readScope
      given HistoryRepository.read(ReadRunHistory { authority = Human { value = HistoryHumanAuthority { sessionCredential = sessionCredential runId = runId } } attemptId = attemptId afterCursor = 0 limit = 50 snapshotId = None contentIds = [] }, readScope) returns historyPage
      when result = HistoryApi.humanSections(sessionCredential, runId, HumanHistorySectionsQuery { attemptId = attemptId afterCursor = 0 limit = 50 snapshotId = None contentIds = [] })
      expect result == historyPage
    }
    example "expired human sessions cannot read history sections" {
      given HistoryAuthorization.authorizeReader(Human { value = HistoryHumanAuthority { sessionCredential = expiredSessionCredential runId = runId } }) fails HistoryAuthenticationRejected { reason = "human session expired" }
      when result = HistoryApi.humanSections(expiredSessionCredential, runId, HumanHistorySectionsQuery { attemptId = attemptId afterCursor = 0 limit = 50 snapshotId = None contentIds = [] })
      expect result fails HistoryAuthenticationRejected
    }
    example "provide a human manifest under current session authority" {
      given HistoryAuthorization.authorizeHuman(HistoryHumanAuthority { sessionCredential = sessionCredential runId = runId }) returns readScope
      given HistoryRepository.manifest(HistoryHumanAuthority { sessionCredential = sessionCredential runId = runId }, readScope) returns HistoryManifest { runId = runId snapshots = [sealedSnapshot] confirmed = [confirmedCursor] }
      when result = HistoryApi.manifest(sessionCredential, runId)
      expect result == HistoryManifest { runId = runId snapshots = [sealedSnapshot] confirmed = [confirmedCursor] }
    }
    example "archive late evidence without advancing the active cursor" {
      given HistoryAuthorization.authorizeRunner(runnerAuthority, true) returns archiveScope
      given HistoryRepository.archive(AppendRunHistory { authority = runnerAuthority sectionId = sectionId formatVersion = formatVersion sequence = sequence previousHash = previousHash hash = hash records = records contents = contents }, archiveScope) returns archivedEvidence
      when result = HistoryApi.archive(AppendRunHistory { authority = runnerAuthority sectionId = sectionId formatVersion = formatVersion sequence = sequence previousHash = previousHash hash = hash records = records contents = contents })
      expect result == archivedEvidence
    }
    example "prepare portable continuation on another authorized runner" {
      given HistoryAuthorization.authorizeContinuation(continuationRequest) returns continuationScope
      given HistoryContinuationGateway.prepare(continuationRequest, continuationScope) returns HistoryContinuation { sourceRunId = sourceRunId sourceAttemptId = sourceAttemptId snapshot = sealedSnapshot workspaceReferences = [] contentReferences = [] nativeCheckpoint = None }
      when result = HistoryApi.prepareContinuation(continuationRequest)
      expect result == HistoryContinuation { sourceRunId = sourceRunId sourceAttemptId = sourceAttemptId snapshot = sealedSnapshot workspaceReferences = [] contentReferences = [] nativeCheckpoint = None }
    }

    example "reject an upload from an unauthenticated runner" {
      given HistoryAuthorization.authorizeRunner(runnerAuthority, false) fails HistoryAuthenticationRejected { reason = "runner key is not current" }
      when result = HistoryApi.append(AppendRunHistory { authority = runnerAuthority sectionId = sectionId formatVersion = formatVersion sequence = sequence previousHash = previousHash hash = hash records = records contents = contents })
      expect result fails HistoryAuthenticationRejected
    }
    example "reject a different channel delegation before returning history" {
      given HistoryAuthorization.authorizeReader(readerAuthority) fails HistoryAccessDenied { reason = "delegation belongs to another channel" }
      when result = HistoryApi.read(ReadRunHistory { authority = readerAuthority snapshotId = snapshotId attemptId = attemptId afterCursor = afterCursor limit = limit contentIds = contentIds })
      expect result fails HistoryAccessDenied
    }
    example "reject a forged human identity without an opaque session" {
      given HistoryAuthorization.authorizeHuman(HistoryHumanAuthority { sessionCredential = sessionCredential runId = runId }) fails HistoryAuthenticationRejected { reason = "human session credential is invalid" }
      when result = HistoryApi.manifest(sessionCredential, runId)
      expect result fails HistoryAuthenticationRejected
    }
    example "reject an upload gap instead of claiming a complete cursor" {
      given HistoryAuthorization.authorizeRunner(runnerAuthority, false) returns activeScope
      given HistoryRepository.append(AppendRunHistory { authority = runnerAuthority sectionId = sectionId formatVersion = formatVersion sequence = sequence previousHash = previousHash hash = hash records = records contents = contents }, activeScope) fails HistoryConflict { reason = "section sequence is not the next confirmed sequence" }
      when result = HistoryApi.append(AppendRunHistory { authority = runnerAuthority sectionId = sectionId formatVersion = formatVersion sequence = sequence previousHash = previousHash hash = hash records = records contents = contents })
      expect result fails HistoryConflict
    }
    example "reject oversize content without silent truncation" {
      given HistoryAuthorization.authorizeRunner(runnerAuthority, false) returns activeScope
      given HistoryRepository.append(AppendRunHistory { authority = runnerAuthority sectionId = sectionId formatVersion = formatVersion sequence = sequence previousHash = previousHash hash = hash records = records contents = contents }, activeScope) fails HistoryLimitExceeded { reason = "referenced content exceeds ten MiB" }
      when result = HistoryApi.append(AppendRunHistory { authority = runnerAuthority sectionId = sectionId formatVersion = formatVersion sequence = sequence previousHash = previousHash hash = hash records = records contents = contents })
      expect result fails HistoryLimitExceeded
    }
    example "reject sealing when a required referenced content is missing" {
      given HistoryAuthorization.authorizeRunner(runnerAuthority, false) returns activeScope
      given HistoryRepository.seal(SealRunHistory { authority = runnerAuthority snapshotId = snapshotId turnId = turnId throughCursor = throughCursor expectedHash = expectedHash completeness = completeness summaryId = summaryId workspaceReferences = workspaceReferences requiredToolNames = requiredToolNames requiredSkillNames = requiredSkillNames nativeCheckpoint = nativeCheckpoint }, activeScope) fails HistoryIntegrityRejected { reason = "complete snapshot references missing content" }
      when result = HistoryApi.seal(SealRunHistory { authority = runnerAuthority snapshotId = snapshotId turnId = turnId throughCursor = throughCursor expectedHash = expectedHash completeness = completeness summaryId = summaryId workspaceReferences = workspaceReferences requiredToolNames = requiredToolNames requiredSkillNames = requiredSkillNames nativeCheckpoint = nativeCheckpoint })
      expect result fails HistoryIntegrityRejected
    }
    example "reject continuation with incompatible native checkpoint" {
      given HistoryAuthorization.authorizeContinuation(continuationRequest) returns continuationScope
      given HistoryContinuationGateway.prepare(continuationRequest, continuationScope) fails HistoryContinuationRejected { reason = "native checkpoint runtime is incompatible" }
      when result = HistoryApi.prepareContinuation(continuationRequest)
      expect result fails HistoryContinuationRejected
    }
  }
}
