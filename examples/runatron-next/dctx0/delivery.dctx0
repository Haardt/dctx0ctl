domain SoftwareDelivery {
  value ChangeSetId = UUID
  value VerificationRunId = UUID
  value DeploymentId = UUID
  value DeliveryWorkstreamId = UUID
  value DeliveryArtifactId = UUID
  value DeliveryActorId = UUID
  value DeliveryEnvironment = String { length 1..100 }
  value DeliveryExternalReference = String { length 1..500 }

  type VerificationKind = Test | StaticAnalysis | Build | Security | HumanReview | Dctx0Review
  type VerificationStatus = Running | Passed | Failed | Cancelled
  type DeploymentStatus = Planned | Deploying | Succeeded | Failed | RolledBack | Cancelled

  failure ChangeSetNotFound { changeSetId: ChangeSetId }
  failure VerificationRunNotFound { verificationRunId: VerificationRunId }
  failure DeploymentNotFound { deploymentId: DeploymentId }
  failure DeliveryAccessDenied { actorId: DeliveryActorId }
  failure DeliveryTransitionRejected { reason: String }
  failure DeliveryEvidenceRejected { reason: String }
  failure DeliveryLedgerUnavailable { reason: String }

  entity ChangeSet {
    id: ChangeSetId
    workstreamId: DeliveryWorkstreamId
    ticketArtifactId: DeliveryArtifactId
    specificationArtifactIds: List<DeliveryArtifactId>
    diffArtifactId: DeliveryArtifactId
    commitArtifactIds: List<DeliveryArtifactId>
    producedByRunId: Option<UUID>
    recordedBy: DeliveryActorId
    recordedAt: Timestamp
    key id
  }

  entity VerificationRun {
    id: VerificationRunId
    changeSetId: ChangeSetId
    kind: VerificationKind
    status: VerificationStatus
    evidenceArtifactId: DeliveryArtifactId
    externalReference: Option<DeliveryExternalReference>
    startedAt: Timestamp
    completedAt: Option<Timestamp>
    key id
  }

  entity Deployment {
    id: DeploymentId
    changeSetId: ChangeSetId
    environment: DeliveryEnvironment
    status: DeploymentStatus
    deploymentArtifactId: Option<DeliveryArtifactId>
    rollbackArtifactId: Option<DeliveryArtifactId>
    externalReference: Option<DeliveryExternalReference>
    scheduledBy: DeliveryActorId
    scheduledAt: Timestamp
    completedAt: Option<Timestamp>
    key id
  }

  message RecordChangeSet {
    changeSetId: ChangeSetId
    workstreamId: DeliveryWorkstreamId
    ticketArtifactId: DeliveryArtifactId
    specificationArtifactIds: List<DeliveryArtifactId>
    diffArtifactId: DeliveryArtifactId
    commitArtifactIds: List<DeliveryArtifactId>
    producedByRunId: Option<UUID>
    actorId: DeliveryActorId
    occurredAt: Timestamp
  }
  message RecordVerification {
    verificationRunId: VerificationRunId
    changeSetId: ChangeSetId
    kind: VerificationKind
    status: VerificationStatus
    evidenceArtifactId: DeliveryArtifactId
    externalReference: Option<DeliveryExternalReference>
    startedAt: Timestamp
    completedAt: Option<Timestamp>
    actorId: DeliveryActorId
  }
  message ScheduleDeployment {
    deploymentId: DeploymentId
    changeSetId: ChangeSetId
    environment: DeliveryEnvironment
    externalReference: Option<DeliveryExternalReference>
    actorId: DeliveryActorId
    occurredAt: Timestamp
  }
  message RecordDeploymentStarted { deploymentId: DeploymentId; actorId: DeliveryActorId; occurredAt: Timestamp }
  message CancelDeployment { deploymentId: DeploymentId; actorId: DeliveryActorId; reason: String; occurredAt: Timestamp }
  message RecordDeploymentSucceeded { deploymentId: DeploymentId; deploymentArtifactId: DeliveryArtifactId; actorId: DeliveryActorId; occurredAt: Timestamp }
  message RecordDeploymentFailed { deploymentId: DeploymentId; deploymentArtifactId: DeliveryArtifactId; reason: String; actorId: DeliveryActorId; occurredAt: Timestamp }
  message RecordDeploymentRolledBack { deploymentId: DeploymentId; rollbackArtifactId: DeliveryArtifactId; actorId: DeliveryActorId; occurredAt: Timestamp }

  message ChangeSetView {
    id: ChangeSetId
    workstreamId: DeliveryWorkstreamId
    ticketArtifactId: DeliveryArtifactId
    diffArtifactId: DeliveryArtifactId
    commitArtifactIds: List<DeliveryArtifactId>
    producedByRunId: Option<UUID>
  }
  message DeploymentView {
    id: DeploymentId
    changeSetId: ChangeSetId
    environment: DeliveryEnvironment
    status: DeploymentStatus
    deploymentArtifactId: Option<DeliveryArtifactId>
    rollbackArtifactId: Option<DeliveryArtifactId>
  }
  message DeliveryTimeline {
    workstreamId: DeliveryWorkstreamId
    changeSets: List<ChangeSet>
    verifications: List<VerificationRun>
    deployments: List<Deployment>
  }

  event ChangeSetRecorded { changeSetId: ChangeSetId; workstreamId: DeliveryWorkstreamId }
  event VerificationRecorded { verificationRunId: VerificationRunId; changeSetId: ChangeSetId; status: VerificationStatus }
  event DeploymentScheduled { deploymentId: DeploymentId; changeSetId: ChangeSetId }
  event DeploymentStarted { deploymentId: DeploymentId }
  event DeploymentCancelled { deploymentId: DeploymentId; actorId: DeliveryActorId }
  event DeploymentSucceeded { deploymentId: DeploymentId; deploymentArtifactId: DeliveryArtifactId }
  event DeploymentFailed { deploymentId: DeploymentId; deploymentArtifactId: DeliveryArtifactId }
  event DeploymentRolledBack { deploymentId: DeploymentId; rollbackArtifactId: DeliveryArtifactId }

  module DeliveryEvidence {
    intent """
      Tie each exact ticket and specification revision to its implementation,
      verification, and deployment evidence without pretending that a merge or
      successful build is already a production outcome.
      """

    decision DeliveryUsesExactEvidence {
      choose "Bind verification and deployment to an immutable change set containing exact definition, specification, diff, commit, and run references."
      because "Approvals and test results become unsafe when later code or requirements can silently inherit them."
      avoid "Do not deploy a branch name, latest ticket, mutable tag, or agent assertion as if it identified verified content."
    }

    owns {
      value ChangeSetId value VerificationRunId value DeploymentId value DeliveryWorkstreamId
      value DeliveryArtifactId value DeliveryActorId value DeliveryEnvironment value DeliveryExternalReference
      entity ChangeSet entity VerificationRun entity Deployment
      event ChangeSetRecorded event VerificationRecorded event DeploymentScheduled event DeploymentStarted
      event DeploymentCancelled event DeploymentSucceeded event DeploymentFailed event DeploymentRolledBack
    }

    requires { DeliveryRepository DeliveryArtifactGateway }

    port DeliveryRepository {
      operation recordChange(request: RecordChangeSet)
        -> ChangeSetView
        ! DeliveryAccessDenied ! DeliveryEvidenceRejected ! DeliveryLedgerUnavailable {
        state upserts ChangeSet from ChangeSet {
          id = request.changeSetId
          workstreamId = request.workstreamId
          ticketArtifactId = request.ticketArtifactId
          specificationArtifactIds = request.specificationArtifactIds
          diffArtifactId = request.diffArtifactId
          commitArtifactIds = request.commitArtifactIds
          producedByRunId = request.producedByRunId
          recordedBy = after.ChangeSet(request.changeSetId).recordedBy
          recordedAt = after.ChangeSet(request.changeSetId).recordedAt
        }
        ensures success implies result == ChangeSetView { id = after.ChangeSet(request.changeSetId).id workstreamId = after.ChangeSet(request.changeSetId).workstreamId ticketArtifactId = after.ChangeSet(request.changeSetId).ticketArtifactId diffArtifactId = after.ChangeSet(request.changeSetId).diffArtifactId commitArtifactIds = after.ChangeSet(request.changeSetId).commitArtifactIds producedByRunId = after.ChangeSet(request.changeSetId).producedByRunId }
        ensures success and creates ChangeSet(request.changeSetId) implies after.ChangeSet(request.changeSetId).recordedBy == request.actorId and after.ChangeSet(request.changeSetId).recordedAt == request.occurredAt
        ensures success implies after.ChangeSet(request.changeSetId).recordedBy == request.actorId or after.ChangeSet(request.changeSetId).recordedBy == before.ChangeSet(request.changeSetId).recordedBy
        ensures success implies after.ChangeSet(request.changeSetId).recordedAt == request.occurredAt or after.ChangeSet(request.changeSetId).recordedAt == before.ChangeSet(request.changeSetId).recordedAt
        ensures success and not creates ChangeSet(request.changeSetId) implies preserves ChangeSet(request.changeSetId)
        ensures not success implies before.ChangeSet == after.ChangeSet
        effects { write ChangeSet }
      }
      operation recordVerification(request: RecordVerification)
        -> VerificationRun
        ! ChangeSetNotFound ! DeliveryAccessDenied ! DeliveryEvidenceRejected ! DeliveryLedgerUnavailable {
        effects { read ChangeSet write VerificationRun }
        state upserts VerificationRun from VerificationRun {
          id = request.verificationRunId
          changeSetId = request.changeSetId
          kind = request.kind
          status = request.status
          evidenceArtifactId = request.evidenceArtifactId
          externalReference = request.externalReference
          startedAt = request.startedAt
          completedAt = request.completedAt
        }
        ensures success implies result == after.VerificationRun(request.verificationRunId)
        ensures success implies after.VerificationRun(request.verificationRunId).startedAt == request.startedAt
      }
      operation scheduleDeployment(request: ScheduleDeployment)
        -> DeploymentView
        ! ChangeSetNotFound ! DeliveryAccessDenied ! DeliveryEvidenceRejected ! DeliveryLedgerUnavailable {
        state observes ChangeSet by request.changeSetId
        state upserts Deployment from Deployment {
          id = request.deploymentId
          changeSetId = request.changeSetId
          environment = request.environment
          status = result.status
          deploymentArtifactId = result.deploymentArtifactId
          rollbackArtifactId = result.rollbackArtifactId
          externalReference = request.externalReference
          scheduledBy = after.Deployment(request.deploymentId).scheduledBy
          scheduledAt = after.Deployment(request.deploymentId).scheduledAt
          completedAt = after.Deployment(request.deploymentId).completedAt
        }
        ensures success implies result == DeploymentView { id = after.Deployment(request.deploymentId).id changeSetId = after.Deployment(request.deploymentId).changeSetId environment = after.Deployment(request.deploymentId).environment status = after.Deployment(request.deploymentId).status deploymentArtifactId = after.Deployment(request.deploymentId).deploymentArtifactId rollbackArtifactId = after.Deployment(request.deploymentId).rollbackArtifactId }
        ensures success and creates Deployment(request.deploymentId) implies result.status == Planned and result.deploymentArtifactId == None() and result.rollbackArtifactId == None() and after.Deployment(request.deploymentId).scheduledBy == request.actorId and after.Deployment(request.deploymentId).scheduledAt == request.occurredAt and after.Deployment(request.deploymentId).completedAt == None()
        ensures success implies after.Deployment(request.deploymentId).scheduledBy == request.actorId or after.Deployment(request.deploymentId).scheduledBy == before.Deployment(request.deploymentId).scheduledBy
        ensures success implies after.Deployment(request.deploymentId).scheduledAt == request.occurredAt or after.Deployment(request.deploymentId).scheduledAt == before.Deployment(request.deploymentId).scheduledAt
        ensures success implies after.Deployment(request.deploymentId).completedAt == None() or after.Deployment(request.deploymentId).completedAt == before.Deployment(request.deploymentId).completedAt
        ensures success and not creates Deployment(request.deploymentId) implies preserves Deployment(request.deploymentId)
        ensures before.ChangeSet == after.ChangeSet
        ensures not success implies before.Deployment == after.Deployment
        effects { read ChangeSet write Deployment }
      }
      operation startDeployment(request: RecordDeploymentStarted)
        -> DeploymentView
        ! DeploymentNotFound ! DeliveryAccessDenied ! DeliveryTransitionRejected ! DeliveryLedgerUnavailable {
        effects { write Deployment }
        state replaces Deployment by request.deploymentId from Deployment {
          id = self.id
          changeSetId = self.changeSetId
          environment = self.environment
          status = Deploying
          deploymentArtifactId = self.deploymentArtifactId
          rollbackArtifactId = self.rollbackArtifactId
          externalReference = self.externalReference
          scheduledBy = self.scheduledBy
          scheduledAt = self.scheduledAt
          completedAt = self.completedAt
        }
        ensures success implies result == DeploymentView {
          id = after.Deployment(request.deploymentId).id
          changeSetId = after.Deployment(request.deploymentId).changeSetId
          environment = after.Deployment(request.deploymentId).environment
          status = after.Deployment(request.deploymentId).status
          deploymentArtifactId = after.Deployment(request.deploymentId).deploymentArtifactId
          rollbackArtifactId = after.Deployment(request.deploymentId).rollbackArtifactId
        }
      }
      operation cancelDeployment(request: CancelDeployment)
        -> DeploymentView
        ! DeploymentNotFound ! DeliveryAccessDenied ! DeliveryTransitionRejected ! DeliveryLedgerUnavailable {
        effects { write Deployment }
        state replaces Deployment by request.deploymentId from Deployment {
          id = self.id
          changeSetId = self.changeSetId
          environment = self.environment
          status = DeploymentStatus.Cancelled
          deploymentArtifactId = self.deploymentArtifactId
          rollbackArtifactId = self.rollbackArtifactId
          externalReference = self.externalReference
          scheduledBy = self.scheduledBy
          scheduledAt = self.scheduledAt
          completedAt = Some(request.occurredAt)
        }
        ensures success implies result == DeploymentView {
          id = after.Deployment(request.deploymentId).id
          changeSetId = after.Deployment(request.deploymentId).changeSetId
          environment = after.Deployment(request.deploymentId).environment
          status = after.Deployment(request.deploymentId).status
          deploymentArtifactId = after.Deployment(request.deploymentId).deploymentArtifactId
          rollbackArtifactId = after.Deployment(request.deploymentId).rollbackArtifactId
        }
        ensures failure is DeliveryAccessDenied implies preserves Deployment(request.deploymentId)
        ensures failure is DeliveryTransitionRejected implies preserves Deployment(request.deploymentId)
      }
      operation succeedDeployment(request: RecordDeploymentSucceeded)
        -> DeploymentView
        ! DeploymentNotFound ! DeliveryAccessDenied ! DeliveryTransitionRejected ! DeliveryEvidenceRejected ! DeliveryLedgerUnavailable {
        effects { write Deployment }
        state replaces Deployment by request.deploymentId from Deployment {
          id = self.id
          changeSetId = self.changeSetId
          environment = self.environment
          status = Succeeded
          deploymentArtifactId = Some(request.deploymentArtifactId)
          rollbackArtifactId = self.rollbackArtifactId
          externalReference = self.externalReference
          scheduledBy = self.scheduledBy
          scheduledAt = self.scheduledAt
          completedAt = Some(request.occurredAt)
        }
        ensures success implies result == DeploymentView {
          id = after.Deployment(request.deploymentId).id
          changeSetId = after.Deployment(request.deploymentId).changeSetId
          environment = after.Deployment(request.deploymentId).environment
          status = after.Deployment(request.deploymentId).status
          deploymentArtifactId = after.Deployment(request.deploymentId).deploymentArtifactId
          rollbackArtifactId = after.Deployment(request.deploymentId).rollbackArtifactId
        }
      }
      operation failDeployment(request: RecordDeploymentFailed)
        -> DeploymentView
        ! DeploymentNotFound ! DeliveryAccessDenied ! DeliveryTransitionRejected ! DeliveryEvidenceRejected ! DeliveryLedgerUnavailable {
        effects { write Deployment }
        state replaces Deployment by request.deploymentId from Deployment {
          id = self.id
          changeSetId = self.changeSetId
          environment = self.environment
          status = DeploymentStatus.Failed
          deploymentArtifactId = Some(request.deploymentArtifactId)
          rollbackArtifactId = self.rollbackArtifactId
          externalReference = self.externalReference
          scheduledBy = self.scheduledBy
          scheduledAt = self.scheduledAt
          completedAt = Some(request.occurredAt)
        }
        ensures success implies result == DeploymentView {
          id = after.Deployment(request.deploymentId).id
          changeSetId = after.Deployment(request.deploymentId).changeSetId
          environment = after.Deployment(request.deploymentId).environment
          status = after.Deployment(request.deploymentId).status
          deploymentArtifactId = after.Deployment(request.deploymentId).deploymentArtifactId
          rollbackArtifactId = after.Deployment(request.deploymentId).rollbackArtifactId
        }
      }
      operation rollBackDeployment(request: RecordDeploymentRolledBack)
        -> DeploymentView
        ! DeploymentNotFound ! DeliveryAccessDenied ! DeliveryTransitionRejected ! DeliveryEvidenceRejected ! DeliveryLedgerUnavailable {
        effects { write Deployment }
        state replaces Deployment by request.deploymentId from Deployment {
          id = self.id
          changeSetId = self.changeSetId
          environment = self.environment
          status = RolledBack
          deploymentArtifactId = self.deploymentArtifactId
          rollbackArtifactId = Some(request.rollbackArtifactId)
          externalReference = self.externalReference
          scheduledBy = self.scheduledBy
          scheduledAt = self.scheduledAt
          completedAt = Some(request.occurredAt)
        }
        ensures success implies result == DeploymentView {
          id = after.Deployment(request.deploymentId).id
          changeSetId = after.Deployment(request.deploymentId).changeSetId
          environment = after.Deployment(request.deploymentId).environment
          status = after.Deployment(request.deploymentId).status
          deploymentArtifactId = after.Deployment(request.deploymentId).deploymentArtifactId
          rollbackArtifactId = after.Deployment(request.deploymentId).rollbackArtifactId
        }
      }
      operation timeline(workstreamId: DeliveryWorkstreamId, actorId: DeliveryActorId)
        -> DeliveryTimeline
        ! DeliveryAccessDenied ! DeliveryLedgerUnavailable {
        state lists ChangeSet
        state lists VerificationRun
        state lists Deployment
        ensures before.ChangeSet == after.ChangeSet
        ensures before.VerificationRun == after.VerificationRun
        ensures before.Deployment == after.Deployment
        effects { read ChangeSet read VerificationRun read Deployment }
      }
    }

    port DeliveryArtifactGateway {
      operation assertArtifacts(artifactIds: List<DeliveryArtifactId>, actorId: DeliveryActorId)
        -> Unit
        ! DeliveryAccessDenied ! DeliveryEvidenceRejected
    }

    surface DeliveryApi exposes requestReply {
      operation recordChange(request: RecordChangeSet)
        -> ChangeSetView
        ! DeliveryAccessDenied ! DeliveryEvidenceRejected ! DeliveryLedgerUnavailable
      effects { write ChangeSet call DeliveryArtifactGateway.assertArtifacts call DeliveryRepository.recordChange emit ChangeSetRecorded(changeSetId: request.changeSetId, workstreamId: request.workstreamId) }

      operation recordVerification(request: RecordVerification)
        -> VerificationRun
        ! ChangeSetNotFound ! DeliveryAccessDenied ! DeliveryEvidenceRejected ! DeliveryLedgerUnavailable
      effects { read ChangeSet write VerificationRun call DeliveryArtifactGateway.assertArtifacts call DeliveryRepository.recordVerification emit VerificationRecorded(verificationRunId: request.verificationRunId, changeSetId: request.changeSetId, status: request.status) }

      operation scheduleDeployment(request: ScheduleDeployment)
        -> DeploymentView
        ! ChangeSetNotFound ! DeliveryAccessDenied ! DeliveryEvidenceRejected ! DeliveryLedgerUnavailable
      effects { read ChangeSet write Deployment call DeliveryRepository.scheduleDeployment emit DeploymentScheduled(deploymentId: request.deploymentId, changeSetId: request.changeSetId) }

      operation startDeployment(request: RecordDeploymentStarted)
        -> DeploymentView
        ! DeploymentNotFound ! DeliveryAccessDenied ! DeliveryTransitionRejected ! DeliveryLedgerUnavailable
      effects { write Deployment call DeliveryRepository.startDeployment emit DeploymentStarted(deploymentId: request.deploymentId) }

      operation cancelDeployment(request: CancelDeployment)
        -> DeploymentView
        ! DeploymentNotFound ! DeliveryAccessDenied ! DeliveryTransitionRejected ! DeliveryLedgerUnavailable
      effects { write Deployment call DeliveryRepository.cancelDeployment emit DeploymentCancelled(deploymentId: request.deploymentId, actorId: request.actorId) }

      operation succeedDeployment(request: RecordDeploymentSucceeded)
        -> DeploymentView
        ! DeploymentNotFound ! DeliveryAccessDenied ! DeliveryTransitionRejected ! DeliveryEvidenceRejected ! DeliveryLedgerUnavailable
      effects { write Deployment call DeliveryArtifactGateway.assertArtifacts call DeliveryRepository.succeedDeployment emit DeploymentSucceeded(deploymentId: request.deploymentId, deploymentArtifactId: request.deploymentArtifactId) }

      operation failDeployment(request: RecordDeploymentFailed)
        -> DeploymentView
        ! DeploymentNotFound ! DeliveryAccessDenied ! DeliveryTransitionRejected ! DeliveryEvidenceRejected ! DeliveryLedgerUnavailable
      effects { write Deployment call DeliveryArtifactGateway.assertArtifacts call DeliveryRepository.failDeployment emit DeploymentFailed(deploymentId: request.deploymentId, deploymentArtifactId: request.deploymentArtifactId) }

      operation rollBackDeployment(request: RecordDeploymentRolledBack)
        -> DeploymentView
        ! DeploymentNotFound ! DeliveryAccessDenied ! DeliveryTransitionRejected ! DeliveryEvidenceRejected ! DeliveryLedgerUnavailable
      effects { write Deployment call DeliveryArtifactGateway.assertArtifacts call DeliveryRepository.rollBackDeployment emit DeploymentRolledBack(deploymentId: request.deploymentId, rollbackArtifactId: request.rollbackArtifactId) }

      operation timeline(workstreamId: DeliveryWorkstreamId, actorId: DeliveryActorId)
        -> DeliveryTimeline
        ! DeliveryAccessDenied ! DeliveryLedgerUnavailable
      effects { read ChangeSet read VerificationRun read Deployment call DeliveryRepository.timeline }
    }

    constraint "A change set belongs to exactly one workstream and cites the exact ticket revision, applicable specification versions, diff, commits, and producing run when one exists."
    constraint "A verification result is immutable and evaluates one exact change set; reruns produce new verification identities and evidence artifacts."
    constraint "Passed means the named verification completed successfully, not that every required gate passed or that deployment is authorized."
    constraint "Deployment is authorized only when the target environment's current policy-required verifications and approvals pass for the exact unchanged change set."
    constraint "A deployment result always records an immutable artifact and external reference when execution occurred outside this system."
    constraint "Rollback creates evidence and changes deployment state but never erases the failed or unhealthy deployment history."
    constraint "Completing delivery does not mark a ticket done; production observation and any required operational evidence belong to a separate responsibility."
    constraint "Delivery timeline access follows workstream access and never exposes protected code, build output, credentials, or environments by possession of an identifier."

    example "native delivery records complete immutable change" {
      when result = DeliveryRepository.recordChange(RecordChangeSet { changeSetId = "00000000-0000-4000-8000-000000000701" workstreamId = "00000000-0000-4000-8000-000000000702" ticketArtifactId = "00000000-0000-4000-8000-000000000703" specificationArtifactIds = ["00000000-0000-4000-8000-000000000704"] diffArtifactId = "00000000-0000-4000-8000-000000000705" commitArtifactIds = ["00000000-0000-4000-8000-000000000706"] producedByRunId = None actorId = "00000000-0000-4000-8000-000000000707" occurredAt = "2026-10-07T10:00:00.000Z" })
      expect result == ChangeSetView { id = "00000000-0000-4000-8000-000000000701" workstreamId = "00000000-0000-4000-8000-000000000702" ticketArtifactId = "00000000-0000-4000-8000-000000000703" diffArtifactId = "00000000-0000-4000-8000-000000000705" commitArtifactIds = ["00000000-0000-4000-8000-000000000706"] producedByRunId = None }
    }
    example "native delivery retries immutable change without rewriting provenance" {
      when result = DeliveryRepository.recordChange(RecordChangeSet { changeSetId = "00000000-0000-4000-8000-000000000701" workstreamId = "00000000-0000-4000-8000-000000000702" ticketArtifactId = "00000000-0000-4000-8000-000000000703" specificationArtifactIds = ["00000000-0000-4000-8000-000000000704"] diffArtifactId = "00000000-0000-4000-8000-000000000705" commitArtifactIds = ["00000000-0000-4000-8000-000000000706"] producedByRunId = None actorId = "00000000-0000-4000-8000-000000000707" occurredAt = "2026-10-07T10:00:00.000Z" })
      expect result == ChangeSetView { id = "00000000-0000-4000-8000-000000000701" workstreamId = "00000000-0000-4000-8000-000000000702" ticketArtifactId = "00000000-0000-4000-8000-000000000703" diffArtifactId = "00000000-0000-4000-8000-000000000705" commitArtifactIds = ["00000000-0000-4000-8000-000000000706"] producedByRunId = None }
    }
    example "native delivery records exact verification" {
      when result = DeliveryRepository.recordVerification(RecordVerification { verificationRunId = "00000000-0000-4000-8000-000000000709" changeSetId = "00000000-0000-4000-8000-000000000701" kind = Test status = Passed evidenceArtifactId = "00000000-0000-4000-8000-000000000710" externalReference = None startedAt = "2026-10-07T10:00:00.000Z" completedAt = Some("2026-10-07T10:00:00.000Z") actorId = "00000000-0000-4000-8000-000000000707" })
      expect result == VerificationRun { id = "00000000-0000-4000-8000-000000000709" changeSetId = "00000000-0000-4000-8000-000000000701" kind = Test status = Passed evidenceArtifactId = "00000000-0000-4000-8000-000000000710" externalReference = None startedAt = "2026-10-07T10:00:00.000Z" completedAt = Some("2026-10-07T10:00:00.000Z") }
    }
    example "native delivery schedules exact planned deployment" {
      when result = DeliveryRepository.scheduleDeployment(ScheduleDeployment { deploymentId = "00000000-0000-4000-8000-000000000708" changeSetId = "00000000-0000-4000-8000-000000000701" environment = "production" externalReference = None actorId = "00000000-0000-4000-8000-000000000707" occurredAt = "2026-10-07T10:00:00.000Z" })
      expect result == DeploymentView { id = "00000000-0000-4000-8000-000000000708" changeSetId = "00000000-0000-4000-8000-000000000701" environment = "production" status = Planned deploymentArtifactId = None rollbackArtifactId = None }
    }
    example "native delivery starts exact persisted deployment" {
      when result = DeliveryRepository.startDeployment(RecordDeploymentStarted { deploymentId = "00000000-0000-4000-8000-000000000708" actorId = "00000000-0000-4000-8000-000000000707" occurredAt = "2026-10-07T10:00:00.000Z" })
      expect result == DeploymentView { id = "00000000-0000-4000-8000-000000000708" changeSetId = "00000000-0000-4000-8000-000000000701" environment = "production" status = Deploying deploymentArtifactId = None rollbackArtifactId = None }
    }
    example "native delivery cancels exact persisted deployment" {
      when result = DeliveryRepository.cancelDeployment(CancelDeployment { deploymentId = "00000000-0000-4000-8000-000000000708" actorId = "00000000-0000-4000-8000-000000000707" occurredAt = "2026-10-07T10:00:00.000Z" reason = "Human cancellation" })
      expect result == DeploymentView { id = "00000000-0000-4000-8000-000000000708" changeSetId = "00000000-0000-4000-8000-000000000701" environment = "production" status = Cancelled deploymentArtifactId = None rollbackArtifactId = None }
    }
    example "native delivery succeeds exact persisted deployment" {
      when result = DeliveryRepository.succeedDeployment(RecordDeploymentSucceeded { deploymentId = "00000000-0000-4000-8000-000000000708" actorId = "00000000-0000-4000-8000-000000000707" occurredAt = "2026-10-07T10:00:00.000Z" deploymentArtifactId = "00000000-0000-4000-8000-000000000711" })
      expect result == DeploymentView { id = "00000000-0000-4000-8000-000000000708" changeSetId = "00000000-0000-4000-8000-000000000701" environment = "production" status = Succeeded deploymentArtifactId = Some("00000000-0000-4000-8000-000000000711") rollbackArtifactId = None }
    }
    example "native delivery fails exact persisted deployment" {
      when result = DeliveryRepository.failDeployment(RecordDeploymentFailed { deploymentId = "00000000-0000-4000-8000-000000000708" actorId = "00000000-0000-4000-8000-000000000707" occurredAt = "2026-10-07T10:00:00.000Z" deploymentArtifactId = "00000000-0000-4000-8000-000000000711" reason = "Checks failed" })
      expect result == DeploymentView { id = "00000000-0000-4000-8000-000000000708" changeSetId = "00000000-0000-4000-8000-000000000701" environment = "production" status = Failed deploymentArtifactId = Some("00000000-0000-4000-8000-000000000711") rollbackArtifactId = None }
    }
    example "native delivery rolls back exact persisted deployment" {
      when result = DeliveryRepository.rollBackDeployment(RecordDeploymentRolledBack { deploymentId = "00000000-0000-4000-8000-000000000708" actorId = "00000000-0000-4000-8000-000000000707" occurredAt = "2026-10-07T10:00:00.000Z" rollbackArtifactId = "00000000-0000-4000-8000-000000000712" })
      expect result == DeploymentView { id = "00000000-0000-4000-8000-000000000708" changeSetId = "00000000-0000-4000-8000-000000000701" environment = "production" status = RolledBack deploymentArtifactId = Some("00000000-0000-4000-8000-000000000711") rollbackArtifactId = Some("00000000-0000-4000-8000-000000000712") }
    }
    example "native delivery timeline returns exact scoped evidence" {
      when result = DeliveryRepository.timeline("00000000-0000-4000-8000-000000000702", "00000000-0000-4000-8000-000000000707")
      expect result == DeliveryTimeline { workstreamId = "00000000-0000-4000-8000-000000000702" changeSets = [ChangeSet { id = "00000000-0000-4000-8000-000000000701" workstreamId = "00000000-0000-4000-8000-000000000702" ticketArtifactId = "00000000-0000-4000-8000-000000000703" specificationArtifactIds = ["00000000-0000-4000-8000-000000000704"] diffArtifactId = "00000000-0000-4000-8000-000000000705" commitArtifactIds = ["00000000-0000-4000-8000-000000000706"] producedByRunId = None recordedBy = "00000000-0000-4000-8000-000000000707" recordedAt = "2026-10-07T10:00:00.000Z" }] verifications = [VerificationRun { id = "00000000-0000-4000-8000-000000000709" changeSetId = "00000000-0000-4000-8000-000000000701" kind = Test status = Passed evidenceArtifactId = "00000000-0000-4000-8000-000000000710" externalReference = None startedAt = "2026-10-07T10:00:00.000Z" completedAt = Some("2026-10-07T10:00:00.000Z") }] deployments = [Deployment { id = "00000000-0000-4000-8000-000000000708" changeSetId = "00000000-0000-4000-8000-000000000701" environment = "production" status = Planned deploymentArtifactId = None rollbackArtifactId = None externalReference = None scheduledBy = "00000000-0000-4000-8000-000000000707" scheduledAt = "2026-10-07T10:00:00.000Z" completedAt = None }] }
    }
    example "native delivery scheduling rejects actual denied approval" {
      when result = DeliveryRepository.scheduleDeployment(ScheduleDeployment { deploymentId = "00000000-0000-4000-8000-000000000708" changeSetId = "00000000-0000-4000-8000-000000000701" environment = "production" externalReference = None actorId = "00000000-0000-4000-8000-000000000707" occurredAt = "2026-10-07T10:00:00.000Z" })
      expect result fails DeliveryEvidenceRejected
    }
    example "native delivery rejects an ineligible transition" {
      when result = DeliveryRepository.startDeployment(RecordDeploymentStarted { deploymentId = "00000000-0000-4000-8000-000000000708" actorId = "00000000-0000-4000-8000-000000000707" occurredAt = "2026-10-07T10:00:00.000Z" })
      expect result fails DeliveryTransitionRejected
    }
    example "native delivery verification rejects a missing change" {
      when result = DeliveryRepository.recordVerification(RecordVerification { verificationRunId = "00000000-0000-4000-8000-000000000709" changeSetId = "00000000-0000-4000-8000-000000000799" kind = Test status = Passed evidenceArtifactId = "00000000-0000-4000-8000-000000000710" externalReference = None startedAt = "2026-10-07T10:00:00.000Z" completedAt = Some("2026-10-07T10:00:00.000Z") actorId = "00000000-0000-4000-8000-000000000707" })
      expect result fails ChangeSetNotFound
    }

    example "native delivery artifact accepts real immutable evidence" {
      when result = DeliveryArtifactGateway.assertArtifacts(["00000000-0000-4000-8000-000000000751"], "00000000-0000-4000-8000-000000000753")
      expect Success
    }
    example "native delivery artifact accepts superseded evidence" {
      when result = DeliveryArtifactGateway.assertArtifacts(["00000000-0000-4000-8000-000000000751"], "00000000-0000-4000-8000-000000000753")
      expect Success
    }
    example "native delivery artifact rejects invalidated evidence" {
      when result = DeliveryArtifactGateway.assertArtifacts(["00000000-0000-4000-8000-000000000751"], "00000000-0000-4000-8000-000000000753")
      expect result fails DeliveryEvidenceRejected
    }
    example "native delivery artifact rejects current access denial" {
      when result = DeliveryArtifactGateway.assertArtifacts(["00000000-0000-4000-8000-000000000751"], "00000000-0000-4000-8000-000000000753")
      expect result fails DeliveryAccessDenied
    }
    example "native delivery artifact rejects missing persisted evidence" {
      when result = DeliveryArtifactGateway.assertArtifacts(["00000000-0000-4000-8000-000000000754"], "00000000-0000-4000-8000-000000000753")
      expect result fails DeliveryEvidenceRejected
    }

    example "native delivery timeline returns an exact empty authorized ledger" {
      when result = DeliveryRepository.timeline("00000000-0000-4000-8000-000000000702", "00000000-0000-4000-8000-000000000707")
      expect result == DeliveryTimeline { workstreamId = "00000000-0000-4000-8000-000000000702" changeSets = [] verifications = [] deployments = [] }
    }
    example "native delivery timeline rejects unauthorized ledger access" {
      when result = DeliveryRepository.timeline("00000000-0000-4000-8000-000000000702", "00000000-0000-4000-8000-000000000707")
      expect result fails DeliveryAccessDenied
    }

    example "record an immutable change set with its exact evidence" {
      given DeliveryArtifactGateway.assertArtifacts([ticketArtifactId, diffArtifactId], actorId) returns Unit
      given DeliveryRepository.recordChange(RecordChangeSet { changeSetId = changeSetId workstreamId = workstreamId ticketArtifactId = ticketArtifactId specificationArtifactIds = [] diffArtifactId = diffArtifactId commitArtifactIds = [] producedByRunId = Some(runId) actorId = actorId occurredAt = occurredAt }) returns ChangeSetView { id = changeSetId workstreamId = workstreamId ticketArtifactId = ticketArtifactId diffArtifactId = diffArtifactId commitArtifactIds = [] producedByRunId = Some(runId) }
      when result = DeliveryApi.recordChange(RecordChangeSet { changeSetId = changeSetId workstreamId = workstreamId ticketArtifactId = ticketArtifactId specificationArtifactIds = [] diffArtifactId = diffArtifactId commitArtifactIds = [] producedByRunId = Some(runId) actorId = actorId occurredAt = occurredAt })
      expect Success
      expect emits ChangeSetRecorded { changeSetId = changeSetId workstreamId = workstreamId }
    }
    example "record a passed verification against one exact change set" {
      given DeliveryArtifactGateway.assertArtifacts([evidenceArtifactId], actorId) returns Unit
      given DeliveryRepository.recordVerification(recordVerification) returns VerificationRun { id = verificationRunId changeSetId = changeSetId kind = Test status = Passed evidenceArtifactId = evidenceArtifactId externalReference = Some(externalReference) startedAt = startedAt completedAt = Some(completedAt) }
      when result = DeliveryApi.recordVerification(recordVerification)
      expect Success
      expect emits VerificationRecorded { verificationRunId = verificationRunId changeSetId = changeSetId status = Passed }
    }
    example "schedule a deployment of the exact recorded change" {
      given DeliveryRepository.scheduleDeployment(scheduleDeployment) returns DeploymentView { id = deploymentId changeSetId = changeSetId environment = "production" status = Planned deploymentArtifactId = None rollbackArtifactId = None }
      when result = DeliveryApi.scheduleDeployment(scheduleDeployment)
      expect Success
      expect emits DeploymentScheduled { deploymentId = deploymentId changeSetId = changeSetId }
    }
    example "start a planned deployment" {
      given DeliveryRepository.startDeployment(recordDeploymentStarted) returns DeploymentView { id = deploymentId changeSetId = changeSetId environment = "production" status = Deploying deploymentArtifactId = None rollbackArtifactId = None }
      when result = DeliveryApi.startDeployment(recordDeploymentStarted)
      expect Success
      expect emits DeploymentStarted { deploymentId = deploymentId }
    }
    example "cancel a planned deployment before execution" {
      given DeliveryRepository.cancelDeployment(cancelDeployment) returns DeploymentView { id = deploymentId changeSetId = changeSetId environment = "production" status = Cancelled deploymentArtifactId = None rollbackArtifactId = None }
      when result = DeliveryApi.cancelDeployment(cancelDeployment)
      expect Success
      expect emits DeploymentCancelled { deploymentId = deploymentId actorId = actorId }
    }
    example "reject a deployment transition from an ineligible state" {
      given DeliveryRepository.startDeployment(startSucceededDeployment) fails DeliveryTransitionRejected { reason = "deployment already succeeded" }
      when result = DeliveryApi.startDeployment(startSucceededDeployment)
      expect result fails DeliveryTransitionRejected
    }
    example "record successful deployment evidence" {
      given DeliveryArtifactGateway.assertArtifacts([deploymentArtifactId], actorId) returns Unit
      given DeliveryRepository.succeedDeployment(recordDeploymentSucceeded) returns DeploymentView { id = deploymentId changeSetId = changeSetId environment = "production" status = Succeeded deploymentArtifactId = Some(deploymentArtifactId) rollbackArtifactId = None }
      when result = DeliveryApi.succeedDeployment(recordDeploymentSucceeded)
      expect Success
      expect emits DeploymentSucceeded { deploymentId = deploymentId deploymentArtifactId = deploymentArtifactId }
    }
    example "record failed deployment evidence" {
      given DeliveryArtifactGateway.assertArtifacts([deploymentArtifactId], actorId) returns Unit
      given DeliveryRepository.failDeployment(recordDeploymentFailed) returns DeploymentView { id = deploymentId changeSetId = changeSetId environment = "production" status = Failed deploymentArtifactId = Some(deploymentArtifactId) rollbackArtifactId = None }
      when result = DeliveryApi.failDeployment(recordDeploymentFailed)
      expect Success
      expect emits DeploymentFailed { deploymentId = deploymentId deploymentArtifactId = deploymentArtifactId }
    }
    example "record a rollback without erasing deployment history" {
      given DeliveryArtifactGateway.assertArtifacts([rollbackArtifactId], actorId) returns Unit
      given DeliveryRepository.rollBackDeployment(recordDeploymentRolledBack) returns DeploymentView { id = deploymentId changeSetId = changeSetId environment = "production" status = RolledBack deploymentArtifactId = Some(deploymentArtifactId) rollbackArtifactId = Some(rollbackArtifactId) }
      when result = DeliveryApi.rollBackDeployment(recordDeploymentRolledBack)
      expect Success
      expect emits DeploymentRolledBack { deploymentId = deploymentId rollbackArtifactId = rollbackArtifactId }
    }
    example "show the delivery timeline for an authorized workstream" {
      given DeliveryRepository.timeline(workstreamId, actorId) returns DeliveryTimeline { workstreamId = workstreamId changeSets = changeSets verifications = verificationRuns deployments = deployments }
      when result = DeliveryApi.timeline(workstreamId, actorId)
      expect Success
    }

    lifecycle DeploymentLifecycle for Deployment using status {
      state Planned initial
      state Deploying
      state Succeeded terminal
      state Failed
      state RolledBack terminal
      state Cancelled terminal

      transition DeliveryEvidence.DeliveryApi.startDeployment from Planned to Deploying
      transition DeliveryEvidence.DeliveryApi.cancelDeployment from Planned to Cancelled
      transition DeliveryEvidence.DeliveryApi.succeedDeployment from Deploying to Succeeded
      transition DeliveryEvidence.DeliveryApi.failDeployment from Deploying to Failed
      transition DeliveryEvidence.DeliveryApi.rollBackDeployment from Failed to RolledBack
      transition DeliveryEvidence.DeliveryApi.rollBackDeployment from Succeeded to RolledBack
    }
  }
}
