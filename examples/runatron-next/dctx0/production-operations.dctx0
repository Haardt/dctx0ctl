domain ProductionOperations {
  value ProductionObservationId = UUID
  value OperationalAlertId = UUID
  value ObservedDeploymentId = UUID
  value OperationsProjectId = UUID
  value OperationsWorkstreamId = UUID
  value OperationsArtifactId = UUID
  value OperationsActorId = UUID
  value OperationsAgentId = UUID
  value AlertExternalReference = String { length 1..500 }

  type ProductionHealth = Healthy | Degraded | Unhealthy | Unknown
  type AlertSeverity = Critical | High | Medium | Low
  type AlertState = Open | Acknowledged | Linked | Resolved
  type OperationalAutomation = ManualOnly | SuggestTriage | PrepareBugWorkstream | StartApprovedRemediation

  failure ObservedDeploymentNotFound { deploymentId: ObservedDeploymentId }
  failure OperationalAlertNotFound { alertId: OperationalAlertId }
  failure OperationsAccessDenied { actorId: OperationsActorId }
  failure OperationsTransitionRejected { reason: String }
  failure OperationsEvidenceRejected { reason: String }
  failure OperationalAutomationRejected { reason: String }
  failure OperationsLedgerUnavailable { reason: String }
  failure OperationsIntegrationUnavailable { reason: String }

  entity ProductionObservation {
    id: ProductionObservationId
    deploymentId: ObservedDeploymentId
    health: ProductionHealth
    reportArtifactId: OperationsArtifactId
    observationWindowStartedAt: Timestamp
    observationWindowEndedAt: Timestamp
    recordedAt: Timestamp
    key id
  }

  entity OperationalAlert {
    id: OperationalAlertId
    projectId: OperationsProjectId
    deploymentId: Option<ObservedDeploymentId>
    workstreamId: Option<OperationsWorkstreamId>
    severity: AlertSeverity
    state: AlertState
    title: String
    alertArtifactId: OperationsArtifactId
    externalReference: AlertExternalReference
    automation: OperationalAutomation
    openedAt: Timestamp
    acknowledgedAt: Option<Timestamp>
    resolvedAt: Option<Timestamp>
    key id
  }

  message RecordProductionObservation {
    observationId: ProductionObservationId
    deploymentId: ObservedDeploymentId
    health: ProductionHealth
    reportArtifactId: OperationsArtifactId
    observationWindowStartedAt: Timestamp
    observationWindowEndedAt: Timestamp
    actorId: OperationsActorId
    occurredAt: Timestamp
  }
  message ReceiveOperationalAlert {
    alertId: OperationalAlertId
    projectId: OperationsProjectId
    deploymentId: Option<ObservedDeploymentId>
    severity: AlertSeverity
    title: String
    alertArtifactId: OperationsArtifactId
    externalReference: AlertExternalReference
    automation: OperationalAutomation
    occurredAt: Timestamp
  }
  message AcknowledgeOperationalAlert { alertId: OperationalAlertId; actorId: OperationsActorId; occurredAt: Timestamp }
  message LinkAlertToWorkstream { alertId: OperationalAlertId; workstreamId: OperationsWorkstreamId; actorId: OperationsActorId; occurredAt: Timestamp }
  message ResolveOperationalAlert {
    alertId: OperationalAlertId
    actorId: OperationsActorId
    resolutionArtifactIds: List<OperationsArtifactId>
    occurredAt: Timestamp
  }
  message RequestOperationalTriage {
    alertId: OperationalAlertId
    agentId: OperationsAgentId
    actorId: OperationsActorId
    instruction: String
    occurredAt: Timestamp
  }
  message OperationalAlertView {
    id: OperationalAlertId
    projectId: OperationsProjectId
    deploymentId: Option<ObservedDeploymentId>
    workstreamId: Option<OperationsWorkstreamId>
    severity: AlertSeverity
    state: AlertState
    automation: OperationalAutomation
  }
  message OperationsTimeline {
    workstreamId: OperationsWorkstreamId
    observations: List<ProductionObservation>
    alerts: List<OperationalAlert>
  }

  event ProductionObservationRecorded { observationId: ProductionObservationId; deploymentId: ObservedDeploymentId; health: ProductionHealth }
  event OperationalAlertReceived { alertId: OperationalAlertId; projectId: OperationsProjectId; severity: AlertSeverity }
  event OperationalAlertAcknowledged { alertId: OperationalAlertId; actorId: OperationsActorId }
  event OperationalAlertLinked { alertId: OperationalAlertId; workstreamId: OperationsWorkstreamId }
  event OperationalAlertResolved { alertId: OperationalAlertId }
  event OperationalTriageRequested { alertId: OperationalAlertId; agentId: OperationsAgentId }

  module ProductionFeedback {
    intent """
      Continue a delivered workstream into production observation, alerts, and
      attributable remediation so operational reality becomes part of product
      memory rather than disappearing into a separate monitoring silo.
      """

    decision ProductionIsPartOfTheWork {
      choose "Relate observations and alerts to exact deployments and their originating workstreams whenever that lineage is known."
      because "Implementation is not the result; reliable behavior in production is the result."
      avoid "Do not end traceability at merge, release, deployment success, or a manually closed ticket."
    }
    decision AlertsCanOpenWorkButNotInventAuthority {
      choose "Let policy-authorized automation triage an alert and prepare or link a bug workstream without granting itself unrestricted remediation rights."
      because "Fast response and human accountability must coexist, especially for production mutations."
      avoid "Do not let severity, agent confidence, or an external webhook bypass access, approval, tool, or rollback policy."
    }

    owns {
      value ProductionObservationId value OperationalAlertId value ObservedDeploymentId value OperationsProjectId
      value OperationsWorkstreamId value OperationsArtifactId value OperationsActorId value OperationsAgentId
      value AlertExternalReference
      entity ProductionObservation entity OperationalAlert
      event ProductionObservationRecorded event OperationalAlertReceived event OperationalAlertAcknowledged
      event OperationalAlertLinked event OperationalAlertResolved event OperationalTriageRequested
    }

    requires { ProductionRepository ProductionEvidenceGateway OperationalAutomationGateway }

    port ProductionRepository {
      operation recordObservation(request: RecordProductionObservation)
        -> ProductionObservation
        ! ObservedDeploymentNotFound ! OperationsAccessDenied ! OperationsEvidenceRejected ! OperationsLedgerUnavailable {
        state upserts ProductionObservation from result
        ensures success and (count(observation in before.ProductionObservation where observation.id == request.observationId) > 0) implies result == before.ProductionObservation(request.observationId)
        ensures success and not (count(observation in before.ProductionObservation where observation.id == request.observationId) > 0) implies result == ProductionObservation { id = request.observationId deploymentId = request.deploymentId health = request.health reportArtifactId = request.reportArtifactId observationWindowStartedAt = request.observationWindowStartedAt observationWindowEndedAt = request.observationWindowEndedAt recordedAt = request.occurredAt }
        ensures success implies result.deploymentId == request.deploymentId and result.health == request.health and result.reportArtifactId == request.reportArtifactId and result.observationWindowStartedAt == request.observationWindowStartedAt and result.observationWindowEndedAt == request.observationWindowEndedAt
        ensures not success implies before.ProductionObservation == after.ProductionObservation
        effects { write ProductionObservation }
      }
      operation receiveAlert(request: ReceiveOperationalAlert)
        -> OperationalAlertView
        ! OperationsEvidenceRejected ! OperationsLedgerUnavailable {
        state upserts OperationalAlert from OperationalAlert {
          id = result.id projectId = request.projectId deploymentId = request.deploymentId
          workstreamId = result.workstreamId severity = request.severity state = result.state
          title = trim(request.title) alertArtifactId = request.alertArtifactId
          externalReference = request.externalReference automation = request.automation
          openedAt = after.OperationalAlert(result.id).openedAt
          acknowledgedAt = after.OperationalAlert(result.id).acknowledgedAt resolvedAt = after.OperationalAlert(result.id).resolvedAt
        }
        ensures success implies length(after.OperationalAlert(result.id).title) > 0
        ensures success and count(alert in before.OperationalAlert where alert.id == result.id) == 0 implies result.id == request.alertId and result.state == Open and result.workstreamId == None()
        ensures success and count(alert in before.OperationalAlert where alert.id == result.id) == 0 implies after.OperationalAlert(result.id).openedAt == request.occurredAt and after.OperationalAlert(result.id).acknowledgedAt == None() and after.OperationalAlert(result.id).resolvedAt == None()
        ensures success and count(alert in before.OperationalAlert where alert.id == result.id) > 0 implies after.OperationalAlert(result.id) == before.OperationalAlert(result.id)
        ensures success and count(alert in before.OperationalAlert where alert.id == result.id) > 0 implies after.OperationalAlert(result.id).openedAt == before.OperationalAlert(result.id).openedAt and after.OperationalAlert(result.id).acknowledgedAt == before.OperationalAlert(result.id).acknowledgedAt and after.OperationalAlert(result.id).resolvedAt == before.OperationalAlert(result.id).resolvedAt
        ensures success implies result == OperationalAlertView {
          id = after.OperationalAlert(result.id).id projectId = after.OperationalAlert(result.id).projectId
          deploymentId = after.OperationalAlert(result.id).deploymentId workstreamId = after.OperationalAlert(result.id).workstreamId
          severity = after.OperationalAlert(result.id).severity state = after.OperationalAlert(result.id).state automation = after.OperationalAlert(result.id).automation
        }
        ensures not success implies before.OperationalAlert == after.OperationalAlert
        effects { read OperationalAlert write OperationalAlert }
      }
      operation acknowledgeAlert(request: AcknowledgeOperationalAlert)
        -> OperationalAlertView
        ! OperationalAlertNotFound ! OperationsAccessDenied ! OperationsTransitionRejected ! OperationsLedgerUnavailable {
        state replaces OperationalAlert by request.alertId
        ensures success and before.OperationalAlert(request.alertId).state == Open implies after.OperationalAlert(request.alertId) == OperationalAlert {
          id = before.OperationalAlert(request.alertId).id
          projectId = before.OperationalAlert(request.alertId).projectId
          deploymentId = before.OperationalAlert(request.alertId).deploymentId
          workstreamId = before.OperationalAlert(request.alertId).workstreamId
          severity = before.OperationalAlert(request.alertId).severity
          state = Acknowledged
          title = before.OperationalAlert(request.alertId).title
          alertArtifactId = before.OperationalAlert(request.alertId).alertArtifactId
          externalReference = before.OperationalAlert(request.alertId).externalReference
          automation = before.OperationalAlert(request.alertId).automation
          openedAt = before.OperationalAlert(request.alertId).openedAt
          acknowledgedAt = Some(request.occurredAt)
          resolvedAt = before.OperationalAlert(request.alertId).resolvedAt
        }
        ensures success and before.OperationalAlert(request.alertId).state == Acknowledged implies after.OperationalAlert(request.alertId) == before.OperationalAlert(request.alertId)
        ensures success and before.OperationalAlert(request.alertId).state == Linked and before.OperationalAlert(request.alertId).acknowledgedAt == None() implies after.OperationalAlert(request.alertId) == OperationalAlert {
          id = before.OperationalAlert(request.alertId).id
          projectId = before.OperationalAlert(request.alertId).projectId
          deploymentId = before.OperationalAlert(request.alertId).deploymentId
          workstreamId = before.OperationalAlert(request.alertId).workstreamId
          severity = before.OperationalAlert(request.alertId).severity
          state = before.OperationalAlert(request.alertId).state
          title = before.OperationalAlert(request.alertId).title
          alertArtifactId = before.OperationalAlert(request.alertId).alertArtifactId
          externalReference = before.OperationalAlert(request.alertId).externalReference
          automation = before.OperationalAlert(request.alertId).automation
          openedAt = before.OperationalAlert(request.alertId).openedAt
          acknowledgedAt = Some(request.occurredAt)
          resolvedAt = before.OperationalAlert(request.alertId).resolvedAt
        }
        ensures success and before.OperationalAlert(request.alertId).state == Linked and before.OperationalAlert(request.alertId).acknowledgedAt != None() implies after.OperationalAlert(request.alertId) == before.OperationalAlert(request.alertId)
        ensures success implies before.OperationalAlert(request.alertId).state != Resolved
        ensures success implies result == OperationalAlertView {
          id = after.OperationalAlert(request.alertId).id
          projectId = after.OperationalAlert(request.alertId).projectId
          deploymentId = after.OperationalAlert(request.alertId).deploymentId
          workstreamId = after.OperationalAlert(request.alertId).workstreamId
          severity = after.OperationalAlert(request.alertId).severity
          state = after.OperationalAlert(request.alertId).state
          automation = after.OperationalAlert(request.alertId).automation
        }
        ensures not success implies before.OperationalAlert == after.OperationalAlert
        effects { write OperationalAlert }
      }
      operation linkAlert(request: LinkAlertToWorkstream)
        -> OperationalAlertView
        ! OperationalAlertNotFound ! OperationsAccessDenied ! OperationsTransitionRejected ! OperationsLedgerUnavailable {
        state replaces OperationalAlert by request.alertId
        ensures success and before.OperationalAlert(request.alertId).workstreamId == None() implies after.OperationalAlert(request.alertId) == OperationalAlert {
          id = before.OperationalAlert(request.alertId).id
          projectId = before.OperationalAlert(request.alertId).projectId
          deploymentId = before.OperationalAlert(request.alertId).deploymentId
          workstreamId = Some(request.workstreamId)
          severity = before.OperationalAlert(request.alertId).severity
          state = Linked
          title = before.OperationalAlert(request.alertId).title
          alertArtifactId = before.OperationalAlert(request.alertId).alertArtifactId
          externalReference = before.OperationalAlert(request.alertId).externalReference
          automation = before.OperationalAlert(request.alertId).automation
          openedAt = before.OperationalAlert(request.alertId).openedAt
          acknowledgedAt = before.OperationalAlert(request.alertId).acknowledgedAt
          resolvedAt = before.OperationalAlert(request.alertId).resolvedAt
        }
        ensures success and before.OperationalAlert(request.alertId).workstreamId != None() implies after.OperationalAlert(request.alertId) == before.OperationalAlert(request.alertId)
        ensures success implies before.OperationalAlert(request.alertId).state != Resolved and (before.OperationalAlert(request.alertId).workstreamId == None() or before.OperationalAlert(request.alertId).workstreamId == Some(request.workstreamId))
        ensures success implies result == OperationalAlertView {
          id = after.OperationalAlert(request.alertId).id
          projectId = after.OperationalAlert(request.alertId).projectId
          deploymentId = after.OperationalAlert(request.alertId).deploymentId
          workstreamId = after.OperationalAlert(request.alertId).workstreamId
          severity = after.OperationalAlert(request.alertId).severity
          state = after.OperationalAlert(request.alertId).state
          automation = after.OperationalAlert(request.alertId).automation
        }
        ensures not success implies before.OperationalAlert == after.OperationalAlert
        effects { write OperationalAlert }
      }
      operation resolveAlert(request: ResolveOperationalAlert)
        -> OperationalAlertView
        ! OperationalAlertNotFound ! OperationsAccessDenied ! OperationsTransitionRejected ! OperationsEvidenceRejected ! OperationsLedgerUnavailable {
        state replaces OperationalAlert by request.alertId
        ensures success and before.OperationalAlert(request.alertId).state != Resolved implies after.OperationalAlert(request.alertId) == OperationalAlert {
          id = before.OperationalAlert(request.alertId).id
          projectId = before.OperationalAlert(request.alertId).projectId
          deploymentId = before.OperationalAlert(request.alertId).deploymentId
          workstreamId = before.OperationalAlert(request.alertId).workstreamId
          severity = before.OperationalAlert(request.alertId).severity
          state = Resolved
          title = before.OperationalAlert(request.alertId).title
          alertArtifactId = before.OperationalAlert(request.alertId).alertArtifactId
          externalReference = before.OperationalAlert(request.alertId).externalReference
          automation = before.OperationalAlert(request.alertId).automation
          openedAt = before.OperationalAlert(request.alertId).openedAt
          acknowledgedAt = before.OperationalAlert(request.alertId).acknowledgedAt
          resolvedAt = Some(request.occurredAt)
        }
        ensures success and before.OperationalAlert(request.alertId).state == Resolved implies after.OperationalAlert(request.alertId) == before.OperationalAlert(request.alertId)
        ensures success implies length(request.resolutionArtifactIds) > 0 and length(distinct(request.resolutionArtifactIds)) == length(request.resolutionArtifactIds)
        ensures success implies result == OperationalAlertView {
          id = after.OperationalAlert(request.alertId).id
          projectId = after.OperationalAlert(request.alertId).projectId
          deploymentId = after.OperationalAlert(request.alertId).deploymentId
          workstreamId = after.OperationalAlert(request.alertId).workstreamId
          severity = after.OperationalAlert(request.alertId).severity
          state = after.OperationalAlert(request.alertId).state
          automation = after.OperationalAlert(request.alertId).automation
        }
        ensures not success implies before.OperationalAlert == after.OperationalAlert
        effects { write OperationalAlert }
      }
      operation timeline(workstreamId: OperationsWorkstreamId, actorId: OperationsActorId)
        -> OperationsTimeline
        ! OperationsAccessDenied ! OperationsLedgerUnavailable {
        state lists ProductionObservation
        state lists OperationalAlert
        ensures success implies result == OperationsTimeline { workstreamId = workstreamId observations = result.observations alerts = result.alerts }
        ensures success implies length(result.alerts) == count(alert in before.OperationalAlert where alert.workstreamId == Some(workstreamId))
        ensures success implies all(alert in result.alerts where alert == before.OperationalAlert(alert.id) and alert.workstreamId == Some(workstreamId) and count(other in result.alerts where other.id == alert.id) == 1)
        ensures success implies length(result.observations) == count(observation in before.ProductionObservation where count(alert in before.OperationalAlert where alert.workstreamId == Some(workstreamId) and alert.deploymentId == Some(observation.deploymentId)) > 0)
        ensures success implies all(observation in result.observations where observation == before.ProductionObservation(observation.id) and count(alert in before.OperationalAlert where alert.workstreamId == Some(workstreamId) and alert.deploymentId == Some(observation.deploymentId)) > 0 and count(other in result.observations where other.id == observation.id) == 1)
        ensures not success implies before.ProductionObservation == after.ProductionObservation and before.OperationalAlert == after.OperationalAlert
        effects { read ProductionObservation read OperationalAlert }
      }
    }

    port ProductionEvidenceGateway {
      operation assertDeployment(deploymentId: ObservedDeploymentId, actorId: OperationsActorId)
        -> Unit
        ! ObservedDeploymentNotFound ! OperationsAccessDenied ! OperationsEvidenceRejected
      operation assertArtifacts(artifactIds: List<OperationsArtifactId>, actorId: OperationsActorId)
        -> Unit
        ! OperationsAccessDenied ! OperationsEvidenceRejected
    }

    port OperationalAutomationGateway {
      operation requestTriage(request: RequestOperationalTriage)
        -> Unit
        ! OperationalAlertNotFound ! OperationsAccessDenied ! OperationalAutomationRejected ! OperationsIntegrationUnavailable {
        ensures calls OperationalAutomationBoundary.requestTriage(request) exactly 1
      }
    }

    surface ProductionApi exposes requestReply {
      operation recordObservation(request: RecordProductionObservation)
        -> ProductionObservation
        ! ObservedDeploymentNotFound ! OperationsAccessDenied ! OperationsEvidenceRejected ! OperationsLedgerUnavailable
      effects { write ProductionObservation call ProductionEvidenceGateway.assertDeployment call ProductionEvidenceGateway.assertArtifacts call ProductionRepository.recordObservation emit ProductionObservationRecorded(observationId: request.observationId, deploymentId: request.deploymentId, health: request.health) }

      operation receiveAlert(request: ReceiveOperationalAlert)
        -> OperationalAlertView
        ! OperationsEvidenceRejected ! OperationsLedgerUnavailable
      effects { read OperationalAlert write OperationalAlert call ProductionRepository.receiveAlert emit OperationalAlertReceived(alertId: request.alertId, projectId: request.projectId, severity: request.severity) }

      operation acknowledgeAlert(request: AcknowledgeOperationalAlert)
        -> OperationalAlertView
        ! OperationalAlertNotFound ! OperationsAccessDenied ! OperationsTransitionRejected ! OperationsLedgerUnavailable
      effects { write OperationalAlert call ProductionRepository.acknowledgeAlert emit OperationalAlertAcknowledged(alertId: request.alertId, actorId: request.actorId) }

      operation linkAlert(request: LinkAlertToWorkstream)
        -> OperationalAlertView
        ! OperationalAlertNotFound ! OperationsAccessDenied ! OperationsTransitionRejected ! OperationsLedgerUnavailable
      effects { write OperationalAlert call ProductionRepository.linkAlert emit OperationalAlertLinked(alertId: request.alertId, workstreamId: request.workstreamId) }

      operation resolveAlert(request: ResolveOperationalAlert)
        -> OperationalAlertView
        ! OperationalAlertNotFound ! OperationsAccessDenied ! OperationsTransitionRejected ! OperationsEvidenceRejected ! OperationsLedgerUnavailable
      effects { write OperationalAlert call ProductionEvidenceGateway.assertArtifacts call ProductionRepository.resolveAlert emit OperationalAlertResolved(alertId: request.alertId) }

      operation requestTriage(request: RequestOperationalTriage)
        -> Unit
        ! OperationalAlertNotFound ! OperationsAccessDenied ! OperationalAutomationRejected ! OperationsIntegrationUnavailable
      effects { call OperationalAutomationGateway.requestTriage emit OperationalTriageRequested(alertId: request.alertId, agentId: request.agentId) }

      operation timeline(workstreamId: OperationsWorkstreamId, actorId: OperationsActorId)
        -> OperationsTimeline
        ! OperationsAccessDenied ! OperationsLedgerUnavailable
      effects { read ProductionObservation read OperationalAlert call ProductionRepository.timeline }
    }

    constraint "A production observation names one succeeded deployment, a bounded observation window, health assessment, and immutable monitoring report."
    constraint "Unknown production health cannot satisfy an evidence gate that requires healthy observation."
    constraint "An alert is idempotent by its source and external reference, retains the raw alert artifact, and may link to at most one primary remediation workstream."
    constraint "An alert linked to a deployment inherits its project and causal change lineage; absence of a deployment link remains explicit rather than guessed."
    constraint "Critical or high alerts may request immediate triage, but production mutation still requires current access, tool, approval, blast-radius, and rollback policy."
    constraint "PrepareBugWorkstream may create a draft Bug workstream and ticket evidence; it cannot mark the ticket reviewed, ready, implemented, deployed, observed, or done."
    constraint "StartApprovedRemediation is permitted only by explicit project policy for the alert class and still creates an inspectable coding run and artifact lineage."
    constraint "Resolving an alert requires resolution evidence and does not automatically prove the originating defect fixed or the workstream done."
    constraint "Production timeline access follows workstream and project access and never exposes protected logs, code, environments, or alerts by possession of an identifier."

    example "real production resolves an open alert with durable evidence" {
      when result = ProductionRepository.resolveAlert(ResolveOperationalAlert { alertId = "00000000-0000-4000-8000-0000000000a1" actorId = "00000000-0000-4000-8000-0000000000a2" resolutionArtifactIds = ["00000000-0000-4000-8000-0000000000a5"] occurredAt = "2026-10-07T12:00:00.000Z" })
      expect result == OperationalAlertView { id = "00000000-0000-4000-8000-0000000000a1" projectId = "00000000-0000-4000-8000-0000000000a3" deploymentId = None workstreamId = None severity = High state = Resolved automation = ManualOnly }
    }
    example "real production preserves a resolved alert on retry" {
      when result = ProductionRepository.resolveAlert(ResolveOperationalAlert { alertId = "00000000-0000-4000-8000-0000000000a1" actorId = "00000000-0000-4000-8000-0000000000a2" resolutionArtifactIds = ["00000000-0000-4000-8000-0000000000a5"] occurredAt = "2026-10-07T12:00:00.000Z" })
      expect result == OperationalAlertView { id = "00000000-0000-4000-8000-0000000000a1" projectId = "00000000-0000-4000-8000-0000000000a3" deploymentId = None workstreamId = None severity = High state = Resolved automation = ManualOnly }
    }
    example "real production denies an unauthorized alert resolution" {
      when result = ProductionRepository.resolveAlert(ResolveOperationalAlert { alertId = "00000000-0000-4000-8000-0000000000a1" actorId = "00000000-0000-4000-8000-0000000000a2" resolutionArtifactIds = ["00000000-0000-4000-8000-0000000000a5"] occurredAt = "2026-10-07T12:00:00.000Z" })
      expect result fails OperationsAccessDenied
    }
    example "real production rejects resolution without evidence" {
      when result = ProductionRepository.resolveAlert(ResolveOperationalAlert { alertId = "00000000-0000-4000-8000-0000000000a1" actorId = "00000000-0000-4000-8000-0000000000a2" resolutionArtifactIds = [] occurredAt = "2026-10-07T12:00:00.000Z" })
      expect result fails OperationsEvidenceRejected
    }
    example "real production rejects resolution of an unknown alert" {
      when result = ProductionRepository.resolveAlert(ResolveOperationalAlert { alertId = "00000000-0000-4000-8000-0000000000a1" actorId = "00000000-0000-4000-8000-0000000000a2" resolutionArtifactIds = ["00000000-0000-4000-8000-0000000000a5"] occurredAt = "2026-10-07T12:00:00.000Z" })
      expect result fails OperationalAlertNotFound
    }

    example "real production acknowledges an open alert" {
      when result = ProductionRepository.acknowledgeAlert(AcknowledgeOperationalAlert { alertId = "00000000-0000-4000-8000-0000000000a1" actorId = "00000000-0000-4000-8000-0000000000a2" occurredAt = "2026-10-06T12:00:00.000Z" })
      expect result == OperationalAlertView { id = "00000000-0000-4000-8000-0000000000a1" projectId = "00000000-0000-4000-8000-0000000000a3" deploymentId = None workstreamId = None severity = High state = Acknowledged automation = ManualOnly }
    }
    example "real production preserves an acknowledged alert on retry" {
      when result = ProductionRepository.acknowledgeAlert(AcknowledgeOperationalAlert { alertId = "00000000-0000-4000-8000-0000000000a1" actorId = "00000000-0000-4000-8000-0000000000a2" occurredAt = "2026-10-06T12:00:00.000Z" })
      expect result == OperationalAlertView { id = "00000000-0000-4000-8000-0000000000a1" projectId = "00000000-0000-4000-8000-0000000000a3" deploymentId = None workstreamId = None severity = High state = Acknowledged automation = ManualOnly }
    }
    example "real production acknowledges a linked alert for the first time" {
      when result = ProductionRepository.acknowledgeAlert(AcknowledgeOperationalAlert { alertId = "00000000-0000-4000-8000-0000000000a1" actorId = "00000000-0000-4000-8000-0000000000a2" occurredAt = "2026-10-06T12:00:00.000Z" })
      expect result == OperationalAlertView { id = "00000000-0000-4000-8000-0000000000a1" projectId = "00000000-0000-4000-8000-0000000000a3" deploymentId = None workstreamId = Some("00000000-0000-4000-8000-0000000000a4") severity = High state = Linked automation = ManualOnly }
    }
    example "real production preserves a linked acknowledgement on retry" {
      when result = ProductionRepository.acknowledgeAlert(AcknowledgeOperationalAlert { alertId = "00000000-0000-4000-8000-0000000000a1" actorId = "00000000-0000-4000-8000-0000000000a2" occurredAt = "2026-10-06T12:00:00.000Z" })
      expect result == OperationalAlertView { id = "00000000-0000-4000-8000-0000000000a1" projectId = "00000000-0000-4000-8000-0000000000a3" deploymentId = None workstreamId = Some("00000000-0000-4000-8000-0000000000a4") severity = High state = Linked automation = ManualOnly }
    }
    example "real production rejects acknowledgement of a resolved alert" {
      when result = ProductionRepository.acknowledgeAlert(AcknowledgeOperationalAlert { alertId = "00000000-0000-4000-8000-0000000000a1" actorId = "00000000-0000-4000-8000-0000000000a2" occurredAt = "2026-10-06T12:00:00.000Z" })
      expect result fails OperationsTransitionRejected
    }
    example "real production rejects acknowledgement of an unknown alert" {
      when result = ProductionRepository.acknowledgeAlert(AcknowledgeOperationalAlert { alertId = "00000000-0000-4000-8000-0000000000a1" actorId = "00000000-0000-4000-8000-0000000000a2" occurredAt = "2026-10-06T12:00:00.000Z" })
      expect result fails OperationalAlertNotFound
    }

    example "real production forwards an authorized triage request" {
      when result = OperationalAutomationGateway.requestTriage(RequestOperationalTriage { alertId = "00000000-0000-4000-8000-0000000000b1" agentId = "00000000-0000-4000-8000-000000000081" actorId = "00000000-0000-4000-8000-000000000032" instruction = "Collect production evidence" occurredAt = "2026-10-06T12:00:00.000Z" })
      expect Success
    }
    example "real production preserves a triage policy rejection" {
      when result = OperationalAutomationGateway.requestTriage(RequestOperationalTriage { alertId = "00000000-0000-4000-8000-0000000000b1" agentId = "00000000-0000-4000-8000-000000000081" actorId = "00000000-0000-4000-8000-000000000032" instruction = "Collect production evidence" occurredAt = "2026-10-06T12:00:00.000Z" })
      expect result fails OperationalAutomationRejected
    }
    example "real production reports an unavailable triage integration" {
      when result = OperationalAutomationGateway.requestTriage(RequestOperationalTriage { alertId = "00000000-0000-4000-8000-0000000000b1" agentId = "00000000-0000-4000-8000-000000000081" actorId = "00000000-0000-4000-8000-000000000032" instruction = "Collect production evidence" occurredAt = "2026-10-06T12:00:00.000Z" })
      expect result fails OperationsIntegrationUnavailable
    }

    example "real production receives a new alert" {
      when result = ProductionRepository.receiveAlert(ReceiveOperationalAlert { alertId = "00000000-0000-4000-8000-0000000000b1" projectId = "00000000-0000-4000-8000-0000000000b3" deploymentId = None severity = High title = "  Native operational alert  " alertArtifactId = "00000000-0000-4000-8000-0000000000b5" externalReference = "native-receive" automation = ManualOnly occurredAt = "2026-10-06T12:00:00.000Z" })
      expect result == OperationalAlertView { id = "00000000-0000-4000-8000-0000000000b1" projectId = "00000000-0000-4000-8000-0000000000b3" deploymentId = None workstreamId = None severity = High state = Open automation = ManualOnly }
    }
    example "real production preserves an identical alert retry" {
      when result = ProductionRepository.receiveAlert(ReceiveOperationalAlert { alertId = "00000000-0000-4000-8000-0000000000b2" projectId = "00000000-0000-4000-8000-0000000000b3" deploymentId = None severity = High title = "  Native operational alert  " alertArtifactId = "00000000-0000-4000-8000-0000000000b5" externalReference = "native-receive" automation = ManualOnly occurredAt = "2026-10-07T12:00:00.000Z" })
      expect result == OperationalAlertView { id = "00000000-0000-4000-8000-0000000000b1" projectId = "00000000-0000-4000-8000-0000000000b3" deploymentId = None workstreamId = None severity = High state = Open automation = ManualOnly }
    }
    example "real production rejects changed external alert evidence" {
      when result = ProductionRepository.receiveAlert(ReceiveOperationalAlert { alertId = "00000000-0000-4000-8000-0000000000b1" projectId = "00000000-0000-4000-8000-0000000000b3" deploymentId = None severity = Low title = "  Native operational alert  " alertArtifactId = "00000000-0000-4000-8000-0000000000b5" externalReference = "native-receive" automation = ManualOnly occurredAt = "2026-10-06T12:00:00.000Z" })
      expect result fails OperationsEvidenceRejected
    }
    example "real production rejects an empty alert title" {
      when result = ProductionRepository.receiveAlert(ReceiveOperationalAlert { alertId = "00000000-0000-4000-8000-0000000000b1" projectId = "00000000-0000-4000-8000-0000000000b3" deploymentId = None severity = High title = "   " alertArtifactId = "00000000-0000-4000-8000-0000000000b5" externalReference = "native-receive" automation = ManualOnly occurredAt = "2026-10-06T12:00:00.000Z" })
      expect result fails OperationsEvidenceRejected
    }
    example "real production accepts immutable artifact evidence" {
      when result = ProductionEvidenceGateway.assertArtifacts(["00000000-0000-4000-8000-0000000000c5"], "00000000-0000-4000-8000-0000000000c3")
      expect Success
    }
    example "real production rejects missing artifact evidence" {
      when result = ProductionEvidenceGateway.assertArtifacts(["00000000-0000-4000-8000-0000000000c6"], "00000000-0000-4000-8000-0000000000c3")
      expect result fails OperationsEvidenceRejected
    }
    example "real production rejects duplicate artifact evidence" {
      when result = ProductionEvidenceGateway.assertArtifacts(["00000000-0000-4000-8000-0000000000c5", "00000000-0000-4000-8000-0000000000c5"], "00000000-0000-4000-8000-0000000000c3")
      expect result fails OperationsEvidenceRejected
    }
    example "real production rejects unauthorized artifact evidence" {
      when result = ProductionEvidenceGateway.assertArtifacts(["00000000-0000-4000-8000-0000000000c5"], "00000000-0000-4000-8000-0000000000c4")
      expect result fails OperationsAccessDenied
    }
    example "real production rejects empty artifact evidence" {
      when result = ProductionEvidenceGateway.assertArtifacts([], "00000000-0000-4000-8000-0000000000c3")
      expect result fails OperationsEvidenceRejected
    }
    example "real production accepts a succeeded deployment" {
      when result = ProductionEvidenceGateway.assertDeployment("00000000-0000-4000-8000-0000000000c1", "00000000-0000-4000-8000-0000000000c3")
      expect Success
    }
    example "real production rejects a missing deployment" {
      when result = ProductionEvidenceGateway.assertDeployment("00000000-0000-4000-8000-0000000000c2", "00000000-0000-4000-8000-0000000000c3")
      expect result fails ObservedDeploymentNotFound
    }
    example "real production rejects unauthorized deployment evidence" {
      when result = ProductionEvidenceGateway.assertDeployment("00000000-0000-4000-8000-0000000000c1", "00000000-0000-4000-8000-0000000000c4")
      expect result fails OperationsAccessDenied
    }
    example "real production rejects unsuccessful deployment evidence" {
      when result = ProductionEvidenceGateway.assertDeployment("00000000-0000-4000-8000-0000000000c7", "00000000-0000-4000-8000-0000000000c3")
      expect result fails OperationsEvidenceRejected
    }

    example "record a healthy observation for a succeeded deployment" {
      given ProductionEvidenceGateway.assertDeployment(deploymentId, actorId) returns Unit
      given ProductionEvidenceGateway.assertArtifacts([reportArtifactId], actorId) returns Unit
      given ProductionRepository.recordObservation(recordProductionObservation) returns ProductionObservation { id = observationId deploymentId = deploymentId health = Healthy reportArtifactId = reportArtifactId observationWindowStartedAt = windowStartedAt observationWindowEndedAt = windowEndedAt recordedAt = occurredAt }
      when result = ProductionApi.recordObservation(recordProductionObservation)
      expect Success
      expect emits ProductionObservationRecorded { observationId = observationId deploymentId = deploymentId health = Healthy }
    }
    example "receive an idempotent external production alert" {
      given ProductionRepository.receiveAlert(receiveOperationalAlert) returns OperationalAlertView { id = alertId projectId = projectId deploymentId = Some(deploymentId) workstreamId = None severity = High state = Open automation = SuggestTriage }
      when result = ProductionApi.receiveAlert(receiveOperationalAlert)
      expect Success
      expect emits OperationalAlertReceived { alertId = alertId projectId = projectId severity = High }
    }
    example "acknowledge an open operational alert" {
      given ProductionRepository.acknowledgeAlert(acknowledgeOperationalAlert) returns OperationalAlertView { id = alertId projectId = projectId deploymentId = Some(deploymentId) workstreamId = None severity = High state = Acknowledged automation = SuggestTriage }
      when result = ProductionApi.acknowledgeAlert(acknowledgeOperationalAlert)
      expect Success
      expect emits OperationalAlertAcknowledged { alertId = alertId actorId = actorId }
    }
    example "link an acknowledged alert to its remediation workstream" {
      given ProductionRepository.linkAlert(linkAlertToWorkstream) returns OperationalAlertView { id = alertId projectId = projectId deploymentId = Some(deploymentId) workstreamId = Some(workstreamId) severity = High state = Linked automation = PrepareBugWorkstream }
      when result = ProductionApi.linkAlert(linkAlertToWorkstream)
      expect Success
      expect emits OperationalAlertLinked { alertId = alertId workstreamId = workstreamId }
    }
    example "reject linking a resolved alert again" {
      given ProductionRepository.linkAlert(linkResolvedAlert) fails OperationsTransitionRejected { reason = "alert already resolved" }
      when result = ProductionApi.linkAlert(linkResolvedAlert)
      expect result fails OperationsTransitionRejected
    }
    example "resolve an alert with immutable resolution evidence" {
      given ProductionEvidenceGateway.assertArtifacts([resolutionArtifactId], actorId) returns Unit
      given ProductionRepository.resolveAlert(ResolveOperationalAlert { alertId = alertId actorId = actorId resolutionArtifactIds = [resolutionArtifactId] occurredAt = occurredAt }) returns OperationalAlertView { id = alertId projectId = projectId deploymentId = Some(deploymentId) workstreamId = Some(workstreamId) severity = High state = Resolved automation = ManualOnly }
      when result = ProductionApi.resolveAlert(ResolveOperationalAlert { alertId = alertId actorId = actorId resolutionArtifactIds = [resolutionArtifactId] occurredAt = occurredAt })
      expect Success
      expect emits OperationalAlertResolved { alertId = alertId }
    }
    example "request policy-authorized operational triage" {
      given OperationalAutomationGateway.requestTriage(requestOperationalTriage) returns Unit
      when result = ProductionApi.requestTriage(requestOperationalTriage)
      expect Success
      expect emits OperationalTriageRequested { alertId = alertId agentId = agentId }
    }
    example "show the authorized production timeline" {
      given ProductionRepository.timeline(workstreamId, actorId) returns OperationsTimeline { workstreamId = workstreamId observations = observations alerts = alerts }
      when result = ProductionApi.timeline(workstreamId, actorId)
      expect Success
    }

    lifecycle OperationalAlertLifecycle for OperationalAlert using state {
      state Open initial
      state Acknowledged
      state Linked
      state Resolved terminal

      transition ProductionFeedback.ProductionApi.acknowledgeAlert from Open to Acknowledged
      transition ProductionFeedback.ProductionApi.linkAlert from Open to Linked
      transition ProductionFeedback.ProductionApi.linkAlert from Acknowledged to Linked
      transition ProductionFeedback.ProductionApi.acknowledgeAlert from Linked to Linked
      transition ProductionFeedback.ProductionApi.resolveAlert from Open to Resolved
      transition ProductionFeedback.ProductionApi.resolveAlert from Acknowledged to Resolved
      transition ProductionFeedback.ProductionApi.resolveAlert from Linked to Resolved
    }
  }
}
