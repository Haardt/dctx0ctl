domain WorkEvidence {
  value WorkArtifactId = UUID
  value ArtifactRelationId = UUID
  value ArtifactWorkstreamId = UUID
  value ArtifactActorId = UUID
  value ArtifactMessageId = UUID
  value ArtifactRunId = UUID
  value ArtifactProducerId = UUID
  value ArtifactVersion = Int { range 1..1000000 }
  value ArtifactContentHash = String { length 16..256 }
  value ArtifactContentReference = String { length 1..500 }

  type WorkArtifactKind = Ticket | Decision | Dctx0Specification | Dctx0Review | ImplementationPlan | CodeDiff | Commit | TestReport | BuildReport | DeploymentRecord | MonitoringReport | AlertRecord | IncidentRecord | Document
  type ArtifactState = Available | Superseded | Invalidated
  type ArtifactProducerKind = Human | Agent | Automation | ExternalSystem
  type ArtifactRelationKind = DerivedFrom | Implements | Verifies | Deploys | Observes | TriggeredBy | Supersedes | ForkedFrom

  failure WorkArtifactNotFound { artifactId: WorkArtifactId }
  failure ArtifactRelationNotFound { relationId: ArtifactRelationId }
  failure ArtifactAccessDenied { actorId: ArtifactActorId }
  failure ArtifactRegistrationRejected { reason: String }
  failure ArtifactRelationRejected { reason: String }
  failure ArtifactStateRejected { reason: String }
  failure ArtifactLedgerUnavailable { reason: String }

  entity WorkArtifact {
    id: WorkArtifactId
    workstreamId: ArtifactWorkstreamId
    kind: WorkArtifactKind
    version: ArtifactVersion
    state: ArtifactState
    title: String
    contentHash: ArtifactContentHash
    contentReference: ArtifactContentReference
    producerKind: ArtifactProducerKind
    producerId: ArtifactProducerId
    sourceMessageId: Option<ArtifactMessageId>
    sourceRunId: Option<ArtifactRunId>
    createdAt: Timestamp
    key id
  }

  entity ArtifactRelation {
    id: ArtifactRelationId
    workstreamId: ArtifactWorkstreamId
    sourceArtifactId: WorkArtifactId
    targetArtifactId: WorkArtifactId
    kind: ArtifactRelationKind
    rationale: String
    createdBy: ArtifactActorId
    createdAt: Timestamp
    key id
  }

  message RegisterWorkArtifact {
    artifactId: WorkArtifactId
    workstreamId: ArtifactWorkstreamId
    kind: WorkArtifactKind
    version: ArtifactVersion
    title: String
    contentHash: ArtifactContentHash
    contentReference: ArtifactContentReference
    producerKind: ArtifactProducerKind
    producerId: ArtifactProducerId
    sourceMessageId: Option<ArtifactMessageId>
    sourceRunId: Option<ArtifactRunId>
    actorId: ArtifactActorId
    occurredAt: Timestamp
  }
  message RelateWorkArtifacts {
    relationId: ArtifactRelationId
    workstreamId: ArtifactWorkstreamId
    sourceArtifactId: WorkArtifactId
    targetArtifactId: WorkArtifactId
    kind: ArtifactRelationKind
    rationale: String
    actorId: ArtifactActorId
    occurredAt: Timestamp
  }
  message SupersedeWorkArtifact {
    relationId: ArtifactRelationId
    workstreamId: ArtifactWorkstreamId
    currentArtifactId: WorkArtifactId
    replacementArtifactId: WorkArtifactId
    actorId: ArtifactActorId
    rationale: String
    occurredAt: Timestamp
  }
  message InvalidateWorkArtifact {
    artifactId: WorkArtifactId
    actorId: ArtifactActorId
    reason: String
    occurredAt: Timestamp
  }
  message WorkArtifactView {
    id: WorkArtifactId
    workstreamId: ArtifactWorkstreamId
    kind: WorkArtifactKind
    version: ArtifactVersion
    state: ArtifactState
    title: String
    contentHash: ArtifactContentHash
    contentReference: ArtifactContentReference
    producerKind: ArtifactProducerKind
    producerId: ArtifactProducerId
    sourceMessageId: Option<ArtifactMessageId>
    sourceRunId: Option<ArtifactRunId>
    createdAt: Timestamp
  }
  type ArtifactPayload = Ticket(TicketDefinitionView) | Decision(ArtifactContentReference) | Dctx0Specification(ArtifactContentReference) | Dctx0Review(ArtifactContentReference) | ImplementationPlan(ArtifactContentReference) | CodeDiff(ArtifactContentReference) | Commit(ArtifactContentReference) | TestReport(ArtifactContentReference) | BuildReport(ArtifactContentReference) | DeploymentRecord(ArtifactContentReference) | MonitoringReport(ArtifactContentReference) | AlertRecord(ArtifactContentReference) | IncidentRecord(ArtifactContentReference) | Document(ArtifactContentReference)
  message ArtifactEntry {
    artifact: WorkArtifactView
    content: ArtifactPayload
  }

  message ArtifactGraph {
    workstreamId: ArtifactWorkstreamId
    artifacts: List<WorkArtifactView>
    relations: List<ArtifactRelation>
  }
  message ArtifactTimeline {
    workstreamId: ArtifactWorkstreamId
    artifacts: List<WorkArtifactView>
  }

  event WorkArtifactRegistered { artifactId: WorkArtifactId; workstreamId: ArtifactWorkstreamId; kind: WorkArtifactKind }
  event WorkArtifactsRelated { relationId: ArtifactRelationId; sourceArtifactId: WorkArtifactId; targetArtifactId: WorkArtifactId; kind: ArtifactRelationKind }
  event WorkArtifactSuperseded { currentArtifactId: WorkArtifactId; replacementArtifactId: WorkArtifactId }
  event WorkArtifactInvalidated { artifactId: WorkArtifactId; reason: String }


  value TicketId = UUID
  value TicketRevisionId = UUID
  value TicketWorkstreamId = UUID
  value TicketActorId = UUID
  value TicketMessageId = UUID
  value RevisionNumber = Int { range 1..1000000 }

  type TicketKind = Bug | Change | Task | Investigation | Decision
  type TicketPriority = Critical | High | Normal | Low
  type TicketDefinitionState = Draft | Complete | Reviewed | Stale
  type TicketReadinessState = NeedsClarification | ReadyForImplementation | Blocked
  type TicketReviewVerdict = Approved | ChangesRequested
  type TicketAutomationMode = ObserveOnly | TriageAutomatically | PrepareImplementation | ImplementWithApproval | ImplementAutomatically

  failure TicketNotFound { ticketId: TicketId }
  failure TicketRevisionNotFound { revisionId: TicketRevisionId }
  failure TicketAccessDenied { actorId: TicketActorId }
  failure TicketDefinitionRejected { reason: String }
  failure TicketReviewRejected { reason: String }
  failure TicketReadinessRejected { reason: String }
  failure TicketPersistenceUnavailable { reason: String }

  entity Ticket {
    id: TicketId
    workstreamId: TicketWorkstreamId
    kind: TicketKind
    priority: TicketPriority
    definitionState: TicketDefinitionState
    readiness: TicketReadinessState
    automationMode: TicketAutomationMode
    currentRevisionId: TicketRevisionId
    openedBy: TicketActorId
    createdAt: Timestamp
    updatedAt: Timestamp
    key id
  }

  entity TicketRevision {
    id: TicketRevisionId
    ticketId: TicketId
    artifactId: WorkArtifactId
    number: RevisionNumber
    problem: String
    desiredOutcome: String
    acceptanceCriteria: List<String>
    boundaryConditions: List<String>
    excludedScope: List<String>
    affectedAreas: List<String>
    openQuestions: List<String>
    sourceMessageIds: List<TicketMessageId>
    formalSpecificationArtifactId: Option<WorkArtifactId>
    createdBy: TicketActorId
    createdAt: Timestamp
    key id
  }

  message CreateTicket {
    ticketId: TicketId
    revisionId: TicketRevisionId
    artifactId: WorkArtifactId
    workstreamId: TicketWorkstreamId
    actorId: TicketActorId
    kind: TicketKind
    priority: TicketPriority
    automationMode: TicketAutomationMode
    problem: String
    desiredOutcome: String
    acceptanceCriteria: List<String>
    boundaryConditions: List<String>
    excludedScope: List<String>
    affectedAreas: List<String>
    openQuestions: List<String>
    sourceMessageIds: List<TicketMessageId>
    occurredAt: Timestamp
  }
  message ReviseTicket {
    ticketId: TicketId
    revisionId: TicketRevisionId
    artifactId: WorkArtifactId
    expectedCurrentRevisionId: TicketRevisionId
    actorId: TicketActorId
    problem: String
    desiredOutcome: String
    acceptanceCriteria: List<String>
    boundaryConditions: List<String>
    excludedScope: List<String>
    affectedAreas: List<String>
    openQuestions: List<String>
    sourceMessageIds: List<TicketMessageId>
    formalSpecificationArtifactId: Option<WorkArtifactId>
    occurredAt: Timestamp
  }
  message ReviewTicket {
    ticketId: TicketId
    revisionId: TicketRevisionId
    reviewerId: TicketActorId
    verdict: TicketReviewVerdict
    findings: List<String>
    evidenceArtifactIds: List<WorkArtifactId>
    occurredAt: Timestamp
  }
  message MarkTicketStale {
    ticketId: TicketId
    actorId: TicketActorId
    reason: String
    sourceMessageIds: List<TicketMessageId>
    occurredAt: Timestamp
  }
  message ChangeTicketAutomation {
    ticketId: TicketId
    actorId: TicketActorId
    automationMode: TicketAutomationMode
    reason: String
    occurredAt: Timestamp
  }
  message AssessTicketReadiness {
    ticketId: TicketId
    revisionId: TicketRevisionId
    actorId: TicketActorId
    dependenciesSatisfied: Boolean
    requiredReviewsSatisfied: Boolean
    formalSpecificationCurrent: Boolean
    blockingEvidenceArtifactIds: List<WorkArtifactId>
    occurredAt: Timestamp
  }
  message TicketView {
    id: TicketId
    workstreamId: TicketWorkstreamId
    kind: TicketKind
    priority: TicketPriority
    definitionState: TicketDefinitionState
    readiness: TicketReadinessState
    automationMode: TicketAutomationMode
    currentRevisionId: TicketRevisionId
  }
  message TicketDefinitionView {
    ticket: TicketView
    revision: TicketRevision
  }
  message TicketReadiness {
    ticketId: TicketId
    revisionId: TicketRevisionId
    state: TicketReadinessState
    reasons: List<String>
    evidenceArtifactIds: List<WorkArtifactId>
  }

  event TicketCreated { ticketId: TicketId; workstreamId: TicketWorkstreamId; revisionId: TicketRevisionId }
  event TicketRevised { ticketId: TicketId; revisionId: TicketRevisionId; artifactId: WorkArtifactId }
  event TicketReviewed { ticketId: TicketId; revisionId: TicketRevisionId; verdict: TicketReviewVerdict }
  event TicketBecameStale { ticketId: TicketId; revisionId: TicketRevisionId }
  event TicketReadinessChanged { ticketId: TicketId; revisionId: TicketRevisionId; readiness: TicketReadinessState }
  event TicketAutomationChanged { ticketId: TicketId; automationMode: TicketAutomationMode }


  module ArtifactLineage {
    intent """
      Preserve every formal definition, implementation result, verification,
      deployment, and production signal as an immutable workstream artifact and
      make the provenance between them navigable as both graph and timeline.
      """

    decision EvidenceIsVersionedAndRelated {
      choose "Store immutable artifact versions and explicit typed relations instead of replacing attachments in place."
      because "A team must be able to prove which definition produced which run, diff, test, deployment, observation, and alert."
      avoid "Do not infer provenance later from filenames, timestamps, current links, or mutable external pages."
    }
    decision ContentStaysBehindAReference {
      choose "Keep stable content hashes and access-controlled references in the ledger while specialized stores own large or sensitive payloads."
      because "Code, logs, recordings, and reports have different storage, retention, and secrecy requirements."
      avoid "Do not copy every payload into chat messages or expose an external reference without workstream authorization."
    }

    owns {
      value WorkArtifactId value ArtifactRelationId value ArtifactWorkstreamId value ArtifactActorId
      value ArtifactMessageId value ArtifactRunId value ArtifactProducerId value ArtifactVersion
      value ArtifactContentHash value ArtifactContentReference
      entity WorkArtifact entity ArtifactRelation entity Ticket entity TicketRevision
      value TicketId value TicketRevisionId value TicketWorkstreamId value TicketActorId value TicketMessageId value RevisionNumber
      event TicketCreated event TicketRevised event TicketReviewed event TicketBecameStale event TicketReadinessChanged event TicketAutomationChanged
      event WorkArtifactRegistered event WorkArtifactsRelated event WorkArtifactSuperseded event WorkArtifactInvalidated
    }

    requires { WorkArtifactRepository ArtifactContentGateway ArtifactDetailsRead TicketRepository TicketArtifactPersistence }

    port TicketArtifactPersistence {
      operation record(definition: TicketDefinitionView, supersedesArtifactId: Option<WorkArtifactId>)
        -> Unit
        ! TicketPersistenceUnavailable
      effects { write WorkArtifact write ArtifactRelation }
    }

    port ArtifactDetailsRead {
      operation inspect(artifactId: WorkArtifactId, actorId: ArtifactActorId)
        -> ArtifactEntry
        ! WorkArtifactNotFound ! ArtifactAccessDenied ! ArtifactLedgerUnavailable
      effects { read WorkArtifact read Ticket read TicketRevision }
    }

    port WorkArtifactRepository {
      operation register(request: RegisterWorkArtifact)
        -> WorkArtifactView
        ! ArtifactAccessDenied ! ArtifactRegistrationRejected ! ArtifactLedgerUnavailable {
        state upserts WorkArtifact from WorkArtifact {
          id = request.artifactId
          workstreamId = request.workstreamId
          kind = request.kind
          version = request.version
          state = result.state
          title = request.title
          contentHash = request.contentHash
          contentReference = request.contentReference
          producerKind = request.producerKind
          producerId = request.producerId
          sourceMessageId = request.sourceMessageId
          sourceRunId = request.sourceRunId
          createdAt = request.occurredAt
        }
        ensures success implies result == WorkArtifactView {
          id = after.WorkArtifact(request.artifactId).id
          workstreamId = after.WorkArtifact(request.artifactId).workstreamId
          kind = after.WorkArtifact(request.artifactId).kind
          version = after.WorkArtifact(request.artifactId).version
          state = after.WorkArtifact(request.artifactId).state
          title = after.WorkArtifact(request.artifactId).title
          contentHash = after.WorkArtifact(request.artifactId).contentHash
          contentReference = after.WorkArtifact(request.artifactId).contentReference
          producerKind = after.WorkArtifact(request.artifactId).producerKind
          producerId = after.WorkArtifact(request.artifactId).producerId
          sourceMessageId = after.WorkArtifact(request.artifactId).sourceMessageId
          sourceRunId = after.WorkArtifact(request.artifactId).sourceRunId
          createdAt = after.WorkArtifact(request.artifactId).createdAt
        }
        ensures success and creates WorkArtifact(request.artifactId) implies result.state == Available
        ensures success and not creates WorkArtifact(request.artifactId) implies preserves WorkArtifact(request.artifactId)
        ensures not success implies before.WorkArtifact == after.WorkArtifact
        effects { write WorkArtifact }
      }
      operation relate(request: RelateWorkArtifacts)
        -> ArtifactRelation
        ! WorkArtifactNotFound ! ArtifactAccessDenied ! ArtifactRelationRejected ! ArtifactLedgerUnavailable {
        state observes WorkArtifact by request.sourceArtifactId
        state upserts ArtifactRelation from ArtifactRelation {
          id = request.relationId
          workstreamId = request.workstreamId
          sourceArtifactId = request.sourceArtifactId
          targetArtifactId = request.targetArtifactId
          kind = request.kind
          rationale = request.rationale
          createdBy = request.actorId
          createdAt = request.occurredAt
        }
        ensures success implies result == after.ArtifactRelation(request.relationId)
        ensures before.WorkArtifact == after.WorkArtifact
        ensures not success implies before.ArtifactRelation == after.ArtifactRelation
        effects { read WorkArtifact write ArtifactRelation }
      }
      operation supersede(request: SupersedeWorkArtifact)
        -> WorkArtifactView
        ! WorkArtifactNotFound ! ArtifactAccessDenied ! ArtifactRelationRejected ! ArtifactStateRejected ! ArtifactLedgerUnavailable {
        state replaces WorkArtifact by request.currentArtifactId from WorkArtifact {
          id = self.id
          workstreamId = self.workstreamId
          kind = self.kind
          version = self.version
          state = Superseded
          title = self.title
          contentHash = self.contentHash
          contentReference = self.contentReference
          producerKind = self.producerKind
          producerId = self.producerId
          sourceMessageId = self.sourceMessageId
          sourceRunId = self.sourceRunId
          createdAt = self.createdAt
        }
        state upserts ArtifactRelation from ArtifactRelation {
          id = request.relationId
          workstreamId = request.workstreamId
          sourceArtifactId = request.replacementArtifactId
          targetArtifactId = request.currentArtifactId
          kind = Supersedes
          rationale = request.rationale
          createdBy = request.actorId
          createdAt = request.occurredAt
        }
        ensures success implies result == WorkArtifactView {
          id = before.WorkArtifact(request.replacementArtifactId).id
          workstreamId = before.WorkArtifact(request.replacementArtifactId).workstreamId
          kind = before.WorkArtifact(request.replacementArtifactId).kind
          version = before.WorkArtifact(request.replacementArtifactId).version
          state = before.WorkArtifact(request.replacementArtifactId).state
          title = before.WorkArtifact(request.replacementArtifactId).title
          contentHash = before.WorkArtifact(request.replacementArtifactId).contentHash
          contentReference = before.WorkArtifact(request.replacementArtifactId).contentReference
          producerKind = before.WorkArtifact(request.replacementArtifactId).producerKind
          producerId = before.WorkArtifact(request.replacementArtifactId).producerId
          sourceMessageId = before.WorkArtifact(request.replacementArtifactId).sourceMessageId
          sourceRunId = before.WorkArtifact(request.replacementArtifactId).sourceRunId
          createdAt = before.WorkArtifact(request.replacementArtifactId).createdAt
        }
        effects { write WorkArtifact write ArtifactRelation }
      }
      operation invalidate(request: InvalidateWorkArtifact)
        -> WorkArtifactView
        ! WorkArtifactNotFound ! ArtifactAccessDenied ! ArtifactStateRejected ! ArtifactLedgerUnavailable {
        state replaces WorkArtifact by request.artifactId from WorkArtifact {
          id = self.id
          workstreamId = self.workstreamId
          kind = self.kind
          version = self.version
          state = Invalidated
          title = self.title
          contentHash = self.contentHash
          contentReference = self.contentReference
          producerKind = self.producerKind
          producerId = self.producerId
          sourceMessageId = self.sourceMessageId
          sourceRunId = self.sourceRunId
          createdAt = self.createdAt
        }
        ensures success implies result == WorkArtifactView {
          id = after.WorkArtifact(request.artifactId).id
          workstreamId = after.WorkArtifact(request.artifactId).workstreamId
          kind = after.WorkArtifact(request.artifactId).kind
          version = after.WorkArtifact(request.artifactId).version
          state = after.WorkArtifact(request.artifactId).state
          title = after.WorkArtifact(request.artifactId).title
          contentHash = after.WorkArtifact(request.artifactId).contentHash
          contentReference = after.WorkArtifact(request.artifactId).contentReference
          producerKind = after.WorkArtifact(request.artifactId).producerKind
          producerId = after.WorkArtifact(request.artifactId).producerId
          sourceMessageId = after.WorkArtifact(request.artifactId).sourceMessageId
          sourceRunId = after.WorkArtifact(request.artifactId).sourceRunId
          createdAt = after.WorkArtifact(request.artifactId).createdAt
        }
        ensures failure is ArtifactAccessDenied implies preserves WorkArtifact(request.artifactId)
        ensures failure is ArtifactStateRejected implies preserves WorkArtifact(request.artifactId)
        effects { write WorkArtifact }
      }
      operation inspect(artifactId: WorkArtifactId, actorId: ArtifactActorId)
        -> WorkArtifactView
        ! WorkArtifactNotFound ! ArtifactAccessDenied ! ArtifactLedgerUnavailable {
        state observes WorkArtifact by artifactId
        ensures success implies result == WorkArtifactView {
          id = after.WorkArtifact(artifactId).id
          workstreamId = after.WorkArtifact(artifactId).workstreamId
          kind = after.WorkArtifact(artifactId).kind
          version = after.WorkArtifact(artifactId).version
          state = after.WorkArtifact(artifactId).state
          title = after.WorkArtifact(artifactId).title
          contentHash = after.WorkArtifact(artifactId).contentHash
          contentReference = after.WorkArtifact(artifactId).contentReference
          producerKind = after.WorkArtifact(artifactId).producerKind
          producerId = after.WorkArtifact(artifactId).producerId
          sourceMessageId = after.WorkArtifact(artifactId).sourceMessageId
          sourceRunId = after.WorkArtifact(artifactId).sourceRunId
          createdAt = after.WorkArtifact(artifactId).createdAt
        }
        ensures not success implies before.WorkArtifact == after.WorkArtifact
        effects { read WorkArtifact }
      }

      operation graph(workstreamId: ArtifactWorkstreamId, actorId: ArtifactActorId)
        -> ArtifactGraph
        ! ArtifactAccessDenied ! ArtifactLedgerUnavailable {
        state lists WorkArtifact
        state lists ArtifactRelation
        ensures before.WorkArtifact == after.WorkArtifact
        ensures before.ArtifactRelation == after.ArtifactRelation
        effects { read WorkArtifact read ArtifactRelation }
      }
      operation timeline(workstreamId: ArtifactWorkstreamId, actorId: ArtifactActorId)
        -> ArtifactTimeline
        ! ArtifactAccessDenied ! ArtifactLedgerUnavailable {
        state lists WorkArtifact
        ensures before.WorkArtifact == after.WorkArtifact
        effects { read WorkArtifact }
      }
    }

    port ArtifactContentGateway {
      operation assertAvailable(contentReference: ArtifactContentReference, contentHash: ArtifactContentHash, actorId: ArtifactActorId)
        -> Unit
        ! ArtifactAccessDenied ! ArtifactRegistrationRejected
    }

    surface WorkArtifactApi exposes requestReply {
      operation details(artifactId: WorkArtifactId, actorId: ArtifactActorId)
        -> ArtifactEntry
        ! WorkArtifactNotFound ! ArtifactAccessDenied ! ArtifactLedgerUnavailable
      effects { read WorkArtifact read Ticket read TicketRevision call ArtifactDetailsRead.inspect }

      operation register(request: RegisterWorkArtifact)
        -> WorkArtifactView
        ! ArtifactAccessDenied ! ArtifactRegistrationRejected ! ArtifactLedgerUnavailable
      effects { write WorkArtifact call ArtifactContentGateway.assertAvailable call WorkArtifactRepository.register emit WorkArtifactRegistered(artifactId: request.artifactId, workstreamId: request.workstreamId, kind: request.kind) }

      operation relate(request: RelateWorkArtifacts)
        -> ArtifactRelation
        ! WorkArtifactNotFound ! ArtifactAccessDenied ! ArtifactRelationRejected ! ArtifactLedgerUnavailable
      effects { read WorkArtifact write ArtifactRelation call WorkArtifactRepository.relate emit WorkArtifactsRelated(relationId: request.relationId, sourceArtifactId: request.sourceArtifactId, targetArtifactId: request.targetArtifactId, kind: request.kind) }

      operation supersede(request: SupersedeWorkArtifact)
        -> WorkArtifactView
        ! WorkArtifactNotFound ! ArtifactAccessDenied ! ArtifactRelationRejected ! ArtifactStateRejected ! ArtifactLedgerUnavailable
      effects { write WorkArtifact write ArtifactRelation call WorkArtifactRepository.supersede emit WorkArtifactSuperseded(currentArtifactId: request.currentArtifactId, replacementArtifactId: request.replacementArtifactId) }

      operation invalidate(request: InvalidateWorkArtifact)
        -> WorkArtifactView
        ! WorkArtifactNotFound ! ArtifactAccessDenied ! ArtifactStateRejected ! ArtifactLedgerUnavailable
      effects { write WorkArtifact call WorkArtifactRepository.invalidate emit WorkArtifactInvalidated(artifactId: request.artifactId, reason: request.reason) }

      operation inspect(artifactId: WorkArtifactId, actorId: ArtifactActorId)
        -> WorkArtifactView
        ! WorkArtifactNotFound ! ArtifactAccessDenied ! ArtifactLedgerUnavailable
      effects { read WorkArtifact call WorkArtifactRepository.inspect }

      operation graph(workstreamId: ArtifactWorkstreamId, actorId: ArtifactActorId)
        -> ArtifactGraph
        ! ArtifactAccessDenied ! ArtifactLedgerUnavailable
      effects { read WorkArtifact read ArtifactRelation call WorkArtifactRepository.graph }

      operation timeline(workstreamId: ArtifactWorkstreamId, actorId: ArtifactActorId)
        -> ArtifactTimeline
        ! ArtifactAccessDenied ! ArtifactLedgerUnavailable
      effects { read WorkArtifact call WorkArtifactRepository.timeline }
    }

    constraint "Artifacts are the single public work-object collection. Tickets are the Ticket specialization of ArtifactEntry, never a parallel ticket list. The payload variant must match the artifact kind and every Ticket payload identifies the exact persisted revision behind that artifact version. Specialized stores may own ticket state and immutable revision content."
    constraint "Artifact lists show creation date, title and type; opening an artifact resolves its typed detail. Ticket review, readiness, priority and automation are specialization behavior, not generic fields on every artifact."
    constraint "Ticket creation and revision atomically commit their specialized state, immutable revision and common artifact metadata. Revisions supersede the earlier artifact through explicit lineage while preserving its content. Generic artifact registration cannot manufacture a Ticket without its specialized content."
    constraint "An artifact is append-only after registration; title, kind, version, producer, source, content hash, and content reference never change."
    constraint "A new representation is a new artifact version and an explicit Supersedes relation; superseding never deletes the prior version."
    constraint "Invalidation records attributable reason and time, preserves the artifact, and prevents it from satisfying a current readiness or completion gate."
    constraint "Every artifact belongs to exactly one workstream and is readable only through that workstream's access policy."
    constraint "A cross-workstream derivation requires access to both workstreams and an explicit bridge record; an ordinary relation cannot leak a private artifact."
    constraint "Every artifact records a real producer, stable content hash, resolvable content reference, and at least one attributable source when created from chat or an agent run."
    constraint "Artifact relations are directed, typed, attributable, and immutable; retries with the same relation identity are idempotent."
    constraint "Supersedes and ForkedFrom cannot form a cycle, and a self relation is always rejected."
    constraint "Implements points from an implementation result to the exact ticket or specification version it implements."
    constraint "Verifies points from a test, build, or review result to the exact change, implementation, or specification it evaluated."
    constraint "Deploys identifies the exact verified change delivered, while Observes identifies the exact deployment or release observed in production."
    constraint "Artifact registration proves provenance and integrity, not correctness, approval, successful verification, deployment health, or ticket completion."
    constraint "Graph and timeline views expose the same authorized ledger: the graph explains causality and the timeline explains sequence."

    example "native register records the complete artifact" {
      when result = WorkArtifactRepository.register(RegisterWorkArtifact { artifactId = "00000000-0000-4000-8000-000000000081" workstreamId = "00000000-0000-4000-8000-000000000085" kind = Document version = 1 title = "Native document" contentHash = "0123456789abcdef" contentReference = "inline:Native document" producerKind = Human producerId = "00000000-0000-4000-8000-000000000083" sourceMessageId = None sourceRunId = None actorId = "00000000-0000-4000-8000-000000000083" occurredAt = "2026-10-07T10:00:00.000Z" })
      expect result == WorkArtifactView { id = "00000000-0000-4000-8000-000000000081" workstreamId = "00000000-0000-4000-8000-000000000085" kind = Document version = 1 title = "Native document" contentHash = "0123456789abcdef" contentReference = "inline:Native document" producerKind = Human producerId = "00000000-0000-4000-8000-000000000083" sourceMessageId = None sourceRunId = None state = Available createdAt = "2026-10-07T10:00:00.000Z" }
    }
    example "native register retries preserve immutable metadata" {
      when result = WorkArtifactRepository.register(RegisterWorkArtifact { artifactId = "00000000-0000-4000-8000-000000000081" workstreamId = "00000000-0000-4000-8000-000000000085" kind = Document version = 1 title = "Native document" contentHash = "0123456789abcdef" contentReference = "inline:Native document" producerKind = Human producerId = "00000000-0000-4000-8000-000000000083" sourceMessageId = None sourceRunId = None actorId = "00000000-0000-4000-8000-000000000083" occurredAt = "2026-10-07T10:00:00.000Z" })
      expect result == WorkArtifactView { id = "00000000-0000-4000-8000-000000000081" workstreamId = "00000000-0000-4000-8000-000000000085" kind = Document version = 1 title = "Native document" contentHash = "0123456789abcdef" contentReference = "inline:Native document" producerKind = Human producerId = "00000000-0000-4000-8000-000000000083" sourceMessageId = None sourceRunId = None state = Available createdAt = "2026-10-07T10:00:00.000Z" }
    }
