    decision TicketIsALivingContract {
      choose "Represent the ticket as a stable identity whose current definition points to an immutable revision."
      because "Discussion can refine the work without rewriting the basis on which earlier reviews and runs acted."
      avoid "Do not silently edit a reviewed definition or treat the latest chat summary as the historical ticket."
    }
    decision ReadinessRequiresEvidence {
      choose "Assess readiness from the current revision, open questions, dependencies, required reviews, and policy-required formal specification."
      because "A manually selected board column cannot prove that implementation has a stable target."
      avoid "Do not equate a title, assignee, priority, estimate, or agent confidence with ReadyForImplementation."
    }



    port TicketRepository {
      operation create(request: CreateTicket)
        -> TicketDefinitionView
        ! TicketAccessDenied ! TicketDefinitionRejected ! TicketPersistenceUnavailable {
        state inserts Ticket
        state inserts TicketRevision
        state inserts WorkArtifact
        state lists ArtifactRelation
        ensures success and count(ticket in before.Ticket where ticket.id == request.ticketId) == 0 implies after.Ticket(request.ticketId) == Ticket { id = request.ticketId workstreamId = request.workstreamId kind = request.kind priority = request.priority definitionState = Complete readiness = NeedsClarification automationMode = request.automationMode currentRevisionId = request.revisionId openedBy = request.actorId createdAt = request.occurredAt updatedAt = request.occurredAt }
        ensures success and count(ticket in before.Ticket where ticket.id == request.ticketId) == 0 implies after.TicketRevision(request.revisionId) == TicketRevision { id = request.revisionId ticketId = request.ticketId artifactId = request.artifactId number = 1 problem = request.problem desiredOutcome = request.desiredOutcome acceptanceCriteria = request.acceptanceCriteria boundaryConditions = request.boundaryConditions excludedScope = request.excludedScope affectedAreas = request.affectedAreas openQuestions = request.openQuestions sourceMessageIds = request.sourceMessageIds formalSpecificationArtifactId = None() createdBy = request.actorId createdAt = request.occurredAt }
        ensures success and count(ticket in before.Ticket where ticket.id == request.ticketId) == 0 and length(request.sourceMessageIds) == 0 implies after.WorkArtifact(request.artifactId) == WorkArtifact { id = request.artifactId workstreamId = request.workstreamId kind = WorkArtifactKind.Ticket version = 1 state = Available title = request.problem contentHash = after.WorkArtifact(request.artifactId).contentHash contentReference = after.WorkArtifact(request.artifactId).contentReference producerKind = Human producerId = request.actorId sourceMessageId = None() sourceRunId = None() createdAt = request.occurredAt }
        ensures success implies length(after.WorkArtifact(request.artifactId).contentHash) == 64
        ensures success implies length(after.WorkArtifact(request.artifactId).contentReference) > 0
        ensures success and count(ticket in before.Ticket where ticket.id == request.ticketId) > 0 implies before.Ticket == after.Ticket
        ensures success and count(ticket in before.Ticket where ticket.id == request.ticketId) > 0 implies before.TicketRevision == after.TicketRevision
        ensures success and count(ticket in before.Ticket where ticket.id == request.ticketId) > 0 implies before.WorkArtifact == after.WorkArtifact
        ensures before.ArtifactRelation == after.ArtifactRelation
        ensures success implies result == TicketDefinitionView { ticket = TicketView { id = after.Ticket(request.ticketId).id workstreamId = after.Ticket(request.ticketId).workstreamId kind = after.Ticket(request.ticketId).kind priority = after.Ticket(request.ticketId).priority definitionState = after.Ticket(request.ticketId).definitionState readiness = after.Ticket(request.ticketId).readiness automationMode = after.Ticket(request.ticketId).automationMode currentRevisionId = after.Ticket(request.ticketId).currentRevisionId } revision = after.TicketRevision(request.revisionId) }
        ensures not success implies before.Ticket == after.Ticket and before.TicketRevision == after.TicketRevision and before.WorkArtifact == after.WorkArtifact
        effects { write Ticket write TicketRevision write WorkArtifact write ArtifactRelation call TicketArtifactPersistence.record }
      }
      operation revise(request: ReviseTicket)
        -> TicketDefinitionView
        ! TicketNotFound ! TicketAccessDenied ! TicketDefinitionRejected ! TicketPersistenceUnavailable {
        state replaces Ticket by request.ticketId
        state inserts TicketRevision
        state inserts WorkArtifact
        state replaces WorkArtifact by before.TicketRevision(request.expectedCurrentRevisionId).artifactId
        state inserts ArtifactRelation
        ensures success and count(revision in before.TicketRevision where revision.id == request.revisionId) == 0 implies after.Ticket(request.ticketId) == Ticket { id = before.Ticket(request.ticketId).id workstreamId = before.Ticket(request.ticketId).workstreamId kind = before.Ticket(request.ticketId).kind priority = before.Ticket(request.ticketId).priority automationMode = before.Ticket(request.ticketId).automationMode openedBy = before.Ticket(request.ticketId).openedBy createdAt = before.Ticket(request.ticketId).createdAt definitionState = Complete readiness = NeedsClarification currentRevisionId = request.revisionId updatedAt = request.occurredAt }
        ensures success and count(revision in before.TicketRevision where revision.id == request.revisionId) == 0 implies after.TicketRevision(request.revisionId) == TicketRevision { id = request.revisionId ticketId = request.ticketId artifactId = request.artifactId number = before.TicketRevision(request.expectedCurrentRevisionId).number + 1 problem = request.problem desiredOutcome = request.desiredOutcome acceptanceCriteria = request.acceptanceCriteria boundaryConditions = request.boundaryConditions excludedScope = request.excludedScope affectedAreas = request.affectedAreas openQuestions = request.openQuestions sourceMessageIds = request.sourceMessageIds formalSpecificationArtifactId = request.formalSpecificationArtifactId createdBy = request.actorId createdAt = request.occurredAt }
        ensures success and count(revision in before.TicketRevision where revision.id == request.revisionId) == 0 and length(request.sourceMessageIds) == 0 implies after.WorkArtifact(request.artifactId) == WorkArtifact { id = request.artifactId workstreamId = before.Ticket(request.ticketId).workstreamId kind = WorkArtifactKind.Ticket version = before.TicketRevision(request.expectedCurrentRevisionId).number + 1 state = Available title = request.problem contentHash = after.WorkArtifact(request.artifactId).contentHash contentReference = after.WorkArtifact(request.artifactId).contentReference producerKind = Human producerId = request.actorId sourceMessageId = None() sourceRunId = None() createdAt = request.occurredAt }
        ensures success and count(revision in before.TicketRevision where revision.id == request.revisionId) == 0 implies after.WorkArtifact(before.TicketRevision(request.expectedCurrentRevisionId).artifactId) == WorkArtifact { id = before.WorkArtifact(before.TicketRevision(request.expectedCurrentRevisionId).artifactId).id workstreamId = before.WorkArtifact(before.TicketRevision(request.expectedCurrentRevisionId).artifactId).workstreamId kind = before.WorkArtifact(before.TicketRevision(request.expectedCurrentRevisionId).artifactId).kind version = before.WorkArtifact(before.TicketRevision(request.expectedCurrentRevisionId).artifactId).version title = before.WorkArtifact(before.TicketRevision(request.expectedCurrentRevisionId).artifactId).title contentHash = before.WorkArtifact(before.TicketRevision(request.expectedCurrentRevisionId).artifactId).contentHash contentReference = before.WorkArtifact(before.TicketRevision(request.expectedCurrentRevisionId).artifactId).contentReference producerKind = before.WorkArtifact(before.TicketRevision(request.expectedCurrentRevisionId).artifactId).producerKind producerId = before.WorkArtifact(before.TicketRevision(request.expectedCurrentRevisionId).artifactId).producerId sourceMessageId = before.WorkArtifact(before.TicketRevision(request.expectedCurrentRevisionId).artifactId).sourceMessageId sourceRunId = before.WorkArtifact(before.TicketRevision(request.expectedCurrentRevisionId).artifactId).sourceRunId createdAt = before.WorkArtifact(before.TicketRevision(request.expectedCurrentRevisionId).artifactId).createdAt state = Superseded }
        ensures success and count(revision in before.TicketRevision where revision.id == request.revisionId) == 0 implies after.ArtifactRelation(request.revisionId) == ArtifactRelation { id = request.revisionId workstreamId = before.Ticket(request.ticketId).workstreamId sourceArtifactId = request.artifactId targetArtifactId = before.TicketRevision(request.expectedCurrentRevisionId).artifactId kind = Supersedes rationale = "Ticket definition revised" createdBy = request.actorId createdAt = request.occurredAt }
        ensures success implies length(after.WorkArtifact(request.artifactId).contentHash) == 64
        ensures success implies length(after.WorkArtifact(request.artifactId).contentReference) > 0
        ensures success and count(revision in before.TicketRevision where revision.id == request.revisionId) > 0 implies before.Ticket == after.Ticket
        ensures success and count(revision in before.TicketRevision where revision.id == request.revisionId) > 0 implies before.TicketRevision == after.TicketRevision
        ensures success and count(revision in before.TicketRevision where revision.id == request.revisionId) > 0 implies before.WorkArtifact == after.WorkArtifact
        ensures success and count(revision in before.TicketRevision where revision.id == request.revisionId) > 0 implies before.ArtifactRelation == after.ArtifactRelation
        ensures success implies result == TicketDefinitionView { ticket = TicketView { id = after.Ticket(request.ticketId).id workstreamId = after.Ticket(request.ticketId).workstreamId kind = after.Ticket(request.ticketId).kind priority = after.Ticket(request.ticketId).priority definitionState = after.Ticket(request.ticketId).definitionState readiness = after.Ticket(request.ticketId).readiness automationMode = after.Ticket(request.ticketId).automationMode currentRevisionId = after.Ticket(request.ticketId).currentRevisionId } revision = after.TicketRevision(request.revisionId) }
        ensures not success implies before.Ticket == after.Ticket and before.TicketRevision == after.TicketRevision and before.WorkArtifact == after.WorkArtifact and before.ArtifactRelation == after.ArtifactRelation
        effects { write Ticket write TicketRevision write WorkArtifact write ArtifactRelation call TicketArtifactPersistence.record }
      }
      operation review(request: ReviewTicket)
        -> TicketDefinitionView
        ! TicketNotFound ! TicketRevisionNotFound ! TicketAccessDenied ! TicketReviewRejected ! TicketPersistenceUnavailable {
        state replaces Ticket by request.ticketId
        state observes TicketRevision by request.revisionId
        ensures success and request.verdict == Approved implies after.Ticket(request.ticketId) == Ticket { id = before.Ticket(request.ticketId).id workstreamId = before.Ticket(request.ticketId).workstreamId kind = before.Ticket(request.ticketId).kind priority = before.Ticket(request.ticketId).priority definitionState = Reviewed readiness = NeedsClarification automationMode = before.Ticket(request.ticketId).automationMode currentRevisionId = before.Ticket(request.ticketId).currentRevisionId openedBy = before.Ticket(request.ticketId).openedBy createdAt = before.Ticket(request.ticketId).createdAt updatedAt = request.occurredAt }
        ensures success and request.verdict == ChangesRequested implies after.Ticket(request.ticketId) == Ticket { id = before.Ticket(request.ticketId).id workstreamId = before.Ticket(request.ticketId).workstreamId kind = before.Ticket(request.ticketId).kind priority = before.Ticket(request.ticketId).priority definitionState = Complete readiness = NeedsClarification automationMode = before.Ticket(request.ticketId).automationMode currentRevisionId = before.Ticket(request.ticketId).currentRevisionId openedBy = before.Ticket(request.ticketId).openedBy createdAt = before.Ticket(request.ticketId).createdAt updatedAt = request.occurredAt }
        ensures success implies result == TicketDefinitionView { ticket = TicketView { id = after.Ticket(request.ticketId).id workstreamId = after.Ticket(request.ticketId).workstreamId kind = after.Ticket(request.ticketId).kind priority = after.Ticket(request.ticketId).priority definitionState = after.Ticket(request.ticketId).definitionState readiness = after.Ticket(request.ticketId).readiness automationMode = after.Ticket(request.ticketId).automationMode currentRevisionId = after.Ticket(request.ticketId).currentRevisionId } revision = before.TicketRevision(request.revisionId) }
        ensures before.TicketRevision == after.TicketRevision
        ensures not success implies before.Ticket == after.Ticket
        effects { write Ticket read TicketRevision }
      }
      operation markStale(request: MarkTicketStale)
        -> TicketView
        ! TicketNotFound ! TicketAccessDenied ! TicketDefinitionRejected ! TicketPersistenceUnavailable {
        state replaces Ticket by request.ticketId from Ticket {
          id = self.id
          workstreamId = self.workstreamId
          kind = self.kind
          priority = self.priority
          definitionState = Stale
          readiness = NeedsClarification
          automationMode = self.automationMode
          currentRevisionId = self.currentRevisionId
          openedBy = self.openedBy
          createdAt = self.createdAt
          updatedAt = request.occurredAt
        }
        ensures success implies result == TicketView { id = after.Ticket(request.ticketId).id workstreamId = after.Ticket(request.ticketId).workstreamId kind = after.Ticket(request.ticketId).kind priority = after.Ticket(request.ticketId).priority definitionState = after.Ticket(request.ticketId).definitionState readiness = after.Ticket(request.ticketId).readiness automationMode = after.Ticket(request.ticketId).automationMode currentRevisionId = after.Ticket(request.ticketId).currentRevisionId }
        ensures not success implies before.Ticket == after.Ticket
        effects { write Ticket }
      }
      operation changeAutomation(request: ChangeTicketAutomation)
        -> TicketView
        ! TicketNotFound ! TicketAccessDenied ! TicketDefinitionRejected ! TicketPersistenceUnavailable {
        state replaces Ticket by request.ticketId from Ticket {
          id = self.id
          workstreamId = self.workstreamId
          kind = self.kind
          priority = self.priority
          definitionState = self.definitionState
          readiness = self.readiness
          automationMode = request.automationMode
          currentRevisionId = self.currentRevisionId
          openedBy = self.openedBy
          createdAt = self.createdAt
          updatedAt = request.occurredAt
        }
        ensures success implies result == TicketView { id = after.Ticket(request.ticketId).id workstreamId = after.Ticket(request.ticketId).workstreamId kind = after.Ticket(request.ticketId).kind priority = after.Ticket(request.ticketId).priority definitionState = after.Ticket(request.ticketId).definitionState readiness = after.Ticket(request.ticketId).readiness automationMode = after.Ticket(request.ticketId).automationMode currentRevisionId = after.Ticket(request.ticketId).currentRevisionId }
        ensures not success implies before.Ticket == after.Ticket
        effects { write Ticket }
      }
      operation assessReadiness(request: AssessTicketReadiness)
        -> TicketReadiness
        ! TicketNotFound ! TicketRevisionNotFound ! TicketAccessDenied ! TicketReadinessRejected ! TicketPersistenceUnavailable {
        state observes TicketRevision by request.revisionId
        state replaces Ticket by request.ticketId from Ticket {
          id = self.id
          workstreamId = self.workstreamId
          kind = self.kind
          priority = self.priority
          definitionState = self.definitionState
          readiness = result.state
          automationMode = self.automationMode
          currentRevisionId = self.currentRevisionId
          openedBy = self.openedBy
          createdAt = self.createdAt
          updatedAt = request.occurredAt
        }
        ensures success implies result.ticketId == request.ticketId
        ensures success implies result.revisionId == request.revisionId
        ensures success implies result.state == after.Ticket(request.ticketId).readiness
        ensures success implies result.evidenceArtifactIds == request.blockingEvidenceArtifactIds
        ensures success and count(request.blockingEvidenceArtifactIds) > 0 implies result.state == Blocked
        ensures success and count(request.blockingEvidenceArtifactIds) == 0 implies result.state != Blocked
        ensures success and result.state == NeedsClarification implies count(result.reasons) > 0
        ensures success and result.state == ReadyForImplementation implies result == TicketReadiness { ticketId = request.ticketId revisionId = request.revisionId state = ReadyForImplementation reasons = [] evidenceArtifactIds = [] }
        ensures before.TicketRevision == after.TicketRevision
        ensures not success implies before.Ticket == after.Ticket
        effects { write Ticket read TicketRevision }
      }
      operation inspect(ticketId: TicketId, actorId: TicketActorId)
        -> TicketDefinitionView
        ! TicketNotFound ! TicketAccessDenied ! TicketPersistenceUnavailable {
        state observes Ticket by ticketId
        state lists TicketRevision
        ensures success implies result == TicketDefinitionView {
          ticket = TicketView { id = after.Ticket(ticketId).id workstreamId = after.Ticket(ticketId).workstreamId kind = after.Ticket(ticketId).kind priority = after.Ticket(ticketId).priority definitionState = after.Ticket(ticketId).definitionState readiness = after.Ticket(ticketId).readiness automationMode = after.Ticket(ticketId).automationMode currentRevisionId = after.Ticket(ticketId).currentRevisionId }
          revision = after.TicketRevision(before.Ticket(ticketId).currentRevisionId)
        }
        ensures before.Ticket == after.Ticket
        ensures before.TicketRevision == after.TicketRevision
        effects { read Ticket read TicketRevision }
      }
    }


    surface TicketApi exposes requestReply {
      operation create(request: CreateTicket)
        -> TicketDefinitionView
        ! TicketAccessDenied ! TicketDefinitionRejected ! TicketPersistenceUnavailable
      effects { write Ticket write TicketRevision write WorkArtifact write ArtifactRelation call TicketRepository.create emit TicketCreated(ticketId: request.ticketId, workstreamId: request.workstreamId, revisionId: request.revisionId) }

      operation revise(request: ReviseTicket)
        -> TicketDefinitionView
        ! TicketNotFound ! TicketAccessDenied ! TicketDefinitionRejected ! TicketPersistenceUnavailable
      effects { write Ticket write TicketRevision write WorkArtifact write ArtifactRelation call TicketRepository.revise emit TicketRevised(ticketId: request.ticketId, revisionId: request.revisionId, artifactId: request.artifactId) }

      operation review(request: ReviewTicket)
        -> TicketDefinitionView
        ! TicketNotFound ! TicketRevisionNotFound ! TicketAccessDenied ! TicketReviewRejected ! TicketPersistenceUnavailable
      effects { write Ticket read TicketRevision call TicketRepository.review emit TicketReviewed(ticketId: request.ticketId, revisionId: request.revisionId, verdict: request.verdict) }

      operation markStale(request: MarkTicketStale)
        -> TicketView
        ! TicketNotFound ! TicketAccessDenied ! TicketDefinitionRejected ! TicketPersistenceUnavailable
      effects { write Ticket call TicketRepository.markStale as ticket emit TicketBecameStale(ticketId: ticket.id, revisionId: ticket.currentRevisionId) }

      operation changeAutomation(request: ChangeTicketAutomation)
        -> TicketView
        ! TicketNotFound ! TicketAccessDenied ! TicketDefinitionRejected ! TicketPersistenceUnavailable
      effects { write Ticket call TicketRepository.changeAutomation emit TicketAutomationChanged(ticketId: request.ticketId, automationMode: request.automationMode) }

      operation assessReadiness(request: AssessTicketReadiness)
        -> TicketReadiness
        ! TicketNotFound ! TicketRevisionNotFound ! TicketAccessDenied ! TicketReadinessRejected ! TicketPersistenceUnavailable
      effects { write Ticket read TicketRevision call TicketRepository.assessReadiness as readiness emit TicketReadinessChanged(ticketId: readiness.ticketId, revisionId: readiness.revisionId, readiness: readiness.state) }

      operation inspect(ticketId: TicketId, actorId: TicketActorId)
        -> TicketDefinitionView
        ! TicketNotFound ! TicketAccessDenied ! TicketPersistenceUnavailable
      effects { read Ticket read TicketRevision call TicketRepository.inspect }
    }

    constraint "Ticket and TicketRevision are specialized state and content of Ticket artifacts. The shared artifact ledger owns public artifact identity, version metadata and lineage. Every revision artifact has kind Ticket, matching workstream, title, revision number, immutable content hash and access-controlled ticket-revision content reference."
    constraint "A workstream may exist while its purpose is still discussed, but it has at most one active primary ticket identity."
    constraint "Every ticket revision is immutable, has a strictly increasing revision number, and cites at least one source message or explicit human creation decision."
    constraint "Revision replaces the current definition only when expectedCurrentRevisionId still matches; concurrent revisions fail instead of silently overwriting one another."
    constraint "A reviewed revision remains inspectable after later revision, staleness, rejection, implementation, or closure."
    constraint "ChangesRequested leaves the ticket outside ReadyForImplementation and records findings against the reviewed revision."
    constraint "Approved applies only to the exact current revision; a subsequent revision returns the definition to Complete until reviewed again."
    constraint "A new relevant conversation decision, changed dependency, invalidated evidence, or changed formal specification marks the current reviewed definition Stale until reconciled."
    constraint "ReadyForImplementation requires the current revision to be Reviewed, no blocking open question, satisfied dependencies, satisfied required reviews, and a current valid formal specification when project policy requires one."
    constraint "A ticket without a required DCTX0 artifact may still become ready when its risk and project policy do not require formal specification."
    constraint "Automation mode never grants permissions by itself; actor rights, project policy, risk gates, and tool policy further restrict every automated action."
    constraint "Critical work and protected components cannot use ImplementAutomatically without an explicit policy that names the permitted scope and required rollback evidence."
    constraint "Ticket priority changes ordering and attention only; it does not weaken review, access, readiness, or evidence requirements."
    constraint "Ticket definitions contain no Sprint or StoryPoint field; planning cadence and estimates may be external views but are not work identity or readiness evidence."

