    example "create a versioned ticket and publish its immutable definition artifact" {
      given TicketRepository.create(createTicket) returns TicketDefinitionView { ticket = createdTicket revision = initialRevision }
      when result = TicketApi.create(createTicket)
      expect Success
      expect emits TicketCreated { ticketId = ticketId workstreamId = workstreamId revisionId = revisionId }
    }
    example "revise a ticket through a new immutable revision artifact" {
      given TicketRepository.revise(reviseTicket) returns TicketDefinitionView { ticket = revisedTicket revision = revisedRevision }
      when result = TicketApi.revise(reviseTicket)
      expect Success
      expect emits TicketRevised { ticketId = ticketId revisionId = revisedRevisionId artifactId = revisedArtifactId }
    }
