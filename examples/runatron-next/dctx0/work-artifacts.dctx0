    example "mark a formerly reviewed ticket stale when its basis changed" {
      given TicketRepository.markStale(markTicketStale) returns TicketView { id = ticketId workstreamId = workstreamId kind = Change priority = High definitionState = Stale readiness = NeedsClarification automationMode = ObserveOnly currentRevisionId = revisionId }
      when result = TicketApi.markStale(markTicketStale)
      expect Success
      expect emits TicketBecameStale { ticketId = ticketId revisionId = revisionId }
    }
    example "change automation mode without changing authorization" {
      given TicketRepository.changeAutomation(changeTicketAutomation) returns TicketView { id = ticketId workstreamId = workstreamId kind = Bug priority = High definitionState = Reviewed readiness = ReadyForImplementation automationMode = ImplementWithApproval currentRevisionId = revisionId }
      when result = TicketApi.changeAutomation(changeTicketAutomation)
      expect Success
      expect emits TicketAutomationChanged { ticketId = ticketId automationMode = ImplementWithApproval }
    }
    example "assess a reviewed ticket as ready with current evidence" {
      given TicketRepository.assessReadiness(assessTicketReadiness) returns TicketReadiness { ticketId = ticketId revisionId = revisionId state = ReadyForImplementation reasons = readinessReasons evidenceArtifactIds = readinessArtifacts }
      when result = TicketApi.assessReadiness(assessTicketReadiness)
      expect Success
      expect emits TicketReadinessChanged { ticketId = ticketId revisionId = revisionId readiness = ReadyForImplementation }
    }
    example "reject readiness while required evidence is incomplete" {
      given TicketRepository.assessReadiness(blockedReadinessAssessment) fails TicketReadinessRejected { reason = "required evidence incomplete" }
      when result = TicketApi.assessReadiness(blockedReadinessAssessment)
      expect result fails TicketReadinessRejected
    }
    example "inspect the current ticket definition with its historical revision" {
      given TicketRepository.inspect(ticketId, actorId) returns TicketDefinitionView { ticket = currentTicket revision = currentRevision }
      when result = TicketApi.inspect(ticketId, actorId)
      expect Success
    }
  }
}
