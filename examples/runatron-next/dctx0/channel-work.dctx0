    }

    example "recipient acceptance rejects a revoked personal delegation" {
      given ChannelWorkAuthority.authorizeDelegation(runnerProof, ContinueExecution) fails ChannelWorkDelegationRejected { reason = "recipient delegation revoked" }
      when result = ChannelWorkApi.acceptAgentReply(AcceptChannelAgentReply { proof = runnerProof requestId = requestId rootId = rootId runtimeSessionReference = runtimeSessionReference runtimeSandboxReference = runtimeSandboxReference clientKey = clientKey })
      expect result fails ChannelWorkDelegationRejected
    }
    example "availability requires the recipient's current channel delegation" {
      given ChannelWorkAuthority.authorizeDelegation(runnerProof, ReadContext) fails ChannelWorkAccessDenied { reason = "recipient lost channel access" }
      when result = ChannelWorkApi.pendingAgentReplies(ReadPendingAgentReplies { proof = runnerProof })
      expect result fails ChannelWorkAccessDenied
    }
    example "concurrent agent requests respect the root budget" {
      given AgentReplyAuthority.authorize(replyRequest) returns AuthorizedAgentReply { channelId = channelId requestingRunId = requestingRunId requestingAttemptId = requestingAttemptId requestingAgentId = requestingAgentId requestingPrincipalId = requestingPrincipalId targetAgentId = targetAgentId targetRunId = targetRunId targetAttemptId = targetAttemptId targetHistorySnapshotId = historySnapshotId }
      given AgentReplyCoordinator.request(replyRequest, AuthorizedAgentReply { channelId = channelId requestingRunId = requestingRunId requestingAttemptId = requestingAttemptId requestingAgentId = requestingAgentId requestingPrincipalId = requestingPrincipalId targetAgentId = targetAgentId targetRunId = targetRunId targetAttemptId = targetAttemptId targetHistorySnapshotId = historySnapshotId }) fails AgentReplyBudgetExceeded { rootId = rootId }
      when result = ChannelWorkApi.requestAgentReply(replyRequest)
      expect result fails AgentReplyBudgetExceeded
    }

    example "context reading requires a current human credential" {
      given ChannelWorkAuthority.authenticateHuman(humanCredential) fails ChannelWorkAuthenticationRequired { reason = "current human session required" }
      when result = ChannelWorkApi.context(humanCredential, channelId, cursor)
      expect result fails ChannelWorkAuthenticationRequired
    }
    example "delegation opening requires a current human credential" {
      given ChannelWorkAuthority.authenticateHuman(humanCredential) fails ChannelWorkAuthenticationRequired { reason = "current human session required" }
      when result = ChannelWorkApi.openSession(OpenChannelWorkSession { humanCredential = humanCredential channelId = channelId runnerId = runnerId agentId = agentId localAgentId = localAgentId snapshotId = snapshotId runtimeSessionReference = runtimeSessionReference allowedOperations = allowedOperations permittedToolNames = permittedToolNames permittedSkillNames = permittedSkillNames requestedExpiresAt = requestedExpiresAt clientKey = clientKey })
      expect result fails ChannelWorkAuthenticationRequired
    }
    example "delegation renewal requires a current human credential" {
      given ChannelWorkAuthority.authenticateHuman(humanCredential) fails ChannelWorkAuthenticationRequired { reason = "current human session required" }
      when result = ChannelWorkApi.renewSession(sessionId, RenewChannelWorkSession { humanCredential = humanCredential requestedExpiresAt = requestedExpiresAt clientKey = clientKey })
      expect result fails ChannelWorkAuthenticationRequired
    }
    example "delegation closure requires a current human credential" {
      given ChannelWorkAuthority.authenticateHuman(humanCredential) fails ChannelWorkAuthenticationRequired { reason = "current human session required" }
      when result = ChannelWorkApi.closeSession(sessionId, CloseChannelWorkSession { humanCredential = humanCredential reason = reason })
      expect result fails ChannelWorkAuthenticationRequired
    }
    example "personal agent announcement rejects a different delegation binding" {
      given ChannelWorkAuthority.authorizeDelegation(runnerProof, PublishConversation) fails ChannelWorkDelegationRejected { reason = "runner and delegation binding differs" }
      when result = ChannelWorkApi.publishMessage(PublishChannelWorkMessage { proof = runnerProof body = body clientKey = clientKey })
      expect result fails ChannelWorkDelegationRejected
    }
    example "agent reply resolution checks the target agent authority" {
      given AgentReplyCoordinator.resolve(resolveRequest) fails ChannelWorkAccessDenied { reason = "answer is not authored by the target agent" }
      when result = ChannelWorkApi.resolveAgentReply(resolveRequest)
      expect result fails ChannelWorkAccessDenied
    }
    example "agent reply cancellation checks the requesting execution" {
      given AgentReplyCoordinator.cancel(cancelRequest) fails ChannelWorkAccessDenied { reason = "cancellation belongs to another execution" }
      when result = ChannelWorkApi.cancelAgentReply(cancelRequest)
      expect result fails ChannelWorkAccessDenied
    }

    lifecycle ChannelWorkDelegationLifecycle for ChannelWorkSession using status {
      state Active initial
      state Closed terminal
      transition ChannelWork.ChannelWorkApi.openSession from Active to Active
      transition ChannelWork.ChannelWorkApi.renewSession from Active to Active
      transition ChannelWork.ChannelWorkApi.closeSession from Active to Closed
    }
    lifecycle AgentReplyRequestLifecycle for AgentReplyRequest using status {
      state Open initial
      state Answered terminal
      state Cancelled terminal
      transition ChannelWork.ChannelWorkApi.requestAgentReply from Open to Open
      transition ChannelWork.ChannelWorkApi.resolveAgentReply from Open to Answered
      transition ChannelWork.ChannelWorkApi.cancelAgentReply from Open to Cancelled
    }
  }
}
