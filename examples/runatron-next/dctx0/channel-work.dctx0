    }
    example "personal recipient refuses incomplete source history" {
      when result = AgentReplyCoordinator.accept(AcceptChannelAgentReply { proof = ChannelWorkRunnerProof { sessionId = "00000000-0000-4000-8000-000000000040" credential = "native-recipient-credential" runnerId = "00000000-0000-4000-8000-000000000009" keyId = "00000000-0000-4000-8000-00000000000a" } requestId = "00000000-0000-4000-8000-000000000031" rootId = "00000000-0000-4000-8000-000000000030" runtimeSessionReference = "native-reply-runtime" runtimeSandboxReference = None clientKey = "native-recipient-acceptance" }, ChannelWorkDelegatedAuthority { session = ChannelWorkSession { id = "00000000-0000-4000-8000-000000000040" humanSessionId = "00000000-0000-4000-8000-000000000041" humanPrincipalId = "00000000-0000-4000-8000-000000000014" channelId = "00000000-0000-4000-8000-000000000004" runnerId = "00000000-0000-4000-8000-000000000009" agentId = "00000000-0000-4000-8000-000000000015" agentPrincipalId = "00000000-0000-4000-8000-000000000017" localAgentId = "native-agent" snapshotId = "00000000-0000-4000-8000-000000000016" snapshotVersion = "1" snapshotFingerprint = "native-fingerprint" runtimeSessionReference = "native-recipient-connection" allowedOperations = [ReadContext, ContinueExecution] permittedToolNames = [] permittedSkillNames = [] status = Active createdAt = "2026-10-04T11:50:00.000Z" expiresAt = "2026-10-04T13:00:00.000Z" closedAt = None clientKey = "native-recipient-connection" } acceptedAt = "2026-10-04T12:00:00.000Z" })
      expect result fails ChannelWorkPreconditionFailed
