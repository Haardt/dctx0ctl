    example "native participation remove participations missing" {
      when result = AgentParticipationRepository.removeAllParticipations(RemoveAgentFromConversations { agentId = "00000000-0000-4000-8000-000000000001" actorId = "00000000-0000-4000-8000-000000000002" occurredAt = "2026-10-07T12:00:00.000Z" })
      expect result fails AgentNotFound
    }

    example "real memory recording persists its complete declared value" {
      when result = AgentParticipationRepository.recordMemory(RecordAgentMemory { memoryId = "00000000-0000-4000-8000-000000000015" agentId = "00000000-0000-4000-8000-000000000001" actorId = "00000000-0000-4000-8000-000000000002" scopeKind = Workstream scopeId = "00000000-0000-4000-8000-000000000019" content = "Deploy requires approval" sourceArtifactIds = [] visibility = Participants occurredAt = "2026-10-07T12:00:00.000Z" })
      expect result == AgentMemory { id = "00000000-0000-4000-8000-000000000015" agentId = "00000000-0000-4000-8000-000000000001" scopeKind = Workstream scopeId = "00000000-0000-4000-8000-000000000019" content = "Deploy requires approval" sourceArtifactIds = [] visibility = Participants recordedAt = "2026-10-07T12:00:00.000Z" invalidatedAt = None }
    }
    example "real memory recording rejects empty content without state loss" {
      when result = AgentParticipationRepository.recordMemory(RecordAgentMemory { memoryId = "00000000-0000-4000-8000-000000000015" agentId = "00000000-0000-4000-8000-000000000001" actorId = "00000000-0000-4000-8000-000000000002" scopeKind = Workstream scopeId = "00000000-0000-4000-8000-000000000019" content = "" sourceArtifactIds = [] visibility = Participants occurredAt = "2026-10-07T12:00:00.000Z" })
      expect result fails AgentConfigurationRejected
    }
    example "real memory recording rejects a missing agent" {
      when result = AgentParticipationRepository.recordMemory(RecordAgentMemory { memoryId = "00000000-0000-4000-8000-000000000015" agentId = "00000000-0000-4000-8000-000000000001" actorId = "00000000-0000-4000-8000-000000000002" scopeKind = Workstream scopeId = "00000000-0000-4000-8000-000000000019" content = "Deploy requires approval" sourceArtifactIds = [] visibility = Participants occurredAt = "2026-10-07T12:00:00.000Z" })
      expect result fails AgentNotFound
    }
    example "real participation change rejects an unknown participation" {
      when result = AgentParticipationRepository.changeParticipation(ChangeAgentParticipation { participationId = "00000000-0000-4000-8000-000000000018" actorId = "00000000-0000-4000-8000-000000000002" role = Coder triggerPolicy = Manual autonomyMode = Triage assigned = true ruleIds = [] permittedSkillNames = ["coding"] permittedToolNames = ["read"] occurredAt = "2026-10-07T12:00:00.000Z" })
      expect result fails AgentParticipationNotFound
    }
    example "real participation repository persists the join time" {
      when result = AgentParticipationRepository.join(JoinAgentToConversation { participationId = "00000000-0000-4000-8000-000000000008" agentId = "00000000-0000-4000-8000-000000000001" actorId = "00000000-0000-4000-8000-000000000002" conversationId = "00000000-0000-4000-8000-000000000009" workstreamId = None role = Reviewer triggerPolicy = Manual autonomyMode = Triage assigned = true ruleIds = [] permittedSkillNames = ["review"] permittedToolNames = ["read"] occurredAt = "2026-10-05T10:00:00.000Z" })
      expect result == AgentParticipationView { id = "00000000-0000-4000-8000-000000000008" agentId = "00000000-0000-4000-8000-000000000001" conversationId = "00000000-0000-4000-8000-000000000009" workstreamId = None role = Reviewer triggerPolicy = Manual autonomyMode = Triage assigned = true permittedSkillNames = ["review"] permittedToolNames = ["read"] }
    }
    example "real participation repository rejects empty rules" {
      when result = AgentParticipationRepository.join(JoinAgentToConversation { participationId = "00000000-0000-4000-8000-000000000008" agentId = "00000000-0000-4000-8000-000000000001" actorId = "00000000-0000-4000-8000-000000000002" conversationId = "00000000-0000-4000-8000-000000000009" workstreamId = None role = Reviewer triggerPolicy = RuleBased autonomyMode = Triage assigned = true ruleIds = [] permittedSkillNames = ["review"] permittedToolNames = ["read"] occurredAt = "2026-10-05T10:00:00.000Z" })
      expect result fails AgentConfigurationRejected
    }
    example "real participation repository rejects a missing agent" {
      when result = AgentParticipationRepository.join(JoinAgentToConversation { participationId = "00000000-0000-4000-8000-000000000008" agentId = "00000000-0000-4000-8000-000000000001" actorId = "00000000-0000-4000-8000-000000000002" conversationId = "00000000-0000-4000-8000-000000000009" workstreamId = None role = Reviewer triggerPolicy = Manual autonomyMode = Triage assigned = true ruleIds = [] permittedSkillNames = ["review"] permittedToolNames = ["read"] occurredAt = "2026-10-05T10:00:00.000Z" })
      expect result fails AgentNotFound
    }

    example "record memory with artifact provenance" {
      given AgentParticipationRepository.recordMemory(memoryRequest) returns memory
      when result = AgentApi.recordMemory(memoryRequest)
      expect Success
      expect emits AgentMemoryRecorded { agentId = agentId memoryId = memoryId }
    }
    example "invalidate one memory without rewriting history" {
      given AgentParticipationRepository.invalidateMemory(invalidationRequest) returns Unit
      when result = AgentApi.invalidateMemory(invalidationRequest)
      expect Success
      expect emits AgentMemoryInvalidated { agentId = agentId memoryId = memoryId }
    }
    example "read an authorized agent profile" {
      given AgentParticipationRepository.profile(agentId, actorId) returns profile
      when result = AgentApi.profile(agentId, actorId)
      expect Success
    }
    example "read memory in an authorized scope" {
      given AgentParticipationRepository.memory(agentId, actorId, scopeId) returns memoryView
      when result = AgentApi.memory(agentId, actorId, scopeId)
      expect Success
    }
    example "read durable work history for an agent" {
      given AgentRunHistory.history(agentId, actorId) returns historyView
      when result = AgentApi.history(agentId, actorId)
      expect Success
    }
    example "remove an agent from every conversation participation" {
      given AgentParticipationRepository.removeAllParticipations(removalRequest) returns Unit
      when result = AgentApi.removeAllParticipations(removalRequest)
      expect Success
    }

    constraint "A reported agent creates a distinct non-human principal on first registration; it has no conversation rights until explicitly joined."
    constraint "The product allocates and owns the agent principal identity; a runner cannot supply an existing human principal or gain a human session."
    constraint "An agent profile is identified by runner and runner-local agent ID and tracks the current reported snapshot. An inventory update changes only future dispatches."
    constraint "Snapshot refresh is an internal reaction to an accepted inventory version and uses the validated RunnerAgentLookup reference; caller-provided version or fingerprint cannot replace the trusted values."
    constraint "Only a current inventory agent on an active runner can receive a new run; removed agents retain profile, memory, and history."
    constraint "A participation grants role, trigger, autonomy, skills, and tools for one conversation only and cannot broaden after an inventory update."
    constraint "Effective skills and tools are the intersection of the pinned snapshot, participation, and product policy; runner input cannot expand them."
    constraint "A chat trigger is idempotent by source message ID, source version, and participation and carries immutable source hash, channel, actor, and trigger."
    constraint "A manual delivery has no source message and is idempotent by delivery ID; a chat delivery has a source message ID, version, and hash."
    constraint "EveryHumanMessage applies only to human-authored messages; agent and automation replies never recursively trigger it."
    constraint "Manual participation requires an authorized human request. WorkTask requires a workstream; ChatReply may omit one."
    constraint "Paused and deactivated agents receive no new runs. Existing runs retain their pinned snapshot and origin."
    constraint "Memory remains scoped and attributable; invalidation never rewrites prior runs or messages."
  }
}
