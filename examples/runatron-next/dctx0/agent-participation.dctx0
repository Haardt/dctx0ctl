      given AgentRunQueue.enqueue(AgentRunDispatch { runId = runId kind = ChatReply originKind = ChatMessage agentId = agentId runnerId = runnerId localAgentId = localAgentId snapshotId = snapshotId snapshotVersion = snapshotVersion snapshotFingerprint = snapshotFingerprint participationId = participationId conversationId = conversationId workstreamId = None sourceMessageId = Some(messageId) sourceMessageVersion = Some(messageVersion) sourceMessageHash = Some(messageHash) sourceChannelId = Some(conversationId) trigger = Some("mention") triggeringPrincipalId = principalId instruction = None contextTokenLimit = contextTokenLimit autonomyMode = ObserveOnly permittedSkillNames = [] permittedToolNames = [] }) returns Unit
      when result = AgentApi.triggerFromMessage(messageTrigger)
      expect Success
