      when result = AgentRunRepository.reclaimLocal(ReclaimLocalRunAttempt { runId = "00000000-0000-4000-8000-000000000001" attemptId = "00000000-0000-4000-8000-00000000000b" sourceAttemptId = "00000000-0000-4000-8000-000000000002" leaseId = "00000000-0000-4000-8000-00000000000c" runnerId = "00000000-0000-4000-8000-000000000009" keyId = "00000000-0000-4000-8000-00000000000a" delegationCredential = Some("native-delegation") runtimeSessionReference = "native-parent-runtime" historySnapshotId = "00000000-0000-4000-8000-000000000005" nativeCheckpointId = None runtimeKind = "" runtimeVersion = "" occurredAt = "2026-10-04T17:30:00.000Z" }, RunLocalReclaimHistoryProof { history = RunTurnHistoryProof { runId = "00000000-0000-4000-8000-000000000001" attemptId = "00000000-0000-4000-8000-000000000002" turnId = "00000000-0000-4000-8000-000000000003" channelId = "00000000-0000-4000-8000-000000000004" snapshotId = "00000000-0000-4000-8000-000000000005" throughCursor = 1 confirmedThroughCursor = 1 canonicalHash = "2f9d78cb0325232d74179c6555da4a06fd4c7e6cbe783740611bc674b889ccae" complete = true verifiedAt = "2026-10-04T17:30:00.000Z" } continuation = RunContinuationReference { runId = "00000000-0000-4000-8000-000000000001" attemptId = "00000000-0000-4000-8000-000000000002" historySnapshotId = "00000000-0000-4000-8000-000000000005" summaryId = Some("00000000-0000-4000-8000-000000000007") workspaceArtifactIds = [] } nativeCheckpointReference = None })
