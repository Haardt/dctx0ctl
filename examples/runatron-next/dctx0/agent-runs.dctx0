    lifecycle InteractiveRunPause for AgentRun using status {
      state Queued initial
      state Leased
      state Running
      state Waiting
      state Completed terminal
      transition InspectableRuns.AgentRunApi.claim from Queued to Leased
      transition InspectableRuns.AgentRunApi.progress from Leased to Running
      transition InspectableRuns.AgentRunApi.pause from Running to Waiting
      transition InspectableRuns.AgentRunApi.resume from Waiting to Running
      transition InspectableRuns.AgentRunApi.complete from Running to Completed
    }

    constraint "Every run has exactly one immutable origin matching its kind: a source message with version and hash, a human manual request, a workflow request, or a ChannelSession with its human principal, session, channel and explicit instruction."
    constraint "I02: ChatReply and channel-session WorkTask may omit a workstream. Operations on tickets or workstreams still require their actual identities. Both use the same queue, lease, attempt and result lifecycle."
    constraint "Queueing never requires runner connectivity. Claiming atomically selects one queued run for its owning active runner and retains the queued snapshot version and fingerprint."
    constraint "Claiming also respects the owning runner's reported maximum concurrent runs; an inventory update cannot move a queued run to another runner."
    constraint "Queueing creates a durable availability signal for the owning runner; control requests create durable control signals. Reading signals requires that runner's current credential and returns only its own signals in strictly increasing sequence order after the supplied cursor."
    constraint "Recovering a run creates a new availability signal. A live signal connection is closed when its runner key rotates or the runner is revoked; reconnecting requires fresh authentication."
    constraint "Live signal delivery is only a wake-up hint; reconnecting runners read durable signals by cursor and still claim runs or acknowledge controls through their separate operations."
    constraint "Queue authorization verifies current inventory, participation, product policy, immutable origin, and effective capabilities before the run is stored."
    constraint "At most one unexpired lease exists per attempt. Claim, renewal, progress, and completion are idempotent; reports from expired or superseded leases cannot change state."
    constraint "The first TurnStarted activity starts the leased attempt and records input provenance and history boundary. Waiting marks the run Waiting; Resumed resumes it as Running, preserving its start time."
    example "local reclaim rejects an unauthenticated runner" {
