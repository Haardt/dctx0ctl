        -> SavedRunSummary
        ! RunnerAuthenticationRejected ! AgentRunNotFound ! RunnerLeaseRejected ! RunDelegationRejected ! RunSummaryRequired ! RunHistoryRequired ! InvalidRunTransition ! RunLedgerUnavailable
      effects { read HistorySnapshot read HistoryConfirmedCursor read HistorySection read HistoryContentBatch read AgentRun read RunLease read RunEvent write RunTurn write SavedRunSummary call RunnerAuthorization.assertRunner call RunTurnHistoryVerifier.verifyTurn as history call AgentRunRepository.completeTurn }
      operation publishSummary(request: PublishSavedSummary)
        -> RunSummaryPublication
        ! RunnerAuthenticationRejected ! AgentRunNotFound ! RunnerLeaseRejected ! RunDelegationRejected ! RunSummaryRequired ! InvalidRunTransition ! ChatPublicationUnavailable ! RunLedgerUnavailable
      effects { read AgentRun read SavedRunSummary write RunSummaryPublication call RunnerAuthorization.assertRunner call AgentRunRepository.publishSummary }
      operation pause(request: PauseRun)
