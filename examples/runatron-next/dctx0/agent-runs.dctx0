domain AgentExecution {
  value AgentRunId = UUID
  value RunAttemptId = UUID
  value RunCheckpointId = UUID
  value RunLeaseId = UUID
  value ProviderPermitId = UUID
  value ProviderCallId = UUID
  value RunControlId = UUID
  value RunEventId = UUID
  value RunTurnId = UUID
  value RunSummaryId = UUID
  value AssistantActivityId = UUID
  value ToolExecutionId = UUID
  value RunSequence = Int { range 1..2147483647 }
  value RunActivityBatch = List<RunActivityInput> { length 1..100 }
  value RunActivityPageSize = Int { range 1..100 }
  value RunActivityCursor = Int { range 0..2147483647 }
  value ToolReconciliationId = UUID
  value RunnerSignalId = UUID
  value RunnerSignalSequence = Int { range 1..2147483647 }
  value RunnerSignalLimit = Int { range 1..200 }
  value ExecutionAgentId = UUID
  value ExecutionRunnerId = UUID
  value ExecutionRunnerKeyId = UUID
  value ExecutionActorId = UUID
  value ExecutionParticipationId = UUID
  value ExecutionWorkstreamId = UUID
  value ExecutionConversationId = UUID
  value ExecutionMessageId = UUID
  value ExecutionSnapshotId = UUID
  value ExecutionLocalAgentId = String { length 1..160 }
  value ExecutionAgentVersion = String { length 1..160 }
  value ExecutionAgentFingerprint = String { length 16..256 }
  value ExecutionMessageVersion = String { length 1..160 }
  value ExecutionMessageHash = String { length 16..256 }
  value ExecutionProviderName = String { length 1..120 }
  value ExecutionBoundaryScopeReference = String { length 1..240 }
  value RuntimeSessionReference = String { length 1..240 }
  value RuntimeSandboxReference = String { length 1..240 }
  value RuntimeCheckpointReference = String { length 1..240 }
  value RuntimeSnapshotReference = String { length 1..240 }
  value RunTokenBudget = Int { range 1..2000000 }

  type AgentRunKind = ChatReply | WorkTask
  type RunOriginKind = ChatMessage | ManualRequest | WorkflowRequest | ChannelSession
  type AgentRunStatus = Queued | Leased | Running | Waiting | Completed | Failed | Cancelled
  type ExecutionMode = Autonomous | Interactive
  type RunTurnStatus = TurnRunning | TurnSucceeded | TurnFailed | TurnAborted
  type RunActivityKind = TurnStarted | TurnEnded | AssistantStarted | AssistantTextAppended | AssistantEnded | ToolStarted | ToolSucceeded | ToolFailed | Waiting | Resumed | Warning | CheckpointReferenced
  type RunAttemptStatus = Queued | Running | Paused | Completed | Failed | Rewound | Abandoned
  type CheckpointAnchor = TurnStart | TurnEnd | BeforeTool | Manual
  type RunOutcome = ResponsePublished | ResponseSuppressed | NoResponse | ArtifactsProduced | NoResult | Failure
  type RunnerResultKind = FinalDraft | NoAnswer | Failed
  type ChatPublicationDisposition = Published | SuppressedSourceChanged | SuppressedMembershipLost | NoAnswer | NotApplicable
  type RunControlKind = Cancel | Rewind | Fork
  type RunControlStatus = Requested | Acknowledged | Rejected
  type RunnerSignalKind = RunAvailable | ControlRequested
  type ToolWriteResolution = ConfirmedCompleted | ConfirmedNotRun | Compensated

  failure AgentRunNotFound { runId: AgentRunId }
  failure RunAttemptNotFound { attemptId: RunAttemptId }
  failure RunCheckpointNotFound { checkpointId: RunCheckpointId }
  failure RunInspectionDenied { actorId: ExecutionActorId }
  failure RunActivityAuthenticationRequired { reason: String }
  failure RunnerAuthenticationRejected { runnerId: ExecutionRunnerId }
  failure RunnerLeaseRejected { reason: String }
  failure RunSnapshotUnavailable { snapshotId: ExecutionSnapshotId }
  failure RunQueueDenied { reason: String }
  failure UnconfirmedToolWrite { eventId: RunEventId }
  failure RunEventNotFound { eventId: RunEventId }
  failure InvalidRunTransition { reason: String }
  failure RunControlRejected { reason: String }
  failure ProviderPermitRejected { reason: String }
  failure ChatContextDenied { reason: String }
  failure RunActivityConflict { reason: String }
  failure RunBatchLimitExceeded { reason: String }
  failure RunSummaryRequired { reason: String }
  failure RunHistoryRequired { reason: String }
  failure RunDelegationRejected { reason: String }
  failure RunLedgerUnavailable { reason: String }
  failure ChatPublicationUnavailable { reason: String }

  message ChatMessageOrigin {
    sourceMessageId: ExecutionMessageId
    sourceVersion: ExecutionMessageVersion
    sourceHash: ExecutionMessageHash
    sourceChannelId: ExecutionConversationId
    triggeringPrincipalId: ExecutionActorId
    participationId: ExecutionParticipationId
    trigger: String
  }
  message ManualRunOrigin {
    requestingPrincipalId: ExecutionActorId
    instruction: String
  }
  message WorkflowRunOrigin {
    workflowId: UUID
    workflowStepId: UUID
    requestingPrincipalId: ExecutionActorId
  }
  message ChannelSessionOrigin {
    sessionId: UUID
    humanPrincipalId: PersonId
    channelId: ExecutionConversationId
    instruction: String
    runtimeSessionReference: RuntimeSessionReference
  }
  message RunContinuationReference {
    runId: AgentRunId
    attemptId: RunAttemptId
    historySnapshotId: HistorySnapshotId
    summaryId: Option<RunSummaryId>
    workspaceArtifactIds: List<UUID>
  }
  message RunOrigin {
    kind: RunOriginKind
    chat: Option<ChatMessageOrigin>
    manual: Option<ManualRunOrigin>
    workflow: Option<WorkflowRunOrigin>
    channelSession: Option<ChannelSessionOrigin>
  }
  message DeliveredMessageReference {
    messageId: ExecutionMessageId
    version: ExecutionMessageVersion
    hash: ExecutionMessageHash
  }
  message ChatContextEntry {
    reference: DeliveredMessageReference
    authorId: ExecutionActorId
    content: String
  }
  message ConsumedTicketRevision {
    ticketId: UUID
    revisionId: UUID
    artifactId: UUID
    hash: String
  }
  message ConsumedArtifactVersion {
    artifactId: UUID
    version: String
    hash: String
  }
  message ChatContextDelivery {
    runId: AgentRunId
    attemptId: RunAttemptId
    messages: List<ChatContextEntry>
    omittedMessageIds: List<ExecutionMessageId>
  }
  message ChatPublicationReceipt {
    disposition: ChatPublicationDisposition
    messageId: Option<ExecutionMessageId>
    reason: Option<String>
  }

  entity AgentRun {
    id: AgentRunId
    kind: AgentRunKind
    origin: RunOrigin
    executionMode: ExecutionMode
    continuation: Option<RunContinuationReference>
    agentId: ExecutionAgentId
    runnerId: ExecutionRunnerId
    localAgentId: ExecutionLocalAgentId
    snapshotId: ExecutionSnapshotId
    snapshotVersion: ExecutionAgentVersion
    snapshotFingerprint: ExecutionAgentFingerprint
    conversationId: ExecutionConversationId
    workstreamId: Option<ExecutionWorkstreamId>
    boundaryScopeReference: ExecutionBoundaryScopeReference
    tokenBudget: RunTokenBudget
    permittedSkillNames: List<String>
    permittedToolNames: List<String>
    status: AgentRunStatus
    currentAttemptId: RunAttemptId
    createdAt: Timestamp
    updatedAt: Timestamp
    key id
  }
  entity RunAttempt {
    id: RunAttemptId
    runId: AgentRunId
    agentId: ExecutionAgentId
    agentPrincipalId: ExecutionActorId
    runnerId: ExecutionRunnerId
    localAgentId: ExecutionLocalAgentId
    snapshotId: ExecutionSnapshotId
    snapshotVersion: ExecutionAgentVersion
    snapshotFingerprint: ExecutionAgentFingerprint
    executionMode: ExecutionMode
    humanPrincipalId: Option<PersonId>
    channelWorkSessionId: Option<UUID>
    continuation: Option<RunContinuationReference>
    parentAttemptId: Option<RunAttemptId>
    forkedFromCheckpointId: Option<RunCheckpointId>
    runtimeSessionReference: Option<RuntimeSessionReference>
    runtimeSandboxReference: Option<RuntimeSandboxReference>
    runtimeTraceReference: Option<String>
    status: RunAttemptStatus
    outcome: Option<RunOutcome>
    publication: Option<ChatPublicationReceipt>
    artifactIds: List<UUID>
    startedAt: Option<Timestamp>
    completedAt: Option<Timestamp>
    key id
  }
  entity RunLease {
    id: RunLeaseId
    runId: AgentRunId
    attemptId: RunAttemptId
    runnerId: ExecutionRunnerId
    expiresAt: Timestamp
    releasedAt: Option<Timestamp>
    key id
  }
  entity LocalRunReclaim {
    attemptId: RunAttemptId
    runId: AgentRunId
    sourceAttemptId: RunAttemptId
    leaseId: RunLeaseId
    requestHash: String
    historyCanonicalHash: String
    nativeCheckpointReference: Option<RuntimeCheckpointReference>
    key attemptId
  }
  message RunLocalReclaimResult {
    assignment: RunExecutionAssignment
    reclaim: LocalRunReclaim
  }
  entity ProviderPermit {
    id: ProviderPermitId
    callId: ProviderCallId
    runId: AgentRunId
    attemptId: RunAttemptId
    leaseId: RunLeaseId
    runnerId: ExecutionRunnerId
    provider: ExecutionProviderName
    expiresAt: Timestamp
    releasedAt: Option<Timestamp>
    key id
  }
  entity RunContextRecord {
    runId: AgentRunId
    attemptId: RunAttemptId
    deliveredMessages: List<DeliveredMessageReference>
    omittedMessageIds: List<ExecutionMessageId>
    includedArtifactIds: List<UUID>
    includedMemoryIds: List<UUID>
    includedTicketRevisions: List<ConsumedTicketRevision>
    includedArtifactVersions: List<ConsumedArtifactVersion>
    recordedAt: Timestamp
    key runId attemptId
  }
  entity RunResultPreparation {
    runId: AgentRunId
    attemptId: RunAttemptId
    leaseId: RunLeaseId
    authorAgentId: ExecutionAgentId
    targetChannelId: ExecutionConversationId
    sourceMessageId: Option<ExecutionMessageId>
    sourceMessageVersion: Option<ExecutionMessageVersion>
    sourceMessageHash: Option<ExecutionMessageHash>
    participationId: Option<ExecutionParticipationId>
    preparedAt: Timestamp
    key runId attemptId
  }
  entity RunCheckpoint {
    id: RunCheckpointId
    runId: AgentRunId
    attemptId: RunAttemptId
    runtimeCheckpointReference: RuntimeCheckpointReference
    historySnapshotReference: RuntimeSnapshotReference
    sandboxSnapshotReference: RuntimeSnapshotReference
    sandboxEpochReference: String
    anchor: CheckpointAnchor
    label: Option<String>
    createdAt: Timestamp
    key id
  }
  entity RunControlDecision {
    id: RunControlId
    runId: AgentRunId
    sourceAttemptId: RunAttemptId
    kind: RunControlKind
    status: RunControlStatus
    checkpointId: Option<RunCheckpointId>
    continuationAttemptId: Option<RunAttemptId>
    requestedBy: ExecutionActorId
    reason: String
    acknowledgedAt: Option<Timestamp>
    key id
  }
  entity RunEvent {
    id: RunEventId
    runId: AgentRunId
    attemptId: RunAttemptId
    leaseId: RunLeaseId
    turnId: RunTurnId
    sequence: RunSequence
    kind: RunActivityKind
    assistantMessageId: Option<AssistantActivityId>
    toolExecutionId: Option<ToolExecutionId>
    parentToolExecutionId: Option<ToolExecutionId>
    toolName: Option<String>
    acceptedAt: Timestamp
    summary: String
    writingToolUnconfirmed: Boolean
    occurredAt: Timestamp
    key id
  }
  entity ToolWriteReconciliation {
    id: ToolReconciliationId
    runId: AgentRunId
    attemptId: RunAttemptId
    writingEventId: RunEventId
    resolution: ToolWriteResolution
    actorId: ExecutionActorId
    reason: String
    occurredAt: Timestamp
    key id
  }
  entity RunnerSignal {
    id: RunnerSignalId
    sequence: RunnerSignalSequence
    runnerId: ExecutionRunnerId
    kind: RunnerSignalKind
    runId: AgentRunId
    controlId: Option<RunControlId>
    occurredAt: Timestamp
    key id
  }

  message QueueAgentRun {
    runId: AgentRunId
    attemptId: RunAttemptId
    kind: AgentRunKind
    origin: RunOrigin
    executionMode: ExecutionMode
    continuation: Option<RunContinuationReference>
    agentId: ExecutionAgentId
    runnerId: ExecutionRunnerId
    localAgentId: ExecutionLocalAgentId
    snapshotId: ExecutionSnapshotId
    snapshotVersion: ExecutionAgentVersion
    snapshotFingerprint: ExecutionAgentFingerprint
    conversationId: ExecutionConversationId
    workstreamId: Option<ExecutionWorkstreamId>
    boundaryScopeReference: ExecutionBoundaryScopeReference
    tokenBudget: RunTokenBudget
    permittedSkillNames: List<String>
    permittedToolNames: List<String>
    occurredAt: Timestamp
  }
  message ClaimAgentRun {
    runnerId: ExecutionRunnerId
    keyId: ExecutionRunnerKeyId
    leaseId: RunLeaseId
    occurredAt: Timestamp
  }
  message RunLeaseView {
    leaseId: RunLeaseId
    runId: AgentRunId
    attemptId: RunAttemptId
    runnerId: ExecutionRunnerId
    snapshotId: ExecutionSnapshotId
    expiresAt: Timestamp
  }
  message RenewRunLease {
    runnerId: ExecutionRunnerId
    keyId: ExecutionRunnerKeyId
    delegationCredential: Option<String>
    leaseId: RunLeaseId
    occurredAt: Timestamp
  }
  message RecoverExpiredRun {
    runId: AgentRunId
    expiredLeaseId: RunLeaseId
    continuationAttemptId: RunAttemptId
    occurredAt: Timestamp
  }
  message ReconcileWritingTool {
    reconciliationId: ToolReconciliationId
    runId: AgentRunId
    attemptId: RunAttemptId
    writingEventId: RunEventId
    resolution: ToolWriteResolution
    actorId: ExecutionActorId
    reason: String
    occurredAt: Timestamp
  }
  message ReadRunnerSignals {
    runnerId: ExecutionRunnerId
    keyId: ExecutionRunnerKeyId
    afterSequence: Option<RunnerSignalSequence>
    limit: RunnerSignalLimit
  }
  message RunnerSignals {
    runnerId: ExecutionRunnerId
    signals: List<RunnerSignal>
    lastSequence: Option<RunnerSignalSequence>
  }
  message RunActivityInput {
    eventId: RunEventId
    turnId: RunTurnId
    sequence: RunSequence
    kind: RunActivityKind
    summary: String
    assistantMessageId: Option<AssistantActivityId>
    toolExecutionId: Option<ToolExecutionId>
    parentToolExecutionId: Option<ToolExecutionId>
    toolName: Option<String>
    turnInstruction: Option<String>
    inputOrigin: Option<String>
    historyCursor: Option<Int>
    writingToolUnconfirmed: Boolean
  }
  message RecordRunProgress {
    runId: AgentRunId
    attemptId: RunAttemptId
    leaseId: RunLeaseId
    runnerId: ExecutionRunnerId
    keyId: ExecutionRunnerKeyId
    delegationCredential: Option<String>
    activities: RunActivityBatch
    occurredAt: Timestamp
  }
  message RunProgressReceipt {
    runId: AgentRunId
    attemptId: RunAttemptId
    messageId: ExecutionMessageId
    acceptedThrough: RunSequence
    revision: Int
  }
  entity RunProgressProjection {
    attemptId: RunAttemptId
    runId: AgentRunId
    conversationId: ExecutionConversationId
    messageId: ExecutionMessageId
    acceptedThrough: RunSequence
    projectedThrough: Int
    revision: Int
    tombstonedAt: Option<Timestamp>
    createdAt: Timestamp
    key attemptId
  }
  entity RunTurn {
    id: RunTurnId
    runId: AgentRunId
    attemptId: RunAttemptId
    instruction: String
    inputOrigin: String
    status: RunTurnStatus
    historyStartCursor: Int
    historyEndCursor: Option<Int>
    historySnapshotId: Option<HistorySnapshotId>
    summaryId: Option<RunSummaryId>
    startedAt: Timestamp
    completedAt: Option<Timestamp>
    key id
  }
  message RunSummaryContent {
    completedWork: String
    results: String
    verification: String
    openPoints: String
    artifactIds: List<UUID>
  }
  entity SavedRunSummary {
    id: RunSummaryId
    runId: AgentRunId
    attemptId: RunAttemptId
    turnId: RunTurnId
    historySnapshotId: HistorySnapshotId
    agentId: ExecutionAgentId
    agentPrincipalId: ExecutionActorId
    humanPrincipalId: Option<PersonId>
    content: RunSummaryContent
    createdAt: Timestamp
    key id
  }
  entity RunSummaryPublication {
    summaryId: RunSummaryId
    messageId: ExecutionMessageId
    publishedAt: Timestamp
    key summaryId
  }
  message RunExecutionAssignment {
    lease: RunLeaseView
    run: AgentRun
    attempt: RunAttempt
    instruction: String
    executionMode: ExecutionMode
    effectiveToolNames: List<String>
    effectiveSkillNames: List<String>
    contextManifest: Option<RunContextRecord>
    continuation: Option<RunContinuationReference>
    nativeCheckpointReference: Option<RuntimeCheckpointReference>
    summaryRequired: Boolean
  }
  message CompleteRunTurn {
    runId: AgentRunId
    attemptId: RunAttemptId
    turnId: RunTurnId
    leaseId: RunLeaseId
    runnerId: ExecutionRunnerId
    keyId: ExecutionRunnerKeyId
    delegationCredential: Option<String>
    status: RunTurnStatus
    summaryId: RunSummaryId
    summary: RunSummaryContent
    historySnapshotId: HistorySnapshotId
    historyEndCursor: Int
    occurredAt: Timestamp
  }
  message PublishSavedSummary {
    runId: AgentRunId
    attemptId: RunAttemptId
    summaryId: RunSummaryId
    leaseId: RunLeaseId
    runnerId: ExecutionRunnerId
    keyId: ExecutionRunnerKeyId
    delegationCredential: Option<String>
    occurredAt: Timestamp
  }
  message PauseRun {
    runId: AgentRunId
    attemptId: RunAttemptId
    leaseId: RunLeaseId
    runnerId: ExecutionRunnerId
    keyId: ExecutionRunnerKeyId
    delegationCredential: Option<String>
    historySnapshotId: HistorySnapshotId
    occurredAt: Timestamp
  }
  message ResumeRun {
    runId: AgentRunId
    attemptId: RunAttemptId
    leaseId: RunLeaseId
    runnerId: ExecutionRunnerId
    keyId: ExecutionRunnerKeyId
    delegationCredential: Option<String>
    occurredAt: Timestamp
  }
  message ReclaimLocalRunAttempt {
    runId: AgentRunId
    attemptId: RunAttemptId
    sourceAttemptId: RunAttemptId
    leaseId: RunLeaseId
    runnerId: ExecutionRunnerId
    keyId: ExecutionRunnerKeyId
    delegationCredential: Option<String>
    runtimeSessionReference: RuntimeSessionReference
    historySnapshotId: HistorySnapshotId
    nativeCheckpointId: Option<RunCheckpointId>
    runtimeKind: String
    runtimeVersion: String
    occurredAt: Timestamp
  }
  message RunLocalReclaimHistoryProof {
    history: RunTurnHistoryProof
    continuation: RunContinuationReference
    nativeCheckpointReference: Option<RuntimeCheckpointReference>
  }
  message RenewProviderPermit {
    permitId: ProviderPermitId
    callId: ProviderCallId
    runId: AgentRunId
    attemptId: RunAttemptId
    leaseId: RunLeaseId
    runnerId: ExecutionRunnerId
    keyId: ExecutionRunnerKeyId
    delegationCredential: Option<String>
    occurredAt: Timestamp
  }

  message RequestChatContext {
    runId: AgentRunId
    attemptId: RunAttemptId
    leaseId: RunLeaseId
    runnerId: ExecutionRunnerId
    keyId: ExecutionRunnerKeyId
    delegationCredential: Option<String>
    occurredAt: Timestamp
  }
  message AcquireProviderPermit {
    permitId: ProviderPermitId
    callId: ProviderCallId
    runId: AgentRunId
    attemptId: RunAttemptId
    leaseId: RunLeaseId
    runnerId: ExecutionRunnerId
    keyId: ExecutionRunnerKeyId
    delegationCredential: Option<String>
    provider: ExecutionProviderName
    occurredAt: Timestamp
  }
  message ProviderPermitView {
    permitId: ProviderPermitId
    callId: ProviderCallId
    provider: ExecutionProviderName
    expiresAt: Timestamp
  }
  message ReleaseProviderPermit {
    permitId: ProviderPermitId
    callId: ProviderCallId
    leaseId: RunLeaseId
    runnerId: ExecutionRunnerId
    keyId: ExecutionRunnerKeyId
    delegationCredential: Option<String>
    occurredAt: Timestamp
  }
  message ReportRunResult {
    runId: AgentRunId
    attemptId: RunAttemptId
    leaseId: RunLeaseId
    runnerId: ExecutionRunnerId
    keyId: ExecutionRunnerKeyId
    delegationCredential: Option<String>
    resultKind: RunnerResultKind
    finalAnswerDraft: Option<String>
    failureSummary: Option<String>
    summaryId: Option<RunSummaryId>
    artifactIds: List<UUID>
    occurredAt: Timestamp
  }
  message RunResultReceipt {
    runId: AgentRunId
    attemptId: RunAttemptId
    outcome: RunOutcome
    publication: ChatPublicationReceipt
  }
  message RecordCheckpoint {
    checkpointId: RunCheckpointId
    runId: AgentRunId
    attemptId: RunAttemptId
    leaseId: RunLeaseId
    runnerId: ExecutionRunnerId
    keyId: ExecutionRunnerKeyId
    delegationCredential: Option<String>
    runtimeCheckpointReference: RuntimeCheckpointReference
    historySnapshotReference: RuntimeSnapshotReference
    sandboxSnapshotReference: RuntimeSnapshotReference
    sandboxEpochReference: String
    anchor: CheckpointAnchor
    label: Option<String>
    occurredAt: Timestamp
  }
  message RequestRunControl {
    controlId: RunControlId
    runId: AgentRunId
    sourceAttemptId: RunAttemptId
    kind: RunControlKind
    checkpointId: Option<RunCheckpointId>
    continuationAttemptId: Option<RunAttemptId>
    actorId: ExecutionActorId
    reason: String
    occurredAt: Timestamp
  }
  message AcknowledgeRunControl {
    controlId: RunControlId
    runnerId: ExecutionRunnerId
    keyId: ExecutionRunnerKeyId
    delegationCredential: Option<String>
    accepted: Boolean
    runtimeSessionReference: Option<RuntimeSessionReference>
    runtimeSandboxReference: Option<RuntimeSandboxReference>
    occurredAt: Timestamp
  }
  message AgentRunView {
    id: AgentRunId
    kind: AgentRunKind
    origin: RunOrigin
    agentId: ExecutionAgentId
    runnerId: ExecutionRunnerId
    snapshotId: ExecutionSnapshotId
    conversationId: ExecutionConversationId
    workstreamId: Option<ExecutionWorkstreamId>
    status: AgentRunStatus
    currentAttemptId: RunAttemptId
  }
  message AgentRunInspection {
    run: AgentRun
    attempts: List<RunAttempt>
    leases: List<RunLease>
    checkpoints: List<RunCheckpoint>
    contextRecords: List<RunContextRecord>
    controlDecisions: List<RunControlDecision>
    turns: List<RunTurn>
    summaries: List<SavedRunSummary>
    summaryPublications: List<RunSummaryPublication>
    toolReconciliations: List<ToolWriteReconciliation>
  }
  message RunTurnHistoryProof {
    runId: AgentRunId
    attemptId: RunAttemptId
    turnId: RunTurnId
    snapshotId: HistorySnapshotId
    channelId: ExecutionConversationId
    throughCursor: HistoryCursor
    confirmedThroughCursor: HistoryCursor
    canonicalHash: HistoryHash
    complete: Boolean
    verifiedAt: Timestamp
  }
  message RunActivitiesQuery {
    attemptId: RunAttemptId
    beforeSequence: RunActivityCursor
    afterSequence: RunActivityCursor
    limit: RunActivityPageSize
  }
  message ReadRunActivities {
    sessionCredential: String
    runId: AgentRunId
    attemptId: RunAttemptId
    beforeSequence: RunActivityCursor
    afterSequence: RunActivityCursor
    limit: RunActivityPageSize
  }
  message RunActivitiesPage {
    runId: AgentRunId
    attemptId: RunAttemptId
    events: List<RunEvent>
    nextBeforeSequence: Option<RunSequence>
    nextAfterSequence: Option<RunSequence>
  }
  message AgentRunHistory { workstreamId: ExecutionWorkstreamId; runs: List<AgentRunView> }
  message RunnerConnectivity {
    runnerId: ExecutionRunnerId
    connectedAt: Option<Timestamp>
    lastSeenAt: Option<Timestamp>
  }

  event AgentRunQueued { runId: AgentRunId; attemptId: RunAttemptId; agentId: ExecutionAgentId }
  event AgentRunClaimed { runId: AgentRunId; attemptId: RunAttemptId; leaseId: RunLeaseId }
  event AgentRunRecovered { runId: AgentRunId; attemptId: RunAttemptId }
  event RunProgressRecorded { runId: AgentRunId; attemptId: RunAttemptId; spaceId: ExecutionConversationId; acceptedThrough: RunSequence; revision: Int }
  event ToolWriteReconciled { runId: AgentRunId; attemptId: RunAttemptId; writingEventId: RunEventId }
  event ProviderPermitGranted { permitId: ProviderPermitId; callId: ProviderCallId; provider: ExecutionProviderName }
  event AgentRunCompleted { runId: AgentRunId; attemptId: RunAttemptId; outcome: RunOutcome }
  event RunCheckpointRecorded { runId: AgentRunId; attemptId: RunAttemptId; checkpointId: RunCheckpointId }
  event RunControlRequested { runId: AgentRunId; controlId: RunControlId; kind: RunControlKind }
  event RunControlAcknowledged { runId: AgentRunId; controlId: RunControlId }

  module InspectableRuns {
    intent """
      Own one durable queue and run history for chat replies and work tasks.
      Grant short runner and provider leases, record bounded context and
      results, and retain coding attempts, checkpoints, rewind, and fork.
      """
    decision ARunIsTheQueueJob {
      choose "Represent the queued job and its execution as one durable run with one status lifecycle."
      because "A second job state would disagree with run history during failure or retry."
      avoid "Do not start a runtime directly when a run is enqueued."
    }
    decision ProviderPermitsCountCalls {
      choose "Grant a separate expiring permit for every model call, including calls by delegated agents."
      because "A global provider limit measures simultaneous calls across all runners, not running jobs."
      avoid "Do not treat a run lease as a provider permit."
    }
    decision ProductOwnsChatPublication {
      choose "Let the product choose author, channel, source relation, and at most one final message per attempt."
      because "A runner may provide a draft but cannot publish as a human or redirect its reply."
      avoid "Do not publish partial output as ordinary conversation messages or overwrite permanent summaries."
    }

    owns {
      value AgentRunId value RunAttemptId value RunCheckpointId value RunLeaseId value ProviderPermitId
      value RunTurnId value RunSummaryId value AssistantActivityId value ToolExecutionId value RunSequence value RunActivityBatch value RunActivityPageSize value RunActivityCursor
      value ProviderCallId value RunControlId value RunEventId value ToolReconciliationId value RunnerSignalId
      value RunnerSignalSequence value RunnerSignalLimit value ExecutionAgentId value ExecutionRunnerId
      value ExecutionRunnerKeyId value ExecutionActorId value ExecutionParticipationId value ExecutionWorkstreamId
      value ExecutionConversationId value ExecutionMessageId value ExecutionSnapshotId value ExecutionLocalAgentId
      value ExecutionAgentVersion value ExecutionAgentFingerprint value ExecutionMessageVersion value ExecutionMessageHash
      value ExecutionProviderName value ExecutionBoundaryScopeReference value RuntimeSessionReference
      value RuntimeSandboxReference value RuntimeCheckpointReference value RuntimeSnapshotReference value RunTokenBudget
      entity AgentRun entity RunAttempt entity RunLease entity ProviderPermit entity RunContextRecord
      entity RunResultPreparation entity RunTurn entity SavedRunSummary entity RunSummaryPublication entity RunProgressProjection
      entity RunCheckpoint entity RunControlDecision entity RunEvent entity ToolWriteReconciliation entity RunnerSignal entity LocalRunReclaim
      event AgentRunQueued event AgentRunClaimed event AgentRunRecovered event RunProgressRecorded event ToolWriteReconciled event ProviderPermitGranted
      event AgentRunCompleted event RunCheckpointRecorded event RunControlRequested event RunControlAcknowledged
    }

    requires { AgentRunRepository RunQueueAuthorization RunnerAuthorization ChatContextGateway ChatPublicationGateway RunTurnHistoryVerifier }

    port RunTurnHistoryVerifier {
      operation verifyReclaim(request: ReclaimLocalRunAttempt)
        -> RunLocalReclaimHistoryProof
        ! RunHistoryRequired ! RunLedgerUnavailable {
        state observes HistorySnapshot by request.historySnapshotId
        state observes HistoryConfirmedCursor by (request.runId, request.sourceAttemptId)
        state lists HistorySection where self.runId == request.runId and self.attemptId == request.sourceAttemptId
        state lists HistoryContentBatch where self.runId == request.runId and self.attemptId == request.sourceAttemptId
        ensures success implies result.history.complete
        ensures success implies result.history.runId == request.runId and result.history.attemptId == request.sourceAttemptId
        ensures success implies result.history.snapshotId == request.historySnapshotId
        ensures success implies result.continuation.runId == request.runId and result.continuation.attemptId == request.sourceAttemptId
        ensures success implies result.continuation.historySnapshotId == request.historySnapshotId
        ensures success implies preserves HistorySnapshot(request.historySnapshotId)
        effects { read HistorySnapshot read HistoryConfirmedCursor read HistorySection read HistoryContentBatch read AgentRun read RunAttempt read RunCheckpoint }
      }
      operation verifyTurn(request: CompleteRunTurn)
        -> RunTurnHistoryProof
        ! RunHistoryRequired ! RunLedgerUnavailable {
        state observes HistorySnapshot by request.historySnapshotId
        state observes HistoryConfirmedCursor by (request.runId, request.attemptId)
        state lists HistorySection where self.runId == request.runId and self.attemptId == request.attemptId
        state lists HistoryContentBatch where self.runId == request.runId and self.attemptId == request.attemptId
        ensures success implies exists HistorySnapshot(request.historySnapshotId)
        ensures success implies exists HistoryConfirmedCursor(request.runId, request.attemptId)
        ensures success implies result.runId == before.HistorySnapshot(request.historySnapshotId).runId
        ensures success implies result.attemptId == before.HistorySnapshot(request.historySnapshotId).attemptId
        ensures success implies result.turnId == before.HistorySnapshot(request.historySnapshotId).turnId
        ensures success implies result.snapshotId == before.HistorySnapshot(request.historySnapshotId).id
        ensures success implies result.channelId == before.HistorySnapshot(request.historySnapshotId).channelId
        ensures success implies result.throughCursor == before.HistorySnapshot(request.historySnapshotId).throughCursor
        ensures success implies result.confirmedThroughCursor == before.HistoryConfirmedCursor(request.runId, request.attemptId).cursor
        ensures success implies result.canonicalHash == before.HistorySnapshot(request.historySnapshotId).canonicalHash
        ensures success implies result.complete and before.HistorySnapshot(request.historySnapshotId).completeness == HistoryCompleteness.Complete
        ensures success implies result.runId == request.runId and result.attemptId == request.attemptId
        ensures success implies result.turnId == request.turnId and result.throughCursor == request.historyEndCursor
        ensures success implies result.confirmedThroughCursor >= result.throughCursor
        ensures success implies result.verifiedAt >= before.HistorySnapshot(request.historySnapshotId).sealedAt
        ensures success implies count(before.HistorySnapshot(request.historySnapshotId).sectionIds) == result.throughCursor
        ensures success implies count(distinct(before.HistorySnapshot(request.historySnapshotId).sectionIds)) == count(before.HistorySnapshot(request.historySnapshotId).sectionIds)
        ensures success implies count(section in before.HistorySection where section.runId == request.runId and section.attemptId == request.attemptId and contains(before.HistorySnapshot(request.historySnapshotId).sectionIds, section.id)) == result.throughCursor
        ensures success implies all(section in before.HistorySection where section.runId != request.runId or section.attemptId != request.attemptId or not contains(before.HistorySnapshot(request.historySnapshotId).sectionIds, section.id) or count(other in before.HistorySection where other.runId == request.runId and other.attemptId == request.attemptId and other.sequence == section.sequence and contains(before.HistorySnapshot(request.historySnapshotId).sectionIds, other.id)) == 1)
        ensures success implies all(sectionId in before.HistorySnapshot(request.historySnapshotId).sectionIds where exists HistorySection(sectionId) and before.HistorySection(sectionId).runId == request.runId and before.HistorySection(sectionId).attemptId == request.attemptId and before.HistorySection(sectionId).sequence <= result.throughCursor)
        ensures success implies all(reference in before.HistorySnapshot(request.historySnapshotId).contentReferences where any(batch in before.HistoryContentBatch where batch.runId == request.runId and batch.attemptId == request.attemptId and any(content in batch.contents where content.id == reference.id and content.hash == reference.hash)))
      }
      effects { read HistorySnapshot read HistoryConfirmedCursor read HistorySection read HistoryContentBatch }
      operation verifyPause(request: PauseRun)
        -> RunTurnHistoryProof
        ! RunHistoryRequired ! RunLedgerUnavailable {
        state observes HistorySnapshot by request.historySnapshotId
        state observes HistoryConfirmedCursor by (request.runId, request.attemptId)
        state lists HistorySection where self.runId == request.runId and self.attemptId == request.attemptId
        state lists HistoryContentBatch where self.runId == request.runId and self.attemptId == request.attemptId
        ensures success implies exists HistorySnapshot(request.historySnapshotId)
        ensures success implies exists HistoryConfirmedCursor(request.runId, request.attemptId)
        ensures success implies result.runId == before.HistorySnapshot(request.historySnapshotId).runId
        ensures success implies result.attemptId == before.HistorySnapshot(request.historySnapshotId).attemptId
        ensures success implies result.turnId == before.HistorySnapshot(request.historySnapshotId).turnId
        ensures success implies result.snapshotId == before.HistorySnapshot(request.historySnapshotId).id
        ensures success implies result.channelId == before.HistorySnapshot(request.historySnapshotId).channelId
        ensures success implies result.throughCursor == before.HistorySnapshot(request.historySnapshotId).throughCursor
        ensures success implies result.confirmedThroughCursor == before.HistoryConfirmedCursor(request.runId, request.attemptId).cursor
        ensures success implies result.canonicalHash == before.HistorySnapshot(request.historySnapshotId).canonicalHash
        ensures success implies result.complete and before.HistorySnapshot(request.historySnapshotId).completeness == HistoryCompleteness.Complete
        ensures success implies result.runId == request.runId and result.attemptId == request.attemptId
        ensures success implies result.confirmedThroughCursor >= result.throughCursor
        ensures success implies result.verifiedAt >= before.HistorySnapshot(request.historySnapshotId).sealedAt
        ensures success implies count(before.HistorySnapshot(request.historySnapshotId).sectionIds) == result.throughCursor
        ensures success implies count(distinct(before.HistorySnapshot(request.historySnapshotId).sectionIds)) == count(before.HistorySnapshot(request.historySnapshotId).sectionIds)
        ensures success implies count(section in before.HistorySection where section.runId == request.runId and section.attemptId == request.attemptId and contains(before.HistorySnapshot(request.historySnapshotId).sectionIds, section.id)) == result.throughCursor
        ensures success implies all(section in before.HistorySection where section.runId != request.runId or section.attemptId != request.attemptId or not contains(before.HistorySnapshot(request.historySnapshotId).sectionIds, section.id) or count(other in before.HistorySection where other.runId == request.runId and other.attemptId == request.attemptId and other.sequence == section.sequence and contains(before.HistorySnapshot(request.historySnapshotId).sectionIds, other.id)) == 1)
        ensures success implies all(sectionId in before.HistorySnapshot(request.historySnapshotId).sectionIds where exists HistorySection(sectionId) and before.HistorySection(sectionId).runId == request.runId and before.HistorySection(sectionId).attemptId == request.attemptId and before.HistorySection(sectionId).sequence <= result.throughCursor)
        ensures success implies all(reference in before.HistorySnapshot(request.historySnapshotId).contentReferences where any(batch in before.HistoryContentBatch where batch.runId == request.runId and batch.attemptId == request.attemptId and any(content in batch.contents where content.id == reference.id and content.hash == reference.hash)))
      }
      effects { read HistorySnapshot read HistoryConfirmedCursor read HistorySection read HistoryContentBatch }
    }

    port RunQueueAuthorization {
      operation assertQueue(request: QueueAgentRun)
        -> Unit
        ! RunQueueDenied ! RunSnapshotUnavailable
    }

    port RunnerAuthorization {
      operation assertRunner(runnerId: ExecutionRunnerId, keyId: ExecutionRunnerKeyId)
        -> Unit
        ! RunnerAuthenticationRejected
    }
    example "real runner authorization accepts a current credential" {
      when result = RunnerAuthorization.assertRunner("00000000-0000-4000-8000-0000000000b1", "00000000-0000-4000-8000-0000000000b2")
      expect Success
    }
    example "real runner authorization rejects a mismatched key" {
      when result = RunnerAuthorization.assertRunner("00000000-0000-4000-8000-0000000000b1", "00000000-0000-4000-8000-0000000000b3")
      expect result fails RunnerAuthenticationRejected
    }
    example "real runner authorization rejects an unknown runner" {
      when result = RunnerAuthorization.assertRunner("00000000-0000-4000-8000-0000000000b4", "00000000-0000-4000-8000-0000000000b2")
      expect result fails RunnerAuthenticationRejected
    }

    port ChatContextGateway {
      operation deliver(request: RequestChatContext)
        -> ChatContextDelivery
        ! ChatContextDenied ! RunLedgerUnavailable {
        ensures success implies result.runId == request.runId and result.attemptId == request.attemptId
      }
    }
    example "native chat context delivers the exact bounded source" {
      when result = ChatContextGateway.deliver(RequestChatContext { runId = "00000000-0000-4000-8000-000000000001" attemptId = "00000000-0000-4000-8000-000000000002" leaseId = "00000000-0000-4000-8000-000000000007" runnerId = "00000000-0000-4000-8000-000000000008" keyId = "00000000-0000-4000-8000-000000000009" delegationCredential = None occurredAt = "2026-10-04T12:00:00.000Z" })
      expect result == ChatContextDelivery { runId = "00000000-0000-4000-8000-000000000001" attemptId = "00000000-0000-4000-8000-000000000002" messages = [ChatContextEntry { reference = DeliveredMessageReference { messageId = "00000000-0000-4000-8000-00000000000c" version = "native-message-v12" hash = "native-message-hash-12" } authorId = "00000000-0000-4000-8000-000000000006" content = "Source" }] omittedMessageIds = ["00000000-0000-4000-8000-00000000000a", "00000000-0000-4000-8000-00000000000b"] }
    }
    example "native chat context rejects revoked membership" {
      when result = ChatContextGateway.deliver(RequestChatContext { runId = "00000000-0000-4000-8000-000000000001" attemptId = "00000000-0000-4000-8000-000000000002" leaseId = "00000000-0000-4000-8000-000000000007" runnerId = "00000000-0000-4000-8000-000000000008" keyId = "00000000-0000-4000-8000-000000000009" delegationCredential = None occurredAt = "2026-10-04T12:00:00.000Z" })
      expect result fails ChatContextDenied
    }
    example "native chat context rejects a deleted source" {
      when result = ChatContextGateway.deliver(RequestChatContext { runId = "00000000-0000-4000-8000-000000000001" attemptId = "00000000-0000-4000-8000-000000000002" leaseId = "00000000-0000-4000-8000-000000000007" runnerId = "00000000-0000-4000-8000-000000000008" keyId = "00000000-0000-4000-8000-000000000009" delegationCredential = None occurredAt = "2026-10-04T12:00:00.000Z" })
      expect result fails ChatContextDenied
    }
    example "native chat context rejects an oversized Unicode source" {
      when result = ChatContextGateway.deliver(RequestChatContext { runId = "00000000-0000-4000-8000-000000000001" attemptId = "00000000-0000-4000-8000-000000000002" leaseId = "00000000-0000-4000-8000-000000000007" runnerId = "00000000-0000-4000-8000-000000000008" keyId = "00000000-0000-4000-8000-000000000009" delegationCredential = None occurredAt = "2026-10-04T12:00:00.000Z" })
      expect result fails ChatContextDenied
    }
    example "native chat context rejects a missing immutable run origin" {
      when result = ChatContextGateway.deliver(RequestChatContext { runId = "00000000-0000-4000-8000-000000000001" attemptId = "00000000-0000-4000-8000-000000000002" leaseId = "00000000-0000-4000-8000-000000000007" runnerId = "00000000-0000-4000-8000-000000000008" keyId = "00000000-0000-4000-8000-000000000009" delegationCredential = None occurredAt = "2026-10-04T12:00:00.000Z" })
      expect result fails ChatContextDenied
    }

    port ChatPublicationGateway {
      operation finalize(request: ReportRunResult, preparation: RunResultPreparation)
        -> ChatPublicationReceipt
        ! ChatPublicationUnavailable
    }
    port AgentRunRepository {
      operation completeTurn(request: CompleteRunTurn, history: RunTurnHistoryProof)
        -> SavedRunSummary
        ! AgentRunNotFound ! RunnerLeaseRejected ! RunDelegationRejected ! RunSummaryRequired ! RunHistoryRequired ! InvalidRunTransition ! RunLedgerUnavailable {
        state observes AgentRun by request.runId
        state upserts SavedRunSummary from result
        state replaces RunTurn by request.turnId from RunTurn {
          id = self.id
          runId = self.runId
          attemptId = self.attemptId
          instruction = self.instruction
          inputOrigin = self.inputOrigin
          status = request.status
          historyStartCursor = self.historyStartCursor
          historyEndCursor = Some(request.historyEndCursor)
          historySnapshotId = Some(request.historySnapshotId)
          summaryId = Some(request.summaryId)
          startedAt = self.startedAt
          completedAt = Some(result.createdAt)
        }
        ensures success implies result.id == request.summaryId
        ensures success implies result.runId == request.runId
        ensures success implies result.attemptId == request.attemptId
        ensures success implies result.turnId == request.turnId
        ensures success implies result.historySnapshotId == request.historySnapshotId
        ensures success implies result.content == request.summary
        ensures success implies history.complete
        ensures success implies history.runId == request.runId and history.attemptId == request.attemptId
        ensures success implies history.snapshotId == request.historySnapshotId and history.channelId == before.AgentRun(request.runId).conversationId
        ensures success implies history.turnId == request.turnId and history.throughCursor == request.historyEndCursor
        ensures success implies history.confirmedThroughCursor >= history.throughCursor
        ensures success implies request.status != TurnRunning
        ensures success implies preserves AgentRun(request.runId)
        ensures not success implies before.RunTurn == after.RunTurn and before.SavedRunSummary == after.SavedRunSummary
        effects { read AgentRun read RunLease read RunEvent write RunTurn write SavedRunSummary }
      }
      operation publishSummary(request: PublishSavedSummary)
        -> RunSummaryPublication
        ! AgentRunNotFound ! RunnerLeaseRejected ! RunDelegationRejected ! RunSummaryRequired ! InvalidRunTransition ! ChatPublicationUnavailable ! RunLedgerUnavailable {
        state observes AgentRun by request.runId
        state observes SavedRunSummary by request.summaryId
        state upserts RunSummaryPublication from result
        ensures success implies result.summaryId == request.summaryId
        ensures success implies preserves SavedRunSummary(request.summaryId)
        ensures success implies preserves AgentRun(request.runId)
        ensures not success implies before.RunSummaryPublication == after.RunSummaryPublication
        effects { read AgentRun read SavedRunSummary write RunSummaryPublication }
      }
      operation pause(request: PauseRun, history: RunTurnHistoryProof)
        -> AgentRunView
        ! AgentRunNotFound ! RunnerLeaseRejected ! RunDelegationRejected ! UnconfirmedToolWrite ! RunHistoryRequired ! InvalidRunTransition ! RunLedgerUnavailable {
        state replaces AgentRun by request.runId from AgentRun { id = self.id kind = self.kind origin = self.origin executionMode = self.executionMode continuation = self.continuation agentId = self.agentId runnerId = self.runnerId localAgentId = self.localAgentId snapshotId = self.snapshotId snapshotVersion = self.snapshotVersion snapshotFingerprint = self.snapshotFingerprint conversationId = self.conversationId workstreamId = self.workstreamId boundaryScopeReference = self.boundaryScopeReference tokenBudget = self.tokenBudget permittedSkillNames = self.permittedSkillNames permittedToolNames = self.permittedToolNames status = AgentRunStatus.Waiting currentAttemptId = self.currentAttemptId createdAt = self.createdAt updatedAt = after.AgentRun(request.runId).updatedAt }
        state replaces RunAttempt by request.attemptId from RunAttempt { id = self.id runId = self.runId agentId = self.agentId agentPrincipalId = self.agentPrincipalId runnerId = self.runnerId localAgentId = self.localAgentId snapshotId = self.snapshotId snapshotVersion = self.snapshotVersion snapshotFingerprint = self.snapshotFingerprint executionMode = self.executionMode humanPrincipalId = self.humanPrincipalId channelWorkSessionId = self.channelWorkSessionId continuation = self.continuation parentAttemptId = self.parentAttemptId forkedFromCheckpointId = self.forkedFromCheckpointId runtimeSessionReference = self.runtimeSessionReference runtimeSandboxReference = self.runtimeSandboxReference runtimeTraceReference = self.runtimeTraceReference status = RunAttemptStatus.Paused outcome = self.outcome publication = self.publication artifactIds = self.artifactIds startedAt = self.startedAt completedAt = self.completedAt }
        state replaces RunLease where self.runId == request.runId and self.attemptId == request.attemptId and self.releasedAt == None() and (before.AgentRun(request.runId).status != AgentRunStatus.Waiting or before.RunAttempt(request.attemptId).status != RunAttemptStatus.Paused)
        ensures success implies all(lease in before.RunLease where lease.runId == request.runId and lease.attemptId == request.attemptId and lease.releasedAt == None() and (before.AgentRun(request.runId).status != AgentRunStatus.Waiting or before.RunAttempt(request.attemptId).status != RunAttemptStatus.Paused) implies after.RunLease(lease.id) == RunLease { id = lease.id runId = lease.runId attemptId = lease.attemptId runnerId = lease.runnerId expiresAt = lease.expiresAt releasedAt = after.RunLease(lease.id).releasedAt })
        ensures success implies all(lease in before.RunLease where lease.runId == request.runId and lease.attemptId == request.attemptId and lease.releasedAt == None() and (before.AgentRun(request.runId).status != AgentRunStatus.Waiting or before.RunAttempt(request.attemptId).status != RunAttemptStatus.Paused) implies after.RunLease(lease.id).releasedAt != None())
        ensures success implies all(lease in before.RunLease where lease.runId == request.runId and lease.attemptId == request.attemptId and lease.releasedAt == None() and (before.AgentRun(request.runId).status != AgentRunStatus.Waiting or before.RunAttempt(request.attemptId).status != RunAttemptStatus.Paused) implies after.RunLease(lease.id).releasedAt == Some(after.AgentRun(request.runId).updatedAt))
        state replaces ProviderPermit where self.runId == request.runId and self.attemptId == request.attemptId and self.releasedAt == None() and (before.AgentRun(request.runId).status != AgentRunStatus.Waiting or before.RunAttempt(request.attemptId).status != RunAttemptStatus.Paused)
        ensures success implies all(permit in before.ProviderPermit where permit.runId == request.runId and permit.attemptId == request.attemptId and permit.releasedAt == None() and (before.AgentRun(request.runId).status != AgentRunStatus.Waiting or before.RunAttempt(request.attemptId).status != RunAttemptStatus.Paused) implies after.ProviderPermit(permit.id) == ProviderPermit { id = permit.id callId = permit.callId runId = permit.runId attemptId = permit.attemptId leaseId = permit.leaseId runnerId = permit.runnerId provider = permit.provider expiresAt = permit.expiresAt releasedAt = after.ProviderPermit(permit.id).releasedAt })
        ensures success implies all(permit in before.ProviderPermit where permit.runId == request.runId and permit.attemptId == request.attemptId and permit.releasedAt == None() and (before.AgentRun(request.runId).status != AgentRunStatus.Waiting or before.RunAttempt(request.attemptId).status != RunAttemptStatus.Paused) implies after.ProviderPermit(permit.id).releasedAt != None())
        ensures success implies all(permit in before.ProviderPermit where permit.runId == request.runId and permit.attemptId == request.attemptId and permit.releasedAt == None() and (before.AgentRun(request.runId).status != AgentRunStatus.Waiting or before.RunAttempt(request.attemptId).status != RunAttemptStatus.Paused) implies after.ProviderPermit(permit.id).releasedAt == Some(after.AgentRun(request.runId).updatedAt))
        ensures success implies after.AgentRun(request.runId).updatedAt >= before.AgentRun(request.runId).updatedAt
        ensures success and before.AgentRun(request.runId).status == AgentRunStatus.Waiting and before.RunAttempt(request.attemptId).status == RunAttemptStatus.Paused implies before.AgentRun(request.runId) == after.AgentRun(request.runId)
        ensures success implies result == AgentRunView { id = after.AgentRun(request.runId).id kind = after.AgentRun(request.runId).kind origin = after.AgentRun(request.runId).origin agentId = after.AgentRun(request.runId).agentId runnerId = after.AgentRun(request.runId).runnerId snapshotId = after.AgentRun(request.runId).snapshotId conversationId = after.AgentRun(request.runId).conversationId workstreamId = after.AgentRun(request.runId).workstreamId status = after.AgentRun(request.runId).status currentAttemptId = after.AgentRun(request.runId).currentAttemptId }
        ensures not success implies before.AgentRun == after.AgentRun and before.RunAttempt == after.RunAttempt and before.RunLease == after.RunLease and before.ProviderPermit == after.ProviderPermit and before.RunProgressProjection == after.RunProgressProjection
        state replaces RunProgressProjection where self.runId == request.runId and self.attemptId == request.attemptId and self.tombstonedAt == None() and (before.AgentRun(request.runId).status != AgentRunStatus.Waiting or before.RunAttempt(request.attemptId).status != RunAttemptStatus.Paused) from RunProgressProjection { attemptId = self.attemptId runId = self.runId conversationId = self.conversationId messageId = self.messageId acceptedThrough = self.acceptedThrough projectedThrough = self.projectedThrough revision = self.revision + 1 tombstonedAt = self.tombstonedAt createdAt = self.createdAt }
        state observes RunTurn by history.turnId
        ensures success implies result.id == request.runId and result.currentAttemptId == request.attemptId
        ensures success implies history.complete
        ensures success implies history.runId == request.runId and history.attemptId == request.attemptId
        ensures success implies history.snapshotId == request.historySnapshotId and history.channelId == result.conversationId
        ensures success implies history.confirmedThroughCursor == history.throughCursor
        ensures success implies before.RunTurn(history.turnId).runId == request.runId and before.RunTurn(history.turnId).attemptId == request.attemptId
        ensures success implies before.RunTurn(history.turnId).status != TurnRunning
        ensures success implies before.RunTurn(history.turnId).historySnapshotId == Some(history.snapshotId)
        ensures success implies all(turn in before.RunTurn where turn.runId != request.runId or turn.attemptId != request.attemptId or turn.startedAt <= before.RunTurn(history.turnId).startedAt)
      }
      effects { read AgentRun read RunTurn read RunEvent read ToolWriteReconciliation write AgentRun write RunAttempt write RunLease write ProviderPermit write RunProgressProjection }
      operation resume(request: ResumeRun)
        -> RunExecutionAssignment
        ! AgentRunNotFound ! RunnerLeaseRejected ! RunDelegationRejected ! RunSnapshotUnavailable ! InvalidRunTransition ! RunLedgerUnavailable
      effects { read AgentRun write AgentRun write RunAttempt write RunLease }
      operation reclaimLocal(request: ReclaimLocalRunAttempt, history: RunLocalReclaimHistoryProof)
        -> RunLocalReclaimResult
        ! AgentRunNotFound ! RunnerLeaseRejected ! RunDelegationRejected ! RunHistoryRequired ! UnconfirmedToolWrite ! InvalidRunTransition ! RunLedgerUnavailable {
        state upserts AgentRun from result.assignment.run
        state upserts RunAttempt from result.assignment.attempt
        state upserts RunLease from RunLease { id = result.assignment.lease.leaseId runId = result.assignment.lease.runId attemptId = result.assignment.lease.attemptId runnerId = result.assignment.lease.runnerId expiresAt = result.assignment.lease.expiresAt releasedAt = None() }
        state upserts LocalRunReclaim from result.reclaim
        state replaces RunProgressProjection where self.attemptId == request.attemptId and self.tombstonedAt == None() and not exists LocalRunReclaim(request.attemptId) from RunProgressProjection { attemptId = self.attemptId runId = self.runId conversationId = self.conversationId messageId = self.messageId acceptedThrough = self.acceptedThrough projectedThrough = self.projectedThrough revision = self.revision + 1 tombstonedAt = self.tombstonedAt createdAt = self.createdAt }
        ensures success implies result.assignment.run.id == request.runId and result.assignment.attempt.id == request.attemptId
        ensures success implies result.assignment.attempt.parentAttemptId == Some(request.sourceAttemptId)
        ensures success implies result.assignment.attempt.runtimeSessionReference == Some(request.runtimeSessionReference)
        ensures success implies result.assignment.continuation == Some(history.continuation)
        ensures success implies result.reclaim.attemptId == request.attemptId and result.reclaim.runId == request.runId and result.reclaim.sourceAttemptId == request.sourceAttemptId
        ensures success implies result.reclaim.leaseId == request.leaseId and result.reclaim.historyCanonicalHash == history.history.canonicalHash
        ensures success implies exists LocalRunReclaim(request.attemptId)
        ensures success implies after.LocalRunReclaim(request.attemptId).leaseId == request.leaseId
        ensures success implies after.LocalRunReclaim(request.attemptId).historyCanonicalHash == history.history.canonicalHash
        ensures success implies result.assignment.nativeCheckpointReference == history.nativeCheckpointReference
        ensures not success implies before.AgentRun == after.AgentRun and before.RunAttempt == after.RunAttempt and before.RunLease == after.RunLease
        ensures not success implies before.LocalRunReclaim == after.LocalRunReclaim
        effects { read AgentRun read RunAttempt read RunLease read RunEvent read ToolWriteReconciliation read RunCheckpoint read RunControlDecision read LocalRunReclaim write AgentRun write RunAttempt write RunLease write LocalRunReclaim write RunProgressProjection call RunTurnHistoryVerifier.verifyReclaim }
      }
      operation renewPermit(request: RenewProviderPermit)
        -> ProviderPermitView
        ! RunnerLeaseRejected ! RunDelegationRejected ! ProviderPermitRejected ! RunLedgerUnavailable
      effects { read RunLease write ProviderPermit }

      operation queue(request: QueueAgentRun)
        -> AgentRunView
        ! RunSnapshotUnavailable ! InvalidRunTransition ! RunLedgerUnavailable
      effects { write AgentRun write RunAttempt write RunnerSignal }
      operation signals(request: ReadRunnerSignals)
        -> RunnerSignals
        ! RunnerAuthenticationRejected ! RunLedgerUnavailable
      effects { read RunnerSignal }
      operation claim(request: ClaimAgentRun)
        -> RunExecutionAssignment
        ! RunnerLeaseRejected ! RunLedgerUnavailable
      effects { read AgentRun write AgentRun write RunLease write RunAttempt }
      operation renewLease(request: RenewRunLease)
        -> RunLeaseView
        ! RunnerLeaseRejected ! RunLedgerUnavailable
      effects { write RunLease }
      operation recover(request: RecoverExpiredRun)
        -> AgentRunView
        ! AgentRunNotFound ! RunnerLeaseRejected ! UnconfirmedToolWrite ! InvalidRunTransition ! RunLedgerUnavailable
      effects { read RunLease read RunEvent read ToolWriteReconciliation write AgentRun write RunAttempt write RunnerSignal }
      operation reconcileWritingTool(request: ReconcileWritingTool)
        -> ToolWriteReconciliation
        ! AgentRunNotFound ! RunEventNotFound ! RunInspectionDenied ! InvalidRunTransition ! RunLedgerUnavailable
      effects { read AgentRun read RunEvent write ToolWriteReconciliation }
      operation progress(request: RecordRunProgress)
        -> RunProgressReceipt
        ! AgentRunNotFound ! RunnerLeaseRejected ! RunActivityConflict ! RunBatchLimitExceeded ! InvalidRunTransition ! RunDelegationRejected ! RunLedgerUnavailable
      effects { read RunLease write AgentRun write RunAttempt write RunTurn write RunEvent write RunProgressProjection }
      operation recordContext(request: RequestChatContext, delivery: ChatContextDelivery)
        -> RunContextRecord
        ! RunnerLeaseRejected ! ChatContextDenied ! RunLedgerUnavailable {
        requires delivery.runId == request.runId
        requires delivery.attemptId == request.attemptId
        effects { read AgentRun read RunLease write RunContextRecord }
        state upserts RunContextRecord from result
        ensures success implies result.runId == request.runId
        ensures success implies result.attemptId == request.attemptId
        ensures success implies result.runId == delivery.runId
        ensures success implies result.attemptId == delivery.attemptId
        ensures success implies result.omittedMessageIds == delivery.omittedMessageIds
        ensures success implies count(result.deliveredMessages) == count(delivery.messages)
        ensures success implies all(reference in result.deliveredMessages where any(entry in delivery.messages where reference == entry.reference))
        ensures success implies count(result.includedArtifactIds) == 0
        ensures success implies count(result.includedMemoryIds) == 0
        ensures success implies result == after.RunContextRecord(request.runId, request.attemptId)
        ensures failure is RunnerLeaseRejected implies preserves RunContextRecord(request.runId, request.attemptId)
        ensures failure is ChatContextDenied implies preserves RunContextRecord(request.runId, request.attemptId)
      }
      operation acquirePermit(request: AcquireProviderPermit)
        -> ProviderPermitView
        ! RunnerLeaseRejected ! ProviderPermitRejected ! RunLedgerUnavailable
      effects { read RunLease write ProviderPermit }
      operation releasePermit(request: ReleaseProviderPermit)
        -> Unit
        ! RunnerLeaseRejected ! ProviderPermitRejected ! RunLedgerUnavailable
      effects { write ProviderPermit }
      operation prepareResult(request: ReportRunResult)
        -> RunResultPreparation
        ! AgentRunNotFound ! RunnerLeaseRejected ! InvalidRunTransition ! RunLedgerUnavailable {
        effects { read AgentRun read RunLease write RunResultPreparation }
        state observes AgentRun by request.runId
        state upserts RunResultPreparation from result
        ensures success implies result.runId == request.runId
        ensures success implies result.attemptId == request.attemptId
        ensures success implies result.leaseId == request.leaseId
        ensures success implies result.authorAgentId == before.AgentRun(request.runId).agentId
        ensures success implies result.targetChannelId == before.AgentRun(request.runId).conversationId
        ensures success implies result == after.RunResultPreparation(request.runId, request.attemptId)
        ensures failure is AgentRunNotFound implies preserves RunResultPreparation(request.runId, request.attemptId)
        ensures failure is RunnerLeaseRejected implies preserves RunResultPreparation(request.runId, request.attemptId)
        ensures failure is InvalidRunTransition implies preserves RunResultPreparation(request.runId, request.attemptId)
      }
      operation complete(request: ReportRunResult, publication: ChatPublicationReceipt)
        -> RunResultReceipt
        ! AgentRunNotFound ! RunnerLeaseRejected ! InvalidRunTransition ! RunLedgerUnavailable
      effects { write AgentRun write RunAttempt write RunLease write ProviderPermit }
      operation recordCheckpoint(request: RecordCheckpoint)
        -> RunCheckpoint
        ! AgentRunNotFound ! RunAttemptNotFound ! RunnerLeaseRejected ! InvalidRunTransition ! RunLedgerUnavailable {
        state observes AgentRun by request.runId
        state observes RunAttempt by request.attemptId
        state observes RunLease by request.leaseId
        state upserts RunCheckpoint from RunCheckpoint { id = request.checkpointId runId = request.runId attemptId = request.attemptId runtimeCheckpointReference = request.runtimeCheckpointReference historySnapshotReference = request.historySnapshotReference sandboxSnapshotReference = request.sandboxSnapshotReference sandboxEpochReference = request.sandboxEpochReference anchor = request.anchor label = request.label createdAt = after.RunCheckpoint(request.checkpointId).createdAt }
        ensures success implies result == after.RunCheckpoint(request.checkpointId)
        ensures success implies after.RunCheckpoint(request.checkpointId).createdAt >= before.AgentRun(request.runId).createdAt
        ensures success implies after.RunCheckpoint(request.checkpointId).createdAt < before.RunLease(request.leaseId).expiresAt
        ensures success implies before.RunAttempt(request.attemptId).runId == request.runId
        ensures not success implies before.RunCheckpoint == after.RunCheckpoint
      }
      effects { read AgentRun read RunAttempt read RunLease read RunCheckpoint write RunCheckpoint }
      operation requestControl(request: RequestRunControl)
        -> RunControlDecision
        ! AgentRunNotFound ! RunAttemptNotFound ! RunCheckpointNotFound ! RunInspectionDenied ! RunControlRejected ! RunLedgerUnavailable
      effects { read AgentRun read RunCheckpoint write RunControlDecision write RunnerSignal }
      operation acknowledgeControl(request: AcknowledgeRunControl)
        -> RunControlDecision
        ! RunnerLeaseRejected ! RunControlRejected ! RunLedgerUnavailable
      effects { write AgentRun write RunAttempt write RunControlDecision }
      operation inspect(runId: AgentRunId, actorId: ExecutionActorId)
        -> AgentRunInspection
        ! AgentRunNotFound ! RunInspectionDenied ! RunLedgerUnavailable
      effects { read AgentRun read RunAttempt read RunLease read RunCheckpoint read RunContextRecord read RunControlDecision read ToolWriteReconciliation }
      operation activities(request: ReadRunActivities)
        -> RunActivitiesPage
        ! RunActivityAuthenticationRequired ! AgentRunNotFound ! RunAttemptNotFound ! RunInspectionDenied ! InvalidRunTransition ! RunLedgerUnavailable {
        state observes AgentRun by request.runId
        state observes RunAttempt by request.attemptId
        state lists RunEvent where self.runId == request.runId and self.attemptId == request.attemptId
        ensures success implies result.runId == request.runId and result.attemptId == request.attemptId
        ensures success implies count(result.events) <= request.limit
        ensures success implies request.beforeSequence == 0 or request.afterSequence == 0
        ensures success implies all(event in result.events where event.runId == request.runId and event.attemptId == request.attemptId and (request.beforeSequence == 0 or event.sequence < request.beforeSequence) and event.sequence > request.afterSequence)
        ensures success implies all(event in result.events where exists RunEvent(event.id) and event == before.RunEvent(event.id))
        ensures success implies before.AgentRun == after.AgentRun and before.RunEvent == after.RunEvent
      }
      effects { read Person read Session read Space read Membership read AgentRun read RunAttempt read RunEvent }
      operation history(workstreamId: ExecutionWorkstreamId, actorId: ExecutionActorId)
        -> AgentRunHistory
        ! RunInspectionDenied ! RunLedgerUnavailable
      effects { read AgentRun }
      operation connectivity(runnerId: ExecutionRunnerId, actorId: ExecutionActorId)
        -> RunnerConnectivity
        ! AgentRunNotFound ! RunInspectionDenied ! RunLedgerUnavailable
      effects { read AgentRun read RunLease }
    }
    surface AgentRunApi exposes requestReply {
