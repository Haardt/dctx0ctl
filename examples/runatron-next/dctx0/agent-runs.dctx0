      given RunnerAuthorization.assertRunner(runnerId, keyId) returns Unit
      given AgentRunRepository.prepareResult(resultReport) returns preparation
      given ChatPublicationGateway.finalize(resultReport, preparation) returns publication
      given AgentRunRepository.complete(resultReport, publication) returns RunResultReceipt { runId = runId attemptId = attemptId outcome = ResponsePublished publication = publication }
      when result = AgentRunApi.complete(resultReport)
