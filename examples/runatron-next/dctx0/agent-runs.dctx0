      effects { read RunLease write AgentRun write RunAttempt write RunTurn write RunEvent write RunProgressProjection call RunnerAuthorization.assertRunner call AgentRunRepository.progress }
      operation chatContext(request: RequestChatContext)
        -> ChatContextDelivery
        ! RunnerAuthenticationRejected ! RunnerLeaseRejected ! ChatContextDenied ! RunLedgerUnavailable
      effects { read AgentRun read RunLease write RunContextRecord call RunnerAuthorization.assertRunner call ChatContextGateway.deliver as delivery call AgentRunRepository.recordContext }
      operation acquireProviderPermit(request: AcquireProviderPermit)
        -> ProviderPermitView
