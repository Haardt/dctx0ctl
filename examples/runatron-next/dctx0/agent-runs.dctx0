      given ChatPublicationGateway.finalize(resultReport, preparation) returns suppressedPublication
      given AgentRunRepository.complete(resultReport, suppressedPublication) returns RunResultReceipt { runId = runId attemptId = attemptId outcome = ResponseSuppressed publication = suppressedPublication }
      when result = AgentRunApi.complete(resultReport)
