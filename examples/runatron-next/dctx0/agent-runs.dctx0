      effects { read AgentRun read RunAttempt read RunLease read RunCheckpoint write RunCheckpoint call RunnerAuthorization.assertRunner call AgentRunRepository.recordCheckpoint emit RunCheckpointRecorded(runId: request.runId, attemptId: request.attemptId, checkpointId: request.checkpointId) }
