      operation complete(request: ReportRunResult)
        -> RunResultReceipt
        ! RunnerAuthenticationRejected ! AgentRunNotFound ! RunnerLeaseRejected ! InvalidRunTransition ! RunLedgerUnavailable ! ChatPublicationUnavailable
      effects { read AgentRun read RunLease write RunResultPreparation write AgentRun write RunAttempt write RunLease write ProviderPermit call RunnerAuthorization.assertRunner call AgentRunRepository.prepareResult as preparation call ChatPublicationGateway.finalize as publication call AgentRunRepository.complete as result emit AgentRunCompleted(runId: result.runId, attemptId: result.attemptId, outcome: result.outcome) }
      operation recordCheckpoint(request: RecordCheckpoint)
        -> RunCheckpoint
