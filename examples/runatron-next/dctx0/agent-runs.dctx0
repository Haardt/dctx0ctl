      effects { read HistorySnapshot read HistoryConfirmedCursor read HistorySection read HistoryContentBatch read AgentRun read RunTurn read RunEvent read ToolWriteReconciliation write AgentRun write RunAttempt write RunLease write ProviderPermit write RunProgressProjection call RunnerAuthorization.assertRunner call RunTurnHistoryVerifier.verifyPause as history call AgentRunRepository.pause }
      operation resume(request: ResumeRun)
        -> RunExecutionAssignment
        ! RunnerAuthenticationRejected ! AgentRunNotFound ! RunnerLeaseRejected ! RunDelegationRejected ! RunSnapshotUnavailable ! InvalidRunTransition ! RunLedgerUnavailable
      effects { read AgentRun write AgentRun write RunAttempt write RunLease call RunnerAuthorization.assertRunner call AgentRunRepository.resume }
      operation reclaimLocal(request: ReclaimLocalRunAttempt)
        -> RunExecutionAssignment
        ! RunnerAuthenticationRejected ! AgentRunNotFound ! RunnerLeaseRejected ! RunDelegationRejected ! RunHistoryRequired ! UnconfirmedToolWrite ! InvalidRunTransition ! RunLedgerUnavailable
      effects { read HistorySnapshot read HistoryConfirmedCursor read HistorySection read HistoryContentBatch read AgentRun read RunAttempt read RunLease read RunEvent read ToolWriteReconciliation read RunCheckpoint read RunControlDecision read LocalRunReclaim write AgentRun write RunAttempt write RunLease write LocalRunReclaim write RunProgressProjection call RunnerAuthorization.assertRunner call RunTurnHistoryVerifier.verifyReclaim as history call AgentRunRepository.reclaimLocal }
      operation renewProviderPermit(request: RenewProviderPermit)
        -> ProviderPermitView
        ! RunnerAuthenticationRejected ! RunnerLeaseRejected ! RunDelegationRejected ! ProviderPermitRejected ! RunLedgerUnavailable
      effects { read RunLease write ProviderPermit call RunnerAuthorization.assertRunner call AgentRunRepository.renewPermit }

      operation queue(request: QueueAgentRun)
        -> AgentRunView
        ! RunQueueDenied ! RunSnapshotUnavailable ! InvalidRunTransition ! RunLedgerUnavailable
      effects { write AgentRun write RunAttempt write RunnerSignal call RunQueueAuthorization.assertQueue call AgentRunRepository.queue emit AgentRunQueued(runId: request.runId, attemptId: request.attemptId, agentId: request.agentId) }
      operation signals(request: ReadRunnerSignals)
        -> RunnerSignals
        ! RunnerAuthenticationRejected ! RunLedgerUnavailable
      effects { read RunnerSignal call RunnerAuthorization.assertRunner call AgentRunRepository.signals }
      operation claim(request: ClaimAgentRun)
        -> RunExecutionAssignment
        ! RunnerAuthenticationRejected ! RunnerLeaseRejected ! RunLedgerUnavailable
      effects { read AgentRun write AgentRun write RunLease write RunAttempt call RunnerAuthorization.assertRunner call AgentRunRepository.claim as assignment emit AgentRunClaimed(runId: assignment.lease.runId, attemptId: assignment.lease.attemptId, leaseId: assignment.lease.leaseId) }
      operation renewLease(request: RenewRunLease)
        -> RunLeaseView
