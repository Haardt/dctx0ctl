    example "enqueue while the runner is offline and retain the selected snapshot and origin" {
      given RunQueueAuthorization.assertQueue(queueRequest) returns Unit
      given AgentRunRepository.queue(queueRequest) returns queuedRun
      when result = AgentRunApi.queue(queueRequest)
      expect Success
      expect emits AgentRunQueued { runId = runId attemptId = attemptId agentId = agentId }
    }
    example "atomically claim one queued attempt for its owning runner" {
      given RunnerAuthorization.assertRunner(runnerId, keyId) returns Unit
      given AgentRunRepository.claim(claimRequest) returns RunExecutionAssignment { lease = RunLeaseView { leaseId = leaseId runId = runId attemptId = attemptId runnerId = runnerId snapshotId = snapshotId expiresAt = expiresAt } run = assignedRun attempt = assignedAttempt instruction = "Implement the selected work" executionMode = Autonomous effectiveToolNames = [] effectiveSkillNames = [] contextManifest = None continuation = None nativeCheckpointReference = None summaryRequired = true }
      when result = AgentRunApi.claim(claimRequest)
      expect Success
      expect emits AgentRunClaimed { runId = runId attemptId = attemptId leaseId = leaseId }
    }
    example "reject a second live lease for the same attempt" {
      given RunnerAuthorization.assertRunner(runnerId, keyId) returns Unit
      given AgentRunRepository.claim(duplicateLeaseClaim) fails RunnerLeaseRejected { reason = "attempt already leased" }
      when result = AgentRunApi.claim(duplicateLeaseClaim)
      expect result fails RunnerLeaseRejected
    }
    example "renew only the current runner lease" {
      given RunnerAuthorization.assertRunner(runnerId, keyId) returns Unit
      given AgentRunRepository.renewLease(renewalRequest) returns renewedLease
      when result = AgentRunApi.renewLease(renewalRequest)
      expect Success
    }
    example "read only the owning runner's durable availability and control signals" {
      given RunnerAuthorization.assertRunner(runnerId, keyId) returns Unit
      given AgentRunRepository.signals(signalRequest) returns signalBatch
      when result = AgentRunApi.signals(signalRequest)
      expect Success
    }
    example "deliver bounded chat context and record only message references" {
      given RunnerAuthorization.assertRunner(runnerId, keyId) returns Unit
      given ChatContextGateway.deliver(contextRequest) returns delivery
      given AgentRunRepository.recordContext(contextRequest, delivery) returns contextRecord
      when result = AgentRunApi.chatContext(contextRequest)
      expect Success
    }
    example "grant one model call across two runners under a global provider limit" {
      given RunnerAuthorization.assertRunner(runnerId, keyId) returns Unit
      given AgentRunRepository.acquirePermit(permitRequest) returns permit
      when result = AgentRunApi.acquireProviderPermit(permitRequest)
      expect Success
      expect emits ProviderPermitGranted { permitId = permitId callId = callId provider = provider }
    }
    example "grant another runner a distinct call permit only within remaining global capacity" {
      given RunnerAuthorization.assertRunner(otherRunnerId, otherKeyId) returns Unit
      given AgentRunRepository.acquirePermit(AcquireProviderPermit { permitId = otherPermitId callId = otherCallId runId = runId attemptId = attemptId leaseId = leaseId runnerId = otherRunnerId keyId = otherKeyId delegationCredential = None provider = provider occurredAt = occurredAt }) returns otherPermit
      when result = AgentRunApi.acquireProviderPermit(AcquireProviderPermit { permitId = otherPermitId callId = otherCallId runId = runId attemptId = attemptId leaseId = leaseId runnerId = otherRunnerId keyId = otherKeyId delegationCredential = None provider = provider occurredAt = occurredAt })
      expect Success
      expect emits ProviderPermitGranted { permitId = otherPermitId callId = otherCallId provider = provider }
    }
    example "reject a provider call when global capacity is exhausted" {
      given RunnerAuthorization.assertRunner(runnerId, keyId) returns Unit
      given AgentRunRepository.acquirePermit(overLimitPermitRequest) fails ProviderPermitRejected { reason = "provider capacity exhausted" }
      when result = AgentRunApi.acquireProviderPermit(overLimitPermitRequest)
