// Step 1: a small, finite contract and a real pure operation.
workspace Tutorial {
  intent """Learn the specification language by growing one small task board."""
  domain Board {
    value Count = Int {
      range 0..3
    }
    surface Actions exposes requestReply {
      operation increment(count: Count) -> Count {
        pure
        requires count < 3
        ensures result == count + 1
      }
    }
    example "increment one" {
      when result = Actions.increment(1)
      expect result == 2
    }
    invariant IncrementIsMonotone {
      forall count: Count
      assert count < 3 implies Actions.increment(count) > count
    }
  }
}
