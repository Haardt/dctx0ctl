{
  "schema_version": 1,
  "runtime": "go",
  "root_test": "TestCinemaSuite",
  "test_directory": "contracttests",
  "prepare": [
    {"program": "go", "arguments": ["mod", "vendor"]},
    {"program": "python3", "arguments": ["scripts/generate_application_facade.py", "--project", ".", "--bundle", "{plan}"]}
  ],
  "build": [
    {"program": "go", "arguments": ["test", "-c", "-mod=vendor", "-buildvcs=false", "-o", "{artifacts}/contracts.test", "./contracttests"]}
  ],
  "catalog": {"program": "{artifacts}/contracts.test", "arguments": ["-test.list=."]},
  "run": {"program": "go", "arguments": ["tool", "test2json", "-t", "{artifacts}/contracts.test", "-test.v", "-test.run=^TestCinemaSuite$", "-test.timeout=300s"]},
  "junit": null
}
