+import {PostgresFixture} from '../../../../tools/dctx0/postgres-fixture';
+import {fileURLToPath} from 'node:url';
+import {mkdtemp,rm} from 'node:fs/promises';
+import {tmpdir} from 'node:os';
+import {join} from 'node:path';
+const root=fileURLToPath(new URL('../../../../',import.meta.url));
+process.chdir(root);
+const directory=await mkdtemp(join(tmpdir(),'runner-generators-'));
+const fixture=new PostgresFixture();
+try {
+ const database=await fixture.start();
+ const env={...process.env,RUNNER_VERIFICATION_DATABASE:database,RUNNER_VERIFICATION_ROOT:directory};
+ const binary=join(directory,'bridge.test');
+ const build=Bun.spawn(['sh','../../tools/go/run.sh','test','-c','-o',binary,'./.dctx0/testing/go'],{cwd:join(root,'packages/runner'),env,stdout:'inherit',stderr:'inherit'});
+ if(await build.exited!==0)throw new Error('Bridge compilation failed');
+ const cases=['TestGeneratedConversionCallsTheActualProductionDecoder','TestGeneratedNumbersRemainExactAndFixedWidthMappingIsExplicitlyUnsupported','TestGeneratedOptionalRecordRepresentation','TestGeneratedFailureAssertionsRejectContradictoryAndIncorrectObservations','TestControlAssignDeniesWithoutRecordingAnAcceptance','TestAuthorityWithoutReviewedSetupRemainsUnavailable','TestHostUpgradeWithoutPrivateContextDoesNotProvision','TestActualHostAuthority'];
+ for(const test of cases){
+  const child=Bun.spawn([binary,`-test.run=^${test}$`,'-test.count=1','-test.timeout=2s','-test.parallel=4','-test.v'],{cwd:join(root,'packages/runner/.dctx0/testing/go'),env,stdout:'inherit',stderr:'inherit'});
+  if(await child.exited!==0)throw new Error(`Generator reference regression failed: ${test}`);
+ }
+ // Missing configured prerequisites must fail rather than pass an unavailable branch.
+ const missing=Bun.spawn([binary,'-test.run=^TestControlAssignDeniesWithoutRecordingAnAcceptance$','-test.count=1','-test.timeout=2s'],{cwd:join(root,'packages/runner/.dctx0/testing/go'),env:{...env,RUNNER_VERIFICATION_DATABASE:''},stdout:'pipe',stderr:'pipe'});
+ const diagnostic=await new Response(missing.stdout).text();if(await missing.exited===0||!diagnostic.includes('not configured'))throw new Error('Missing configured fixture was not reported honestly');
+ console.log(JSON.stringify({status:'pass',cases:cases.length,missingConfiguredFixtureRejected:true,scope:'selected Go generator adoption; not application acceptance'}));
+} finally {try{await fixture.close()}finally{await rm(directory,{recursive:true,force:true})}}
