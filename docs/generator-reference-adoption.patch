@@ -0,0 +1,121 @@
+package main
+
+import (
+	"encoding/json"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/Haardt/runatron-business/packages/runner/internal/protocol"
+)
+
+// The adapter owns the connection to production. Generated conversion never decides acceptance.
+func generatedProductionCheck(name string, supplied Value) (ValueCheck, error) {
+	native, err := DecodeInput(prefix+name, supplied)
+	if err != nil {
+		return ValueCheck{}, AdapterError(err)
+	}
+	raw, err := json.Marshal(native)
+	if err != nil {
+		return ValueCheck{}, AdapterError(err)
+	}
+	if _, err = protocol.DecodeContract(name, raw); err != nil {
+		reason := err.Error()
+		return ValueCheck{Kind: "rejected", Reason: &reason}, nil
+	}
+	return ValueCheck{Kind: "accepted", Value: &supplied}, nil
+}
+func TestGeneratedConversionCallsTheActualProductionDecoder(t *testing.T) {
+	reference := sdkRecord(map[string]Value{"id": sdkString("profile"), "revision": sdkInteger(1), "digest": sdkString(strings.Repeat("a", 64))})
+	for _, item := range []struct {
+		name  string
+		value Value
+	}{{"VersionedReference", reference}, {"Assignment", controlAssignValue()}} {
+		result, err := generatedProductionCheck(item.name, item.value)
+		if err != nil || result.Kind != "accepted" {
+			t.Fatal("actual production decoder did not accept its valid input", item.name, err, result)
+		}
+		// Independent handwritten mapping is a comparison, not the production validator.
+		generated, err := Decode(prefix+item.name, item.value)
+		if err != nil {
+			t.Fatal(err)
+		}
+		raw, err := json.Marshal(generated)
+		if err != nil {
+			t.Fatal(err)
+		}
+		handwritten, err := sdkToWire(item.value, wireShapes()[item.name])
+		if err != nil {
+			t.Fatal(err)
+		}
+		var a, b any
+		if json.Unmarshal(raw, &a) != nil || json.Unmarshal(handwritten, &b) != nil || !reflect.DeepEqual(a, b) {
+			t.Fatal("generated and existing structural mappings differ", item.name)
+		}
+	}
+	for _, value := range []Value{sdkString("not a record"), sdkRecord(map[string]Value{"id": sdkString("profile"), "revision": sdkInteger(1)}), sdkRecord(map[string]Value{"id": sdkInteger(1), "revision": sdkInteger(1), "digest": sdkString(strings.Repeat("a", 64))})} {
+		result, err := generatedProductionCheck("VersionedReference", value)
+		if err != nil || result.Kind != "rejected" {
+			t.Fatal("representable negative input did not reach production rejection", err, result)
+		}
+	}
+}
+func TestGeneratedNumbersRemainExactAndFixedWidthMappingIsExplicitlyUnsupported(t *testing.T) {
+	const exact = "900719925474099312345678901234567890"
+	native, err := Decode(prefix+"Counter", sdkValue("integer", exact))
+	if err != nil {
+		t.Fatal(err)
+	}
+	number, ok := native.(json.Number)
+	if !ok || number.String() != exact {
+		t.Fatal("generated conversion changed exact integer")
+	}
+	raw, err := json.Marshal(native)
+	if err != nil {
+		t.Fatal(err)
+	}
+	actual, err := protocol.ParseInteger(raw)
+	if err != nil || string(actual) != exact {
+		t.Fatal("production lost exact integer", err)
+	}
+	if _, err := number.Int64(); err == nil {
+		t.Fatal("unsupported int64 mapping must remain explicit")
+	}
+}
+func TestGeneratedOptionalRecordRepresentation(t *testing.T) {
+	row := map[string]any{"id": "attempt", "registrationId": "registration", "tenantId": "tenant", "participantId": "participant", "runId": "run", "workspaceId": "workspace", "grantId": "grant", "epoch": json.Number("1"), "phase": "Accepted", "pendingInput": nil, "applied": false, "ceased": false, "completed": false, "lastSequence": json.Number("0"), "deadline": json.Number("60000"), "leaseExpiresAt": json.Number("30000")}
+	for _, pending := range []any{nil, "input"} {
+		row["pendingInput"] = pending
+		encoded, err := Encode(prefix+"AttemptRecord", row)
+		if err != nil {
+			t.Fatal(err)
+		}
+		decoded, err := Decode(prefix+"AttemptRecord", encoded)
+		if err != nil || !reflect.DeepEqual(decoded, row) {
+			t.Fatal("optional representation changed", err)
+		}
+	}
+	// Host attempt validation and native enum mappings remain authored; this roundtrip is no acceptance claim.
+}
+func TestGeneratedFailureAssertionsRejectContradictoryAndIncorrectObservations(t *testing.T) {
+	payload := sdkRecord(map[string]Value{"code": sdkString("PERMISSION_DENIED")})
+	value := sdkValue("failure", map[string]any{"declaration": prefix + "AccessDenied", "payload": payload})
+	observed := Observation{Kind: "returned", Value: &value}
+	failure, err := DeclaredFailure(observed, nil, prefix+"AccessDenied")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := ReturnedRecord(observed, nil); err == nil {
+		t.Fatal("contradictory record decoder accepted failure")
+	}
+	if _, err := DeclaredFailure(observed, nil, prefix+"AssignmentConflict"); err == nil {
+		t.Fatal("wrong failure declaration accepted")
+	}
+	if StringField(failure.Payload, "code", "WRONG") == nil {
+		t.Fatal("wrong payload accepted")
+	}
+	reason := "missing actual fixture"
+	if _, err := DeclaredFailure(Observation{Kind: "unavailable", Reason: &reason}, nil, prefix+"AccessDenied"); err == nil {
+		t.Fatal("unavailable observation accepted as denial")
+	}
+}
