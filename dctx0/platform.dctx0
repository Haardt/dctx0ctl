fragment Dctx0 {
  review PlatformBoundaries {
    inspect { implementation dependencyGraph decisions contracts surfaces ownership }
    criteria {
      "Successful check publication is transactional; failed compilation preserves the last valid head."
      "Read-only history access performs no migrations or recovery writes."
      "Explicit rename records continuity; ordinary remove/add edits do not invent identity."
      "Target profiles are editable agent guidance; profile changes do not themselves create behavioral evidence."
      "Targets share Rust evaluation, deterministic generation, shrinking and replay semantics."
      "Production architecture is not forced to use a particular DI container or HTTP framework."
      "Native execution bounds time, messages and logs, reaps cancelled workers and cleans test sessions."
      "The optional Linux/systemd memory limit is resource management, not a security sandbox."
      "Replay records changed implementations and environments rather than claiming historical freshness."
      "LSP diagnostics and semantic colors follow the current document version, including unsaved editor buffers."
      "Published releases package versioned executables, exact checksums and installation instructions."
    }
  }
}
